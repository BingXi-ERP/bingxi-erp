var formatDateTime = function (timeStamp, ymd, full) {
  ymd = undefined === ymd ? false : ymd;
  full = undefined === full ? false : full;
  var gettime = timeStamp ? timeStamp.split(" ") : timeStamp;
  if (gettime && gettime.length) {
    return gettime[1];
  }
  if (timeStamp <= 0 || "Number" !== timeStamp.constructor) {
    return "00:00:00";
  }
  var date = getDate(timeStamp);
  var y = date.getFullYear();
  var m = date.getMonth() + 1;
  m = m < 10 ? "0" + m : m;
  var d = date.getDate();
  d = d < 10 ? "0" + d : d;
  var h = date.getHours();
  h = h < 10 ? "0" + h : h;
  var minute = date.getMinutes();
  var second = date.getSeconds();
  minute = minute < 10 ? "0" + minute : minute;
  second = second < 10 ? "0" + second : second;
  if (ymd) {
    return y + "-" + m + "-" + d;
  }
  if (full) {
    return y + "-" + m + "-" + d + " " + h + ":" + minute + ":" + second;
  }
  return h + ":" + minute + ":" + second;
};
module.exports = formatDateTime;
