page {
  background-color: #f5f5f5;
}
.printColorNum {
  overflow-x: hidden;
  padding-bottom: 250rpx;
}
.colorSample .colorSampleContent,
.colorSample .title,
.colorType,
.howPrint,
.printLang {
  background-color: #fff;
  height: 96rpx;
  padding: 0 36rpx;
  position: relative;
}
.colorType {
  margin-top: 36rpx;
}
.colorSample .colorSampleContent {
  padding: 0 8rpx;
}
.colorSample .title::after,
.colorType::after {
  border-bottom: 1rpx solid #f5f5f5;
  bottom: 0;
  content: "";
  height: 1px;
  left: 36rpx;
  position: absolute;
  width: 100%;
}
.title {
  color: #373c55;
  font-weight: 400;
}
.colorSample .title {
  font-weight: 500;
}
.checkBox {
  background: #edeff6;
  border-radius: 28rpx;
  color: #373c55;
  font-size: 28rpx;
  font-weight: 400;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0 28rpx;
  min-width: 192rpx;
  text-align: center;
}
.isCheckedBox {
  background: #edf3fc;
  border: 1rpx solid #82a5ff;
  color: #4c7cf9;
}
.colorType {
  padding-right: 80rpx;
  position: relative;
}
.colorType .title::after {
  border-bottom: 1rpx solid #c3c8cb;
  border-right: 1rpx solid #c3c8cb;
  color: #c3c8cb;
  content: "";
  display: block;
  height: 14rpx;
  position: absolute;
  right: 46rpx;
  top: 50%;
  transform: rotate(45deg) translateY(-50%);
  width: 14rpx;
}
.right input {
  text-align: right;
}
.num-title {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  font-size: 28rpx;
  justify-content: flex-end;
}
.slide-image {
  width: 100%;
}
.exmaple,
swiper {
  height: 480rpx;
}
.exmaple {
  background-color: #fff;
  padding-bottom: 30rpx;
  position: relative;
}
.eaxmpleDetail {
  background: transparent;
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 1;
}
.exmaple .items {
  flex-wrap: wrap;
  width: 100%;
}
.items .itemRow {
  padding: 8rpx 0;
}
.exmaple .item0 {
  padding-left: 7rpx;
  padding-right: 7rpx;
  width: 48%;
}
.exmaple .item1 {
  padding-left: 11rpx;
  padding-right: 11rpx;
  width: 30%;
}
.exmaple .item2 {
  padding-left: 7rpx;
  padding-right: 7rpx;
  width: 23%;
}
.detailText {
  color: #4c7cf9;
  margin-right: 30rpx;
}
.checkImg {
  height: 40rpx;
  position: relative;
  top: 6rpx;
  width: 40rpx;
}
.picker-custom .picker-custom-content {
  height: 72%;
  overflow: hidden;
  padding: 28rpx 50rpx;
}
.picker-custom-wrapper {
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  height: 880rpx;
}
.custom-title {
  color: #373c55;
  font-weight: 600;
  height: 112rpx;
  line-height: 112rpx;
  text-align: center;
}
.exampleImg {
  height: 480rpx;
  width: 100%;
}
.illustrate {
  color: #4c7cf9;
  padding: 0 30rpx 30rpx;
}
.popBtn {
  background: #edf3fc;
  border-radius: 24px;
  color: #4c7cf9;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  width: 686rpx;
}
@-webkit-keyframes openAnimate {
  0% {
    opacity: 0;
    transform: translateY(100%);
  }
  50% {
    transform: translateY(50%);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes openAnimate {
  0% {
    opacity: 0;
    transform: translateY(100%);
  }
  50% {
    transform: translateY(50%);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
@-webkit-keyframes closeAnimate {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  50% {
    transform: translateY(50%);
  }
  100% {
    opacity: 0;
    transform: translateY(100%);
  }
}
@keyframes closeAnimate {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  50% {
    transform: translateY(50%);
  }
  100% {
    opacity: 0;
    transform: translateY(100%);
  }
}
.openAnimate {
  animation-duration: 0.25s;
  animation-fill-mode: forwards;
  animation-name: openAnimate;
  animation-timing-function: linear;
}
.closeAnimate {
  animation-duration: 0.25s;
  animation-fill-mode: both;
  animation-name: closeAnimate;
  animation-timing-function: linear;
}
.lang-btn.ml {
  margin-left: 24rpx;
}
.lang-btn {
  background: #edeff6;
  border: 1rpx solid #edeff6;
  border-radius: 28rpx;
  display: inline-block;
  font-size: 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  width: 114rpx;
}
.lang-btn.active {
  background: #edf3fc;
  border: 1rpx solid #82a5ff;
  color: #4c7cf9;
  font-size: 28rpx;
}
