.nolist {
  color: #888;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  padding-top: 150rpx;
}
.c-text {
  color: #000;
}
page {
  background-color: #f5f5f5;
  font-size: 30rpx;
}
.search-btn {
  background-color: #d62d0e;
  bottom: 0;
  color: #fff;
  font-size: 32rpx;
  height: 110rpx;
  left: 0;
  line-height: 110rpx;
  position: fixed;
  text-align: center;
  width: 100%;
}
.l-title {
  color: #999;
  padding: 20rpx 30rpx;
}
.border-b {
  border-bottom: 1rpx solid #e5e5e5;
}
.p-list {
  background-color: #fff;
}
.p-item {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  font-size: 32rpx;
  height: 100rpx;
  justify-content: space-between;
  padding: 0 30rpx;
}
.p-name {
  padding-left: 20rpx;
}
.icon-shuchudayin {
  color: #888;
}
.maskbox {
  align-items: center;
  background-color: rgba(0, 0, 0, 0.4);
  display: -webkit-flex;
  display: flex;
  font-size: 32rpx;
  height: 100%;
  justify-content: center;
  left: 0;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 100;
}
.editbox {
  background-color: #fff;
  border-radius: 6rpx;
  width: 550rpx;
}
.e-l {
  display: -webkit-flex;
  display: flex;
  justify-content: center;
}
.e-title {
  line-height: 80rpx;
}
.inputbox {
  padding: 20rpx;
  text-align: center;
  width: 500rpx;
}
.btn-box {
  border-top: 1rpx solid #e4e4e4;
}
.c-btn {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  width: 50%;
}
.cancel {
  color: #353535;
}
.confirm {
  color: #1aac19;
}
@font-face {
  font-family: iconfont;
  src: url(//at.alicdn.com/t/font_578208_5cb185gmympwrk9.eot?t=1519968244829);
  src: url(//at.alicdn.com/t/font_578208_5cb185gmympwrk9.eot?t=1519968244829#iefix)
      format("embedded-opentype"),
    url(data:application/x-font-woff;charset=utf-8;base64,)
      format("woff"),
    url(//at.alicdn.com/t/font_578208_5cb185gmympwrk9.ttf?t=1519968244829)
      format("truetype"),
    url(//at.alicdn.com/t/font_578208_5cb185gmympwrk9.svg?t=1519968244829#iconfont)
      format("svg");
}
.iconfont {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-family: iconfont !important;
  font-size: 16px;
  font-style: normal;
}
.icon-shuchudayin:before {
  content: "";
}
.icon-xiangyou-copy:before {
  content: "";
}
.maskModal {
  background: rgba(0, 0, 0, 0.6);
  height: 100%;
  position: fixed;
  top: 0;
  width: 100%;
}
.modalCont {
  background: #fff;
  height: 600rpx;
  margin-left: auto;
  margin-right: auto;
  margin-top: 212rpx;
  width: 600rpx;
}
.printImg {
  height: 320rpx;
  margin-left: 140rpx;
  width: 320rpx;
}
.printS {
  color: #333;
  font-size: 32rpx;
  font-weight: 600;
  width: 100%;
}
.gobackB,
.printS {
  text-align: center;
}
.gobackB {
  background: #2f7bfd;
  border-radius: 4px;
  color: #fff;
  height: 96rpx;
  line-height: 96rpx;
  margin-left: 60rpx;
  margin-top: 68rpx;
  width: 480rpx;
}
