page {
  background-color: #f5f5f9;
}
.itemList {
  background: #fff;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  height: 110rpx;
  margin-bottom: 10rpx;
  padding-left: 50rpx;
  padding-top: 20rpx;
}
.addCustomer {
  border: 1rpx solid #2f7bfd;
  color: #2f7bfd;
  font-size: 28rpx;
  height: 60rpx;
  padding: 10rpx;
  text-align: center;
  width: 180rpx;
}
.btn-big {
  bottom: 20rpx;
  left: 0;
  margin-left: auto;
  margin-right: auto;
  position: fixed;
  right: 0;
}
.add-btn-icon {
  background-image: url(https://img.duibu.cn/duibu/shop/img/customer/select_s@2x.png?imageView2/2/w/750);
  height: 38rpx;
  margin-right: 16rpx;
  width: 38rpx;
}
.serch-wrapper {
  height: 100rpx;
  margin-bottom: 10rpx;
  padding-top: 20rpx;
}
.smallFontSize {
  color: #999;
  font-size: 26rpx;
}
.bottomSpace {
  height: 200rpx;
  width: 100%;
}
