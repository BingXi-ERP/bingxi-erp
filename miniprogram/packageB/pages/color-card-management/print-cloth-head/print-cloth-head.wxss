page {
  background: #f5f5f9;
  height: 100%;
  overflow-y: auto;
}
.add-fine-code {
  margin-top: 32rpx;
}
.add-fine-code-top {
  background: #fff;
  overflow-y: auto;
  padding-left: 30rpx;
  padding-right: 30rpx;
}
.add-fine-code .color {
  color: #000;
  font-size: 28rpx;
  font-weight: 600;
  height: 42rpx;
  line-height: 42rpx;
  padding-bottom: 32rpx;
  padding-top: 32rpx;
}
.add-fine-code .button {
  background: #f2f5ff;
  border: 2rpx solid #2f7bfd;
  border-radius: 4rpx;
  color: #2f7bfd;
  display: inline-block;
  font-size: 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin-top: 30rpx;
  padding: 0 20rpx;
}
.color-list .badge {
  margin-bottom: 30rpx;
  margin-right: 26rpx;
}
.add-fine-code .dialog-custom-overlay {
  background-color: rgba(0, 0, 0, 0.5);
  bottom: 0;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 100001;
}
.add-fine-code .dialog-custom-wrapper {
  background: #fff;
  border-radius: 4rpx;
  height: auto;
  left: 50%;
  overflow: hidden;
  position: fixed;
  top: 30%;
  transform: translate3d(-50%, -50%, 0);
  width: 90%;
  z-index: 100001;
}
.add-fine-code .dialog-custom-adjust .dialog-custom-wrapper {
  top: 40rpx;
  transform: translate3d(-50%, 0, 0);
}
.add-fine-code .dialog-custom-head {
  padding: 30rpx;
  position: relative;
}
.add-fine-code .dialog-custom-title {
  color: #333;
  font-size: 40rpx;
  font-weight: 600;
}
.add-fine-code .dialog-custom-subtitle {
  color: #333;
  font-size: 20rpx;
  font-weight: 400;
}
.add-fine-code .dialog-custom-extra {
  font-weight: 600;
  margin-top: 10rpx;
  position: absolute;
  right: 30rpx;
  top: 18rpx;
}
.add-fine-code .dialog-custom-extra input,
.add-fine-code .dialog-custom-extra text {
  display: inline-block;
  vertical-align: middle;
}
.add-fine-code .dialog-custom-extra input {
  background: #f5f5f9;
  border: 1rpx solid #ddd;
  font-size: 24rpx;
  height: 48rpx;
  margin: 10rpx;
  padding: 0 10rpx;
  text-align: right;
  width: 110rpx;
}
.add-fine-code .dialog-custom-content {
  padding: 0 30rpx;
}
.add-fine-code .dialog-custom-buttons {
  border-radius: 4rpx;
  border-top: 1rpx solid #ddd;
  display: -webkit-flex;
  display: flex;
}
.add-fine-code .dialog-custom-buttons button {
  background: #fff;
  border-radius: 0;
  color: #333;
  flex: 1;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
}
.add-fine-code .dialog-custom-buttons button:not(:first-child) {
  border-left: 1rpx solid #ddd;
}
.add-fine-code .dialog-custom-buttons .button-primary {
  color: #2f7bfd;
  font-weight: 600;
}
.add-fine-code .color-tags {
  border-bottom: 1rpx dashed #ccc;
  height: 220rpx;
  position: relative;
}
.add-fine-code .color-tags-empty {
  border-top: 1rpx dashed #ccc;
  box-sizing: border-box;
  margin: 60rpx auto;
  width: 240rpx;
}
.add-fine-code .color-tags .tag {
  background: #f5f5f9;
  border-radius: 2rpx;
  color: #666;
  display: inline-block;
  font-size: 24rpx;
  font-weight: 400;
  height: 40rpx;
  line-height: 40rpx;
  margin-bottom: 20rpx;
  margin-right: 20rpx;
  padding: 0 15rpx;
}
.add-fine-code .empty-data {
  color: #999;
  padding: 80rpx 30rpx;
  text-align: center;
}
.color-edit-form {
  margin: 0 auto;
  padding: 0rpx 0;
  width: 600rpx;
}
.color-edit-form .form-item {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  padding: 20rpx 0;
}
.color-edit-form .form-item-label {
  font-size: 28rpx;
  margin-right: 20rpx;
  text-align: right;
  width: 140rpx;
}
.color-edit-form .form-item-content {
  align-items: center;
  border: 1rpx solid #ddd;
  border-radius: 2rpx;
  display: -webkit-flex;
  display: flex;
  font-size: 0;
  height: 72rpx;
  line-height: 72rpx;
  width: 400rpx;
}
.color-edit-form .form-item-content input {
  display: inline-block;
  flex: 1;
  font-size: 28rpx;
  padding: 0 20rpx;
  vertical-align: middle;
}
.color-edit-form .form-item-content text {
  font-size: 28rpx;
  padding: 0 20rpx;
  position: relative;
}
.color-edit-form .form-item-content text::before {
  background: #ddd;
  content: "";
  display: block;
  height: 60%;
  left: 0;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  z-index: 1;
}
.color-edit-form .form-item-error {
  color: #e2525a;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
  margin-left: 150rpx;
  padding-bottom: 20rpx;
}
.color-edit-form .form-item-error image {
  height: 22rpx;
  margin-right: 5rpx;
  vertical-align: middle;
  width: 22rpx;
}
.color-edit-form .form-item-error text {
  vertical-align: middle;
}
.color {
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
}
.color .button-del {
  height: 40rpx;
  width: 40rpx;
}
.bottom-border {
  border-bottom: 1rpx dashed #ccc;
  margin-top: 20rpx;
}
.top-border {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 44rpx;
  position: relative;
}
.entered-code {
  color: #333;
  font-size: 20rpx;
  font-weight: 400;
  margin: 30rpx 0;
}
.fixBottom {
  background-color: #fff;
  bottom: 2rpx;
  display: -webkit-flex;
  display: flex;
  position: fixed;
  width: 100%;
}
.fixBottom .btn {
  background: #2f7bfd;
  color: #fff;
  height: 100rpx;
  line-height: 100rpx;
  width: 512rpx;
}
.fixBottom .edit {
  background: #edf3ff;
  color: #2f7bfd;
  height: 100rpx;
  line-height: 100rpx;
  width: 238rpx;
}
.fixBottom .icon {
  height: 38rpx;
  margin-right: 16rpx;
  width: 38rpx;
}
.nextStep {
  background: #fff;
  bottom: 0;
  display: -webkit-flex;
  display: flex;
  height: 100rpx;
  justify-content: flex-end;
  left: 0;
  padding-bottom: 24rpx;
  position: fixed;
  width: 100%;
  z-index: 99999;
}
.ban {
  background: #f5f5f9 !important;
  border: none !important;
  color: #fff;
}
.xmButton {
  border: 1rpx solid #999;
  border-radius: 4rpx;
  font-size: 28rpx;
  height: 50rpx;
  line-height: 50rpx;
  margin-bottom: 30rpx;
  margin-right: 26rpx;
  padding-left: 20rpx;
  padding-right: 2rpx;
  position: relative;
}
.xmItem {
  border-radius: 50%;
  margin-right: 1.5rpx;
  overflow: hidden;
  padding-right: 18rpx;
}
.add-fine-code .picker-custom-content scroll-view.color-list {
  height: 420rpx;
  padding-bottom: 100rpx;
}
.editLogo {
  height: 40rpx;
  margin-right: 10rpx;
  margin-top: 32rpx;
  width: 40rpx;
}
.fineCode {
  color: #2f7bfd;
  display: inline-block;
  font-size: 28rpx;
  height: 48rpx;
  margin-top: 13rpx;
  padding-left: 24rpx;
}
.fineCodeLogo {
  height: 24rpx;
  margin-left: 28rpx;
  margin-right: 28rpx;
  width: 24rpx;
}
.addCom {
  color: #2f7bfd;
  font-size: 32rpx;
  font-weight: 400 !important;
  margin-right: 16rpx;
}
.chooseBox {
  display: inline-block;
}
.jarNum {
  color: #000;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}
.dataSpace {
  margin-bottom: 24rpx;
}
.ban {
  background: #cfe1ff !important;
}
.banAdd {
  color: #c5c7d7 !important;
}
.fineCodeInput {
  border-right: 1rpx solid #c5c7d7;
}
.addColor {
  color: #2f7bfd;
  font-size: 32rpx;
  font-weight: 400 !important;
  margin-right: 16rpx;
}
::-webkit-scrollbar {
  background-color: rgba(0, 0, 0, 0.1);
  width: 10rpx;
}
.quantityButton {
  border: 1rpx solid #999;
  border-radius: 4rpx;
  color: #000;
  display: inline-block;
  font-size: 28rpx;
  font-weight: 400;
  height: 50rpx;
  line-height: 50rpx;
  min-width: 96rpx;
  padding: 0 20rpx;
  text-align: center;
}
.marR {
  margin-right: 30rpx;
}
button[disabled] {
  background: #d8d9e3 !important;
  border: 0 !important;
  color: #fff !important;
}
.bottom-btn {
  bottom: 30rpx;
  position: fixed;
  right: 30rpx;
}
