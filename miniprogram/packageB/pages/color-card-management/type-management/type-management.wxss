page {
  background-color: #f5f5f9;
}
.list {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx 0;
}
.listTop {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 0 32rpx 10rpx;
}
.list:first-child .listTop {
  border: none;
}
.listBottom {
  color: #666;
  font-size: 28rpx;
  padding-top: 20rpx;
  position: relative;
}
.listBottom::after {
  background-color: #f5f5f9;
  content: "";
  height: 1rpx;
  left: 32rpx;
  position: absolute;
  top: 0;
  width: 100vw;
}
.listBottomItem {
  padding: 0 40rpx;
}
.listBottom span {
  padding-right: 20rpx;
}
.btn-big {
  bottom: 20rpx;
  left: 0;
  margin-left: auto;
  margin-right: auto;
  position: fixed;
  right: 0;
}
.add-btn-icon {
  height: 38rpx;
  margin-right: 16rpx;
  width: 38rpx;
}
.count-wrapper .icon {
  height: 18rpx;
  margin-left: 10rpx;
  width: 20rpx;
}
.titleOpIoc {
  height: 24rpx;
  width: 24rpx;
}
.opIoc {
  height: 48rpx;
  width: 48rpx;
}
.typeName {
  font-size: 30rpx;
  font-weight: 600;
  padding-bottom: 20rpx;
}
.powerLimit {
  color: #999bb4;
  font-size: 24rpx;
  padding-top: 16rpx;
}
.listContainer {
  position: relative;
}
.search-box {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 100;
}
.search-btn {
  margin: 0 5px;
}
