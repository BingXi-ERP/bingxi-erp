page {
  background-color: #f5f5f9;
}
input {
  background: #fff;
  height: 100rpx;
  line-height: 100rpx;
}
.title,
input {
  color: #999;
  font-size: 28rpx;
  padding-left: 50rpx;
}
.title {
  height: 80rpx;
  line-height: 80rpx;
  margin: 20rpx 0;
}
.powerContent {
  background: #fff;
  border-bottom: 1rpx solid #ccc;
  color: #999;
  font-size: 28rpx;
  height: 120rpx;
  line-height: 50rpx;
  padding-left: 50rpx;
  padding-top: 10rpx;
  position: relative;
}
.powerContent .icon {
  height: 18rpx;
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
}
.btn-big {
  bottom: 20rpx;
  left: 0;
  margin-left: auto;
  margin-right: auto;
  position: fixed;
  right: 0;
}
.add-btn-icon {
  height: 38rpx;
  margin-right: 16rpx;
  width: 38rpx;
}
.comfCustomer {
  height: 100%;
  overflow: hidden;
  padding-left: 60rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 400rpx;
}
