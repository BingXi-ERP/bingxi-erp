page {
  background-color: #f5f7f9;
}
.swiper {
  width: 100%;
}
.swiper-item {
  height: 480rpx;
  width: 750rpx;
}
.flx-justify-between {
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
}
.svg-icon {
  height: 32rpx;
  width: 32rpx;
}
.product_tabs {
  background: #eff0f7;
  border-radius: 28rpx 28rpx 0rpx 0rpx;
  padding: 35rpx;
}
.product_tabs .van-tabs__wrap {
  height: 100rpx !important;
  margin-bottom: 16rpx;
}
.product_tabs .van-tabs__wrap .van-tabs__nav {
  background-color: #f5f7f9 !important;
}
.product_tabs .van-tabs__wrap .van-tab {
  font-size: 14px !important;
}
.product_tabs .van-tabs__wrap .van-tab--active {
  font-weight: 400 !important;
}
.product_tabs .van-tabs__wrap .van-tabs__line {
  display: block;
  height: 8rpx !important;
  width: 48rpx !important;
}
.product_content {
  padding-bottom: 20px;
}
.h1 {
  color: #0b0b0b;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 35rpx;
}
.product_content .name_price {
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
}
.price {
  color: #ff2332;
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 35rpx;
}
.cell {
  color: #0b0b0b;
  display: inline;
  font-size: 22rpx;
  font-weight: 400;
}
.product_content .product_view,
.product_content .product_view .product_view_item {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.product_content .product_view .product_view_item {
  color: rgba(0, 0, 0, 0.3);
  margin-left: 32rpx;
}
.product_content .product_view .product_view_item .span {
  font-size: 12px;
  margin-left: 8rpx;
}
.product_content .product_view .product_view_item:first-child {
  margin-left: 0;
}
.product-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}
.card-title {
  color: #676767;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 35rpx;
}
.plat_spu {
  color: rgba(0, 0, 0, 0.5);
  display: inline-block;
  margin-bottom: 24rpx;
}
.card-mt-8 {
  margin-top: 16rpx;
}
.card-mb-8 {
  margin-bottom: 16rpx;
}
.property_item {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  margin-bottom: 38rpx;
}
.property_item .left {
  color: rgba(0, 0, 0, 0.5);
  font-size: 14px;
  min-width: 200rpx;
}
.property_item .left .span {
  color: #676767;
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 20rpx;
}
.property_item .right {
  flex: 1;
  font-size: 14px;
  line-height: 40rpx;
  text-align: right;
}
.property_item:last-child {
  margin-bottom: 0;
}
.color_title {
  font-size: 16px;
  margin-bottom: 80rpx;
}
.color_title .span {
  color: rgba(0, 0, 0, 0.5);
  font-size: 12px;
}
.color_block_row .color_block {
  margin-bottom: 40rpx;
  text-align: center;
}
.color_block_row .color_block_p {
  display: block;
  margin-bottom: 35rpx;
  margin-top: 14rpx;
}
.color_block_row .color_block_div {
  align-items: center;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 8rpx 0 rgba(0, 0, 0, 0.1);
  display: -webkit-flex;
  display: flex;
  height: 180rpx;
  justify-content: center;
  width: 180rpx;
}
.supplier_info {
  background: #fff;
  border-radius: 16rpx;
}
.supplier_info .supplier_top {
  align-items: center;
  box-sizing: border-box;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  padding: 32rpx;
}
.product_content .supplier_info .supplier_top .top_img {
  min-width: 96rpx;
}
.product_content .supplier_info .supplier_top .info {
  flex: 1;
  margin-left: 16rpx;
  position: relative;
}
.shop-btn-wrap {
  position: absolute;
  right: 0;
  top: 0;
}
.product_content .supplier_info .supplier_top .info h1 {
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product_content .supplier_info .category {
  box-sizing: border-box;
  display: -webkit-flex;
  display: flex;
  padding: 0 32rpx 32rpx;
}
.product_content .supplier_info .category .left {
  margin-top: 8rpx;
  min-width: 80rpx;
}
.product_content .supplier_info .category .right {
  flex: 1;
  margin-left: 16rpx;
}
.product_content .supplier_info .category .right .span {
  background: rgba(65, 119, 245, 0.08);
  border-radius: 32rpx;
  box-sizing: border-box;
  display: inline-block;
  font-size: 12px;
  height: 52rpx;
  margin-bottom: 16rpx;
  margin-right: 16rpx;
  padding: 12rpx 16rpx;
}
.supplier_info .contact {
  box-sizing: border-box;
  padding: 16px;
}
.supplier_info .contact .p {
  color: rgba(0, 0, 0, 0.8);
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.supplier_info .contact .p:last-child {
  margin-bottom: 0;
}
.product_content .supplier_info .p {
  color: rgba(0, 0, 0, 0.8);
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.product_content .supplier_info .p:last-child {
  margin-bottom: 0;
}
.product_content .supplier_info .address {
  margin-bottom: 50px;
  padding: 32rpx;
}
.product_content .supplier_info .address .item {
  margin-bottom: 32rpx;
}
.supplier_info .address .item .h1 {
  display: -webkit-flex;
  display: flex;
  font-weight: 700;
  justify-content: space-between;
}
.supplier_info .address .item .h1 .span {
  color: rgba(0, 0, 0, 0.3);
  font-size: 12px;
}
.supplier_info .address .item:last-child {
  margin-bottom: 0;
}
.color_sheet .color_ido_item {
  margin-bottom: 26rpx;
  padding: 0 32rpx;
}
.color_sheet .color_ido_item,
.color_sheet .color_ido_item .left {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.color_sheet .color_ido_item .left {
  border-radius: 8rpx;
  box-shadow: 0 4rpx 8rpx 0 rgba(0, 0, 0, 0.1);
  height: 96rpx;
  justify-content: center;
  margin-right: 16rpx;
  min-width: 96rpx;
  width: 96rpx;
}
.color_sheet .color_ido_item .right text {
  color: #000;
  line-height: 50rpx;
}
.color_sheet .color_ido_item .right .price {
  color: #ff2332;
}
.color_sheet .color_sheet_head {
  margin-bottom: 32rpx;
  margin-top: 46rpx;
  padding-left: 32rpx;
  text-align: left;
}
.color_sheet .h1 {
  display: -webkit-flex;
  display: flex;
  font-size: 16px;
  font-weight: 700;
  justify-content: space-between;
}
.color_sheet .price {
  color: #ff2332;
  font-size: 16px;
  margin-right: 140rpx;
}
.color_sheet .van-popup__close-icon--top-right {
  top: 40rpx;
}
.phone-box {
  height: auto;
  width: 100%;
}
.phone {
  height: 50px;
  line-height: 50px;
  text-align: center;
}
.btn-box {
  bottom: 0;
  box-sizing: border-box;
  left: 0;
  padding: 10px;
  position: fixed;
  width: 100%;
}
.cancel-btn {
  color: #007aff;
  font-size: 16px;
  height: 60px;
  line-height: 60px;
  text-align: center;
}
.restock_content {
  background-color: #f5f7f9;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  height: calc(100% - 112rpx);
  overflow: hidden;
}
.restock_bar {
  height: 92rpx;
  justify-content: space-between;
  padding: 0 16rpx;
}
.filter_tool,
.filter_tool_item,
.restock_bar {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.filter_tool_item {
  font-size: 14px;
  margin-right: 48rpx;
}
.restock_list {
  flex: 1;
  height: calc(100% - 94rpx);
}
.restock_flex {
  display: -webkit-flex;
  display: flex;
  flex-wrap: wrap;
}
.restock_inline {
  display: block;
}
.card_item {
  background-color: #fff;
  border-radius: 12rpx;
  height: 600rpx;
  margin-bottom: 16rpx;
  margin-right: 14rpx;
  overflow: hidden;
  width: calc(50% - 10rpx);
}
.card_item .card_img {
  align-items: flex-start;
  display: -webkit-flex;
  display: flex;
  min-height: 336rpx;
  position: relative;
}
.card_item van-image {
  width: 100%;
}
.card_item .card_img .address {
  background: rgba(0, 0, 0, 0.5);
  border-radius: 26rpx;
  bottom: 16rpx;
  color: #fff;
  font-size: 12px;
  height: 50rpx;
  line-height: 50rpx;
  padding: 0 20rpx;
  position: absolute;
  right: 16rpx;
  text-align: center;
}
.filter_tool_item image {
  height: 32rpx;
  margin-right: 8rpx;
  width: 32rpx;
}
.tool_bar_img {
  height: 32rpx;
  margin-left: 32rpx;
  width: 32rpx;
}
.card_item .card_img {
  width: 100%;
}
.card_item .card_img .address .van-icon {
  font-size: 14px;
  margin-right: 8rpx;
}
.card_item .card_img .van-image image {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  width: 100%;
}
.card_item .info {
  background-color: #fff;
  border-bottom-left-radius: 12rpx;
  border-bottom-right-radius: 12rpx;
  padding: 24rpx;
}
.card_item .info .h1 {
  display: inline-block;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.card_item .info .p {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  font-size: 12px;
  line-height: 44rpx;
}
.card_item .info .svg-icon {
  height: 32rpx;
  margin-right: 8rpx;
  width: 32rpx;
}
.card_item .info .p text {
  color: rgba(0, 0, 0, 0.5);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card_item:nth-of-type(2n) {
  margin-right: 0;
}
.card_inline_item {
  box-sizing: border-box;
  display: -webkit-flex;
  display: flex;
  height: 240rpx;
  justify-content: space-between;
  margin-right: 0;
  overflow: hidden;
  padding: 16rpx;
  width: 100%;
}
.card_inline_item .card_img {
  height: 208rpx;
  min-height: 208rpx;
  min-width: 208rpx;
  width: 208rpx;
}
.card_inline_item .address {
  bottom: 8rpx;
  right: 8rpx;
}
.card_inline_item .van-image {
  width: 100%;
}
.card_inline_item .van-image img {
  border-bottom-left-radius: 12rpx;
  border-bottom-right-radius: 12rpx;
}
.card_inline_item .info {
  flex: 1;
  padding: 0 24rpx;
}
.card_inline_item .info .p {
  font-size: 12px;
  line-height: 1;
  margin-bottom: 16rpx;
}
.card_inline_item .info .p text {
  font-size: 12px;
}
.card_item .info .p .price {
  color: #ff2332;
  margin-right: 20rpx;
}
.card_item .info .matrial {
  margin-bottom: 0;
}
.card_item .info .matrial text {
  display: inline-block;
  max-width: 250rpx;
}
.card_inline_item .info .matrial text {
  display: inline-block;
  font-size: 12px;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
