.search-record,
page {
  background-color: #f1f5fb;
  height: 100%;
}
.record-search-bar {
  background-color: #f1f5fb !important;
  padding-bottom: 0 !important;
}
.record-search-wrapper {
  background: #fff !important;
}
.record_tool {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  height: 80rpx;
  justify-content: space-between;
  padding: 0 32rpx;
}
.record_tool .tip {
  color: #4177f5;
  font-size: 14px;
  font-weight: 700;
}
.record_tool .time {
  align-items: center;
  color: #7f7f7f;
  display: -webkit-flex;
  display: flex;
  font-size: 12px;
}
.record_tool .time image {
  height: 32rpx;
  margin-left: 8rpx;
  width: 32rpx;
}
.record_content {
  height: calc(100% - 180rpx);
  padding: 0 16rpx;
}
.record_item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  padding: 32rpx 32rpx 24rpx;
}
.record_item .record_item_t {
  color: #7f7f7f;
  display: -webkit-flex;
  display: flex;
  font-size: 12px;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.record_item_t .title {
  color: #000;
  font-size: 14px;
  font-weight: 700;
}
.record_item .record_item_b {
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  width: 415rpx;
}
.record_item .record_item_b span {
  color: grey;
  font-size: 12px;
}
.record_item .record_item_b .name {
  display: inline-block;
  max-width: 170rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
