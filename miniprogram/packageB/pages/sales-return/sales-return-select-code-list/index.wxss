page {
  background-color: #eff0f7;
  padding-top: 40rpx;
}
.salesReturnSelectCodeList {
  padding: 0 32rpx 280rpx;
}
.arrow {
  position: absolute;
  right: -10px;
}
.listItem {
  align-items: flex-start;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 18rpx;
  position: relative;
}
.listItem .img {
  border-radius: 14rpx;
  flex-shrink: 0;
  height: 106rpx;
  margin-right: 24rpx;
  width: 106rpx;
}
.listItem .left {
  flex: 1;
}
.listItem .left-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
}
.listItem .itemDetail {
  align-items: center;
  color: #5d5d5d;
  display: -webkit-flex;
  display: flex;
  font-size: 22rpx;
  position: relative;
}
.itemTitle {
  color: #0b0b0b;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 40rpx;
}
.totle {
  margin-right: 10rpx;
}
.comfirmIcon {
  color: #ea0a0a;
  margin-left: 34rpx;
}
.salesReturnSelectCodeList .totle-name {
  color: #373c55;
  font-size: 24rpx;
  font-weight: 400;
}
.salesReturnSelectCodeList .totle-content {
  color: #e2525a;
  font-size: 26rpx;
  font-weight: 600;
  width: 450rpx;
}
.salesReturnSelectCodeList .totle-content:first-child {
  font-size: 22rpx;
}
.fixed-toolbar-bottom {
  padding: 0 20rpx 50rpx;
}
.refundBtn {
  background-color: #fff9f3;
  box-sizing: border-box;
  color: #999bb4;
  height: 56rpx;
  left: 0;
  padding: 0 32rpx;
  position: absolute;
  top: -56rpx;
  width: 100vw;
  z-index: 999;
}
.tips-word {
  color: #0b0b0b;
  font-size: 26rpx;
}
.refundBtn image {
  height: 30rpx;
  width: 30rpx;
}
.refundBtn .tips {
  height: 70rpx;
  left: 0;
  overflow: hidden;
  position: absolute;
  top: -60rpx;
}
.refundBtn .tips image {
  height: 84rpx;
  width: 640rpx;
}
.tip-dialog {
  height: 100%;
  width: 80%;
}
.tip-dialog .van-popup {
  border-radius: 16rpx;
  color: #64689e;
  font-size: 28rpx;
  width: 640rpx;
}
.popTitle {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  color: #373c55;
  display: inline-block;
  font-size: 36rpx;
  font-weight: 500;
  height: 176rpx;
  text-align: center;
  width: 100%;
}
.popContent {
  color: #70728c;
  line-height: 60rpx;
  margin: 32rpx 0;
  padding: 48rpx;
  text-align: left;
}
.popBtn {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: space-around;
}
.popBtn button {
  background-color: #fff;
  border: none;
  border-radius: 0;
  color: #fb562c;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 100rpx;
  position: relative;
  width: 50%;
}
.popBtn .cancelBtn,
.popBtn button {
  border-top: 2rpx solid #f4f4f4;
  font-size: 26rpx;
  height: 70rpx;
}
.popBtn .cancelBtn {
  border-right: 2rpx solid #f4f4f4;
  box-sizing: border-box;
  color: #5d5d5d;
}
.popTitle2 {
  color: #373c55;
  display: inline-block;
  font-size: 28rpx;
  font-weight: 500;
  padding-top: 30rpx;
  text-align: center;
  width: 100%;
}
.popContent2 {
  color: #0b0b0b;
  font-size: 26rpx;
  margin: 22rpx 0;
  padding: 48rpx;
}
.more {
  height: 60rpx;
  position: relative;
}
.moreIcon {
  color: #999bb4;
  font-size: 12px;
  font-weight: 400;
  height: 17px;
  left: 50%;
  position: absolute;
  text-align: center;
  top: 5px;
  transform: translateX(-50%);
  width: 80px;
}
