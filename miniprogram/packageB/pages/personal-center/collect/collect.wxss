page {
  background-color: #f8f8f8;
  height: 100%;
}
.search-box {
  background-color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  padding-top: 20rpx;
  width: 100%;
}
.search-box .search-input {
  margin-left: 34rpx;
}
.stall-list {
  background-color: #fff;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  height: 216rpx;
  margin-top: 20rpx;
  overflow: hidden;
  padding: 40rpx 44rpx;
}
.stall-list-img {
  background-color: #f8f8f8;
  border: 6rpx solid #fff;
  border-radius: 50%;
  box-shadow: 6rpx 6rpx 20rpx rgba(0, 0, 0, 0.2);
  height: 156rpx;
  overflow: hidden;
  width: 156rpx;
}
.stall-list-info {
  padding-left: 20rpx;
  width: 70%;
}
.stall-list-info-hd {
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  font-size: 34rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}
.stall-list-info-hd button {
  background-color: #fc5959;
  border: none;
  border-radius: 30px;
  color: #fff;
  float: right;
  font-size: 24rpx;
  height: 48rpx;
  line-height: 48rpx;
}
.stall-list-info-bd {
  overflow: hidden;
}
.stall-list-info-bd text {
  color: #9e9e9e;
  display: block;
  font-size: 26rpx;
  line-height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stall-list-info-fd span {
  background-color: #4a90e2;
  border-radius: 100rpx;
  color: #fff;
  display: inline-block;
  font-size: 20rpx;
  padding: 7rpx 14rpx;
}
.color-data-list {
  background-color: #fff;
  margin-top: 20rpx;
  padding-top: 30rpx;
}
.list-setting-left {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
}
.list-setting-left image {
  margin-top: 10rpx;
}
.list-setting-left button {
  padding: 0;
}
.media-list .list-setting-left image.icon-edit {
  margin-right: 10rpx;
  padding: 0;
}
.show-btn {
  font-size: 28rpx;
}
.search-box {
  position: relative;
}
.search-box input {
  padding-left: 70rpx;
  text-align: left;
}
.search-box .search-icon {
  height: 46rpx;
  left: 60rpx;
  position: absolute;
  top: 30rpx;
  width: 46rpx;
  z-index: 999;
}
.picture {
  height: 100%;
  width: 100%;
}
.modal-mask {
  background: #000;
  color: #fff;
  height: 100%;
  opacity: 0.5;
  top: 0;
  width: 100%;
  z-index: 9000;
}
.modal-dialog,
.modal-mask {
  left: 0;
  overflow: hidden;
  position: fixed;
}
.modal-dialog {
  background: #fff;
  border-radius: 36rpx;
  margin: -180rpx 105rpx;
  top: 50%;
  width: 540rpx;
  z-index: 9999;
}
.modal-title {
  color: #030303;
  font-size: 36rpx;
  padding-top: 50rpx;
  text-align: center;
}
.modal-content {
  padding: 50rpx 32rpx;
}
.modal-input {
  background: #fff;
  border-radius: 4rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  font-size: 28rpx;
}
.input {
  box-sizing: border-box;
  color: #333;
  font-size: 28rpx;
  height: 82rpx;
  line-height: 28rpx;
  padding: 0 20rpx;
  width: 100%;
}
input-holder {
  color: #666;
  font-size: 28rpx;
}
.modal-footer {
  border-top: 1rpx solid #dedede;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  flex-direction: row;
  font-size: 34rpx;
  height: 86rpx;
  line-height: 86rpx;
}
.btn-cancel {
  border-right: 1rpx solid #dedede;
  color: #666;
}
.btn-cancel,
.btn-confirm {
  text-align: center;
  width: 50%;
}
.btn-confirm {
  color: #ec5300;
}
.page-section {
  margin-bottom: 60rpx;
  width: 100%;
}
.page-section:last-child {
  margin-bottom: 0;
}
.page-section-title {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 10rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
}
.navbarlist {
  margin-top: 0;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 1000;
}
.navbarlist view {
  text-align: center;
  width: 50%;
}
.navbarlist .active span {
  background-color: #ff6065;
  border-radius: 8rpx;
  bottom: 0;
  display: block;
  height: 6rpx;
  left: 45%;
  position: absolute;
  width: 40rpx;
}
.navbarlist-top {
  margin-top: 90rpx;
}
