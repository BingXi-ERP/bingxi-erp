page {
  width: 100%;
}
.search-history {
  margin: auto;
  width: 88%;
}
.search-history-title {
  font-size: 28rpx;
  justify-content: space-between;
}
.search-history-bd,
.search-history-title {
  display: -webkit-flex;
  display: flex;
  width: 100%;
}
.search-history-bd {
  flex-wrap: wrap;
  justify-content: flex-start;
  margin-top: 20rpx;
}
.history-tag {
  background: #ebebeb;
  border-radius: 2px;
  color: #3d3d3d;
  font-size: 12px;
  margin-right: 10rpx;
  margin-top: 10rpx;
  padding: 10rpx 20rpx;
}
