page {
  background-color: #f8f8f8;
  width: 100%;
}
.select-categories image {
  height: 36rpx;
  vertical-align: middle;
  width: 36rpx;
}
.select-title {
  -webkit--moz-box-pack: space-between;
  box-pack: space-between;
  color: #595959;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  font-size: 28rpx;
  justify-content: space-between;
  padding: 30rpx 20rpx;
}
.select-lists {
  background-color: #fff;
  width: 100%;
}
.select-list {
  -webkit--moz-box-pack: space-between;
  box-pack: space-between;
  border-bottom: 1rpx solid #f1f1f1;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  font-size: 28rpx;
  justify-content: space-between;
  padding: 20rpx 20rpx 20rpx 50rpx;
}
