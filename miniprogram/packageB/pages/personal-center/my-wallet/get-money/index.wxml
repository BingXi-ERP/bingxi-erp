<view class="getMoney">
    <view class="fr-between-center header">
        <view class="nomalText">提现金额</view>
        <view bindtap="moneyRecord" class="fl right">提现记录<image src="{{icon.info}}"></image>
        </view>
    </view>
    <view class="content">
        <view class="fl moneyInput">
            <text class="Y" style="margin-right:10rpx">¥</text>
            <input bindinput="userInput" data-item="moneyNum" disabled="{{moneyInfoList.balanceAmount<50}}" type="digit" value="{{moneyNum}}"></input>
        </view>
        <view class="tips colorRed" wx:if="{{moneyInfoList.balanceAmount>=50}}">可提现金额 {{moneyInfoList.balanceAmount}}元，每日仅可提现一次</view>
        <view class="tips colorRed" wx:else>可提现金额未达到50元，不可提现</view>
        <view class="toAccount">
            <view class="nomalText title">到账微信号</view>
            <input bindinput="userInput" class="accountInput" data-item="wxAccount" maxlength="25" type="text" value="{{wxAccount}}"></input>
        </view>
        <view class="tips">请输入您要提现的金额及收款微信号，平台工作人员将会联系您以便发送奖金！</view>
    </view>
    <button bindtap="moneyConfirm" class="toMoneyBtn g_LineatBtn" disabled="{{!moneyNum||!wxAccount||moneyNum<50}}">确认提现</button>
</view>
<van-popup :close-on-click-overlay="true" class="tip-dialog" show="{{showPop}}">
    <text class="popTitle">温馨提示</text>
    <view class="popContent">您好，这边查出您在刷需求并且自行回复，将冻结账号一个月不可提现，在此期间，您正常回复没有刷单，才会解冻账号正常提现，非常感谢您的配合。</view>
    <view class="popBtn">
        <button catch:tap="cancleService" class="popBtn cancelBtn" size="small">取消</button>
        <button catch:tap="cancleService" class="popBtn" openType="contact" sessionFrom="weapp" size="small">联系客服</button>
    </view>
</van-popup>
