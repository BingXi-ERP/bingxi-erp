page {
  background: #f5f5f5;
  box-sizing: border-box;
  padding: 32rpx;
}
.getMoney {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx;
  position: relative;
  z-index: 1;
}
.nomalText {
  color: #373c55;
  font-family: PingFangSC-Medium;
  font-size: 14px;
  font-weight: 500;
}
.header .right {
  color: #4c7cf9;
  font-family: PingFangSC-Regular;
  font-size: 12px;
  font-weight: 400;
  height: 30px;
}
.right image {
  height: 32rpx;
  margin-left: 10rpx;
  width: 32rpx;
}
.moneyInput {
  border-bottom: 1rpx solid #f5f5f5;
  color: #373c55;
  font-family: SFProText-Regular;
  font-size: 40px;
  font-weight: 400;
}
.moneyInput,
.moneyInput input {
  height: 120rpx;
}
.tips {
  color: #999bb4;
  font-family: PingFangSC-Regular;
  font-size: 12px;
  font-weight: 400;
  margin-top: 20rpx;
}
.colorRed {
  color: #ff6d6d;
}
.toAccount {
  border-bottom: 1rpx solid #f5f5f5;
  color: #373c55;
  font-family: PingFangSC-Medium;
  font-size: 16px;
  font-weight: 500;
  margin-top: 50rpx;
}
.toAccount input {
  height: 80rpx;
}
.placeholder {
  color: #999bb4;
}
.toMoneyBtn {
  margin-top: 50rpx;
}
.tip-dialog {
  height: 100%;
  width: 80%;
}
.tip-dialog .van-popup {
  border-radius: 16rpx;
  color: #64689e;
  font-size: 28rpx;
  padding: 64rpx 0 0;
  width: 640rpx;
}
.popTitle {
  color: #373c55;
  display: inline-block;
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
}
.popContent {
  margin: 32rpx 0 64rpx;
  padding: 48rpx;
}
.popBtn {
  align-items: center;
  border-top: 1rpx solid #edeff6;
  display: -webkit-flex;
  display: flex;
  justify-content: space-around;
}
.popBtn button {
  background-color: #fff;
  border: none;
  color: #336af8;
  font-size: 32rpx;
  font-weight: 500;
  height: 100rpx;
  line-height: 100rpx;
  width: 50%;
}
.popBtn .cancelBtn {
  border-right: 1rpx solid #edeff6;
  box-sizing: border-box;
}
