<view class="moneyRecord">
  <view
    class="fr-between-center recordList"
    wx:for="{{recordList}}"
    wx:key="{{item.createTime}}"
  >
    <view class="left">
      <view class="title">微信提现(微信账号)</view>
      <view class="time"
        >提现时间 {{formatDateTime(item.createTime,false,true)}}</view
      >
    </view>
    <view class="right">
      <view class="money">{{item.optAmount}}元</view>
      <view class="status"
        >{{item.status==1?'处理中':item.status==2?'已到账':item.status==3?'提现失败':''}}</view
      >
    </view>
  </view>
  <view class="more">
    <view wx:if="{{isAll}}">没有更多记录了</view>
    <view wx:else>上拉更多数据</view>
  </view>
</view>
