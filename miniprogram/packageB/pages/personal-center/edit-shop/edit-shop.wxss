page {
  background-color: #eff0f7;
}
.edit-shop {
  overflow: hidden;
  padding-bottom: 200rpx;
  width: 100%;
}
.mine-center {
  text-align: center;
}
.mine-center image.mine-center-header {
  border-radius: 100rpx;
  height: 180rpx;
  margin-top: 48rpx;
  width: 180rpx;
}
.mine-center image.mine-center-edit {
  height: 46rpx;
  margin-left: -50rpx;
  margin-top: -20rpx;
  width: 46rpx;
}
.center-title {
  color: #2c2c2c;
  display: block;
  font-size: 32rpx;
  margin: 30rpx 0 10rpx;
  padding-left: 40rpx;
  text-align: center;
}
.margin-footer {
  height: calc(
    env(safe-area-inset-bottom, 0px) + constant(safe-area-inset-bottom, 0px) +
      80
  );
  width: 100%;
}
.footer-inner {
  background-color: #ffc107;
  position: fixed;
  width: 100%;
}
.footer-btn {
  background: linear-gradient(180deg, #ff8b6c, #fb562c);
  border-radius: 35rpx;
  color: #fff;
  font-size: 28rpx;
  height: 70rpx;
  width: 680rpx;
}
.avatar-wrapper,
.banner-wrapper,
.category-wrapper,
.shop-detail-wrapper {
  position: relative;
}
.avatar-wrapper .avatar {
  border-radius: 50%;
  height: 112rpx;
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 112rpx;
}
.banner-wrapper .banner,
.e-container .avatar {
  border-radius: 8rpx;
  height: 106rpx;
  width: 106rpx;
}
.avatar-wrapper .right-arrow,
.banner-wrapper .right-arrow,
.category-wrapper .right-arrow,
.shop-detail-wrapper .right-arrow {
  height: 20rpx;
  position: absolute;
  right: 0rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
}
.input-list-li {
  border-bottom: 2rpx solid #f1f1f1;
  padding: 28rpx 0;
  position: relative;
}
.input-list-li:last-child {
  border-bottom: none;
}
.titleImg {
  height: 160rpx;
  line-height: 160rpx;
}
.input-list-li .title {
  color: #5d5d5d;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}
.input-list-li .e-container {
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
}
.input-list-li .defalut-icon {
  align-items: center;
  background-color: #f5f6fb;
  border-radius: 14rpx;
  display: -webkit-flex;
  display: flex;
  height: 106rpx;
  justify-content: center;
  width: 106rpx;
}
.input-list-li input {
  font-size: 26rpx;
  margin-top: 18rpx;
}
.marginB24 {
  height: 24rpx;
  position: relative;
}
.marginB24::after {
  background: #f5f5f5;
  bottom: 0;
  content: "";
  height: 24rpx;
  left: -32rpx;
  position: absolute;
  width: 100vw;
}
.mobile-wrapper text {
  width: 30%;
}
.input-list,
.remove-add {
  position: relative;
}
.input-list {
  background-color: #fff;
  border-radius: 20rpx;
  box-sizing: border-box;
  margin-left: 34rpx;
  margin-top: 20rpx;
  padding: 28rpx;
  width: calc(100vw - 68rpx);
}
.titleText {
  color: #70728c;
  font-family: PingFangSC-Regular;
  font-size: 14px;
  font-weight: 400;
}
.add-sth-li {
  border-bottom: 2rpx solid #f4f4f4;
  height: 96rpx;
}
.add-sth-li:last-child {
  border-bottom: none;
}
.addIcon {
  height: 20px;
  margin-right: 32rpx;
  width: 20px;
}
.remove-add {
  width: 250rpx;
}
.add-btn {
  color: #fb562c;
  font-family: PingFangSC-Medium;
  font-size: 15px;
  font-weight: 500;
  margin-left: 10rpx;
}
.remove-add image {
  height: 20px;
  margin-right: 32rpx;
  vertical-align: middle;
  width: 20px;
}
.picker {
  -moz-box-pack: space-between;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  flex-wrap: wrap;
  font-size: 26rpx;
  font-weight: 400;
  justify-content: space-between;
  margin-top: 20rpx;
}
.picker view {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.footer-one {
  background-color: #fff;
  bottom: 0;
  height: 108rpx;
  line-height: 108rpx;
  position: fixed;
  width: 100%;
  z-index: 999;
}
.footer-one button {
  background-color: #e4eeff;
  border: 1rpx solid #629cff;
  border-radius: 100rpx;
  color: #2f7bfd;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 15rpx;
  width: 90%;
}
.rightArrow {
  height: 20rpx;
  position: absolute;
  right: 0rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
}
.popBody {
  overflow-x: hidden;
  padding: 32rpx 32rpx 500rpx;
  position: relative;
}
.popBody .headers {
  margin-bottom: 40rpx;
}
.popBody .content {
  margin-bottom: 45rpx;
  position: relative;
}
.popBody .tips {
  bottom: 10rpx;
  color: #c7c8d8;
  font-size: 12px;
  position: absolute;
  right: 10rpx;
}
.inputAear {
  border: 1rpx solid #c7c8d8;
  margin-bottom: 20rpx;
}
.inputAear input {
  display: inline-block;
  font-size: 14px;
  height: 80rpx;
  line-height: 80rpx;
  padding-left: 10px;
  vertical-align: middle;
  width: 90%;
}
.btns {
  justify-content: flex-end;
}
.g_samllNormalBtn {
  background: #fff;
  border: 1rpx solid #e1e1e1;
  color: #373c55;
}
.popBody textarea {
  background: #f5f5f9;
  border: none;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 400;
  height: 250rpx;
  padding: 10px 10rpx 40rpx;
  width: 686rpx;
}
.teaxPlaceholder {
  font-size: 24rpx;
}
.bg-type {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-wrap: wrap;
  font-size: 26rpx;
  justify-content: flex-start;
  margin-top: 20rpx;
}
