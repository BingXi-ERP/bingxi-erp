.input-list-li {
  -webkit--moz-box-pack: space-between;
  box-pack: space-between;
  border-bottom: 1rpx solid #f1f1f1;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  height: 88rpx;
  justify-content: space-between;
  line-height: 88rpx;
  margin: 0 58rpx;
}
.input-list-li text {
  color: #171717;
  font-size: 28rpx;
  width: 40%;
}
.input-list-li input {
  font-size: 28rpx;
  margin-top: 18rpx;
  max-width: 60%;
  text-align: right;
}
