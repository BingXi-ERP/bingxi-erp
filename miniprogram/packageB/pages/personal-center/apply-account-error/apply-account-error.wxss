  display: flex;
  flex-direction: column;
  height: 100%;
  justify-content: center;
  margin-top: 200rpx;
}
.img-wrapper {
  height: 240rpx;
  width: 240rpx;
}
.title {
  color: #252525;
  font-family: PingFang SC-Bold, PingFang SC;
  font-size: 36rpx;
  font-weight: 700;
  margin: 72rpx 0 24rpx;
}
.text1 {
  color: #999;
  margin: 0 40rpx 80rpx;
}
.text1,
.text2 {
  font-family: PingFang SC-Regular, PingFang SC;
  font-size: 28rpx;
  font-weight: 400;
}
.text2 {
  bottom: 40rpx;
  color: #4177f5;
  position: absolute;
}
