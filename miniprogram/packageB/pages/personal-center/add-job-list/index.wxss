page {
  background: #eff0f7;
}
.addJobList {
  height: 100%;
  overflow: hidden;
}
.treeSelect {
  background-color: #fff;
  border-radius: 20rpx;
  height: 79vh;
  margin-left: 34rpx;
  margin-top: 40rpx;
  width: calc(100vw - 68rpx);
}
.stall-categories {
  -webkit--moz-box-pack: left;
  box-pack: left;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  height: 100%;
  justify-content: left;
  width: 100%;
}
.categories-left {
  border-right: 2rpx solid #f4f4f4;
  font-size: 28rpx;
  height: 100%;
  overflow-y: scroll;
  padding-top: 18rpx;
  width: 262rpx;
}
.categories-left-item {
  border-radius: 14rpx;
  color: #70728c;
  font-size: 26rpx;
  margin-bottom: 10rpx;
  margin-left: 18rpx;
  padding: 16rpx 18rpx;
  position: relative;
  width: 162rpx;
}
.categories-left-item.active {
  background: #fff0ec;
  color: #fb562c;
  position: relative;
}
.categories-right {
  background: #fff;
  color: #262626;
  font-size: 26rpx;
  height: 100%;
  line-height: 100rpx;
  margin-right: 2%;
  overflow: auto;
  width: 70%;
}
.categories-right-item {
  padding-left: 30rpx;
  padding-right: 30rpx;
  position: relative;
}
.categories-tag {
  background-color: #2f7bfd;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  height: 36rpx;
  position: absolute;
  right: 10rpx;
  text-align: center;
  top: 30%;
  width: 36rpx;
}
.categories-tag span {
  bottom: 0;
  display: inline-block;
  left: 0;
  line-height: 36rpx;
  margin: auto;
  position: absolute;
  right: 0;
  top: 0;
}
.disnone {
  display: none;
}
.search-input {
  margin: auto;
}
.search-icon {
  height: 44rpx;
  left: 24%;
  position: absolute;
  top: 10rpx;
  width: 44rpx;
  z-index: 99;
}
.search-box {
  margin-bottom: 20rpx;
}
.fl-between {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}
.categories-child-tag image {
  height: 36rpx;
  vertical-align: middle;
  width: 36rpx;
}
.btnGourp {
  align-items: center;
  bottom: 20px;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: right;
  position: fixed;
  right: 20px;
}
.btnGourp .confirm {
  background: linear-gradient(90deg, #7ab5ff, #336af8);
  color: #fff;
  font-weight: 600;
}
.btnGourp .confirm,
.cancel {
  border-radius: 36rpx;
  font-size: 14px;
  height: 64rpx;
  line-height: 64rpx;
  margin-left: 10px;
  width: 160rpx;
}
.cancel {
  background: #fff;
  border: 1rpx solid #d2d3de;
  color: #373c55;
  font-weight: 400;
}
.disbale {
  color: #c5c7d7;
}
.van-notice-bar__left-icon > image {
  height: 40rpx !important;
  margin-right: 16rpx !important;
  width: 40rpx !important;
}
.van-notice-bar__content {
  font-size: 22rpx !important;
}
