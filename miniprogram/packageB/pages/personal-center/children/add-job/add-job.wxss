page {
  background-color: #eff0f7;
}
.add-job-wrapper {
  background-color: #fff;
  border-radius: 20rpx;
  margin-left: 34rpx;
  margin-top: 40rpx;
  width: calc(100vw - 68rpx);
}
.item {
  border-bottom: 2rpx solid #f4f4f4;
  margin: 0 32rpx 24rpx;
  position: relative;
}
.item:last-child {
  border-bottom: none;
}
.add-job-title {
  color: #5d5d5d;
  font-size: 26rpx;
  padding-top: 28rpx;
}
.add-job-title text {
  color: red;
}
.a-auth {
  color: #0b0b0b !important;
  font-size: 26rpx;
}
.add-job-value {
  color: #333;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0 28rpx;
}
.add-job-value input {
  font-size: 26rpx;
  width: 100%;
}
.add-job-value text {
  color: silver;
  font-size: 26rpx;
}
.add-job-n {
  color: silver;
  font-size: 22rpx;
  position: absolute;
  right: 0;
  top: 28rpx;
}
.noLine::after {
  border: 0;
}
.child-list .child-list-bd {
  width: 80rpx;
}
.child-list-bd image {
  height: 44rpx;
  vertical-align: middle;
  width: 44rpx;
}
.child-list.child-list1 .child-list-bd {
  width: 30%;
}
.child-list.child-list1 textarea {
  height: 120rpx;
  padding-left: 30rpx;
}
.remark-input {
  background-color: #fff;
  font-size: 28rpx;
  font-weight: 400;
  height: 100rpx;
  line-height: 40rpx;
}
.role-wrapper {
  background-color: #f5f5f9;
  flex-wrap: wrap;
  justify-content: flex-start;
}
.role-block,
.role-wrapper {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.role-block {
  flex-direction: column;
  justify-content: center;
  margin: 0 0 30rpx 30rpx;
  padding: 10rpx 0;
  width: 330rpx;
}
.role-block .name {
  border-bottom: 1rpx solid #ddd;
  padding: 15rpx 120rpx 30rpx 0;
}
.role-block .tools {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  padding: 20rpx 0 10rpx;
}
.status {
  color: #333;
}
.status,
.status2 {
  font-size: 24rpx;
  margin-right: 20rpx;
}
.status2 {
  color: #999;
}
.del-wrapper {
  align-items: center;
  background-color: #f5f5f9;
  display: -webkit-flex;
  display: flex;
  justify-content: flex-end;
  position: absolute;
  right: 40rpx;
  top: 36rpx;
}
.del-wrapper .icon {
  height: 24rpx;
  margin-right: 10rpx;
  width: 24rpx;
}
.comfirm {
  bottom: 30rpx;
  left: 50%;
  position: fixed;
  transform: translateX(-50%);
  z-index: 999;
}
.textArea {
  padding-bottom: 20rpx;
}
.limit-leng {
  color: #c7c8d8;
  font-size: 20rpx;
  text-align: right;
}
.limit-leng-error {
  color: #f30;
}
.right-arrow {
  height: 20rpx;
  position: absolute;
  right: 0rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
}
