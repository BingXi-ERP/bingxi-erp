var filterEnum = function (callValue, enumData) {
  if (callValue === "" || callValue === undefined || callValue === null)
    return "--";
  if (typeof callValue === "object") {
    var filterData = enumData.filter(function (f) {
      return callValue.indexOf(f.value) !== -1;
    });
    return filterData.length
      ? filterData
          .map(function (item) {
            return item.label;
          })
          .join(",")
      : "--";
  }
  var filterData = enumData.filter(function (item) {
    return item.value === callValue;
  });
  return filterData && filterData.length ? filterData[0].label : "--";
};
var valueFormat = function (data, prop, dictData) {
  if (prop === "contactType") {
    return filterEnum(
      data[
        ((nt_1 = prop),
        null == nt_1 ? undefined : "number" === typeof nt_1 ? nt_1 : "" + nt_1)
      ],
      dictData.supplierTypeOption
    );
  }
  if (prop === "isDefault") {
    return filterEnum(
      data[
        ((nt_2 = prop),
        null == nt_2 ? undefined : "number" === typeof nt_2 ? nt_2 : "" + nt_2)
      ],
      dictData.defaultTypeOption
    );
  }
  if (prop === "addressType") {
    var value = data[
      ((nt_3 = prop),
      null == nt_3 ? undefined : "number" === typeof nt_3 ? nt_3 : "" + nt_3)
    ]
      ? data[
          ((nt_4 = prop),
          null == nt_4
            ? undefined
            : "number" === typeof nt_4
            ? nt_4
            : "" + nt_4)
        ]
          .split(",")
          .map(function (f) {
            f = Number(f);
            return f;
          })
      : [];
    return filterEnum(value, dictData.supplierAdrTypeOption);
  }
  if (prop === "address") {
    return (
      data.province +
      data.city +
      (data.district || "") +
      (data.subdistrict || "") +
      (data.detailAddress || "")
    );
  }
  return (
    data[
      ((nt_5 = prop),
      null == nt_5 ? undefined : "number" === typeof nt_5 ? nt_5 : "" + nt_5)
    ] || "--"
  );
};
module.exports = { valueFormat: valueFormat };
