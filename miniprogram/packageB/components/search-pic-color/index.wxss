.search-pic-color {
  display: -webkit-flex;
  display: flex;
}
.search-pic-color image {
  margin-right: 16rpx;
}
.empty_color,
.search-pic-color .color_card,
.search-pic-color image {
  border-radius: 12rpx;
  height: 128rpx;
  width: 128rpx;
}
.empty_color {
  align-items: center;
  border: 1px solid #e5e5e5;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
}
.empty_color image {
  height: 48rpx;
  margin-right: 0;
  width: 48rpx;
}
