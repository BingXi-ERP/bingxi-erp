.colorBtn {
  background: linear-gradient(90deg, #7ab5ff, #336af8);
  border-radius: 48rpx;
  bottom: 60rpx;
  box-shadow: 0 6px 12px -2px rgba(120, 169, 255, 0.5);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  height: 96rpx;
  left: 50%;
  line-height: 96rpx;
  position: fixed;
  text-align: center;
  transform: translateX(-50%);
  width: 686rpx;
  z-index: 99;
}
