.env-page {
  padding: 32rpx;
  background: #f7f7f7;
  min-height: 100vh;
  box-sizing: border-box;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.hint .cur {
  color: #07c160;
  font-weight: 600;
  margin: 0 8rpx;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #fff;
  background: #ff9d00;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
}

.tag.def {
  background: #999;
}

.list {
  display: flex;
  flex-direction: column;
}

.item {
  position: relative;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid transparent;
}

.item.active {
  border-color: #07c160;
  background: #f0fff6;
}

.item .name {
  font-size: 30rpx;
  color: #222;
  font-weight: 500;
}

.item .host {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.item .badge {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  font-size: 22rpx;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.actions {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
}

.btn {
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 18rpx;
}

.btn.ghost {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.tip {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 12rpx;
  line-height: 1.6;
}
