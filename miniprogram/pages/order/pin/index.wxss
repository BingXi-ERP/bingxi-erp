page {
  background-color: #eff0f7;
  padding-bottom: 100rpx;
  padding-top: 40rpx;
}
.data-empty {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  height: 100vh;
  justify-content: center;
}
.data-empty-image {
  height: 200rpx;
  margin: 0 auto;
  text-align: center;
  width: 200rpx;
}
.data-empty-image image {
  height: 100%;
  width: 100%;
}
.data-empty-content {
  color: grey;
  margin-top: 30rpx;
  text-align: center;
}
.data-empty-title {
  font-size: 32rpx;
}
.order-pin {
  color: #333;
  font-size: 28rpx;
}
.list-item {
  background-color: #fff;
  border-radius: 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  margin-left: 34rpx;
  padding: 30rpx;
  position: relative;
  width: calc(100vw - 68rpx);
}
.order-type {
  color: #fff;
  display: block;
  font-size: 24rpx;
  text-align: right;
}
.order-type::after {
  border-bottom: 18rpx solid transparent;
  border-right: 18rpx solid #fff;
  border-top: 18rpx solid transparent;
  content: "";
  display: block;
  height: 0;
  position: absolute;
  right: 0rpx;
  top: 1rpx;
  width: 0;
}
.order-info {
  padding-bottom: 30rpx;
  position: relative;
}
.order-product {
  background-color: #f9f9fb;
  border-radius: 20rpx;
  position: relative;
}
.order-status {
  bottom: 37rpx;
  color: #ea0a0a;
  font-size: 26rpx;
  position: absolute;
  right: 0;
}
.order-create-by {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.order-create-by image {
  border-radius: 50%;
  height: 54rpx;
  margin-right: 20rpx;
  width: 54rpx;
}
.order-create-by text {
  color: #0b0b0b;
  flex: 1;
  font-size: 28rpx;
}
.order-create-at {
  color: silver;
  display: block;
  font-size: 22rpx;
  margin-bottom: 20rpx;
}
.order-product .sale-type {
  background: #fff0ec;
  border-radius: 0rpx 20rpx 0rpx 20rpx;
  color: #fb562c;
  font-size: 22rpx;
  height: 42rpx;
  line-height: 42rpx;
  position: absolute;
  right: 0;
  text-align: center;
  top: 0;
  width: 98rpx;
}
.order-product .product {
  display: -webkit-flex;
  display: flex;
  padding: 20rpx;
}
.order-product .product-image {
  border-radius: 14rpx;
  height: 104rpx;
  margin-right: 34rpx;
  width: 104rpx;
}
.order-product .product-content {
  width: 500rpx;
}
.order-product .product-content text {
  display: block;
}
.order-product .product-total {
  color: #5d5d5d;
  font-size: 22rpx;
  margin-top: 40rpx;
}
.order-actions {
  display: -webkit-flex;
  display: flex;
  justify-content: flex-end;
  text-align: right;
}
.order-actions .button-normal {
  background: #fff;
  border: 1px solid #ffe6df;
  border-radius: 40rpx;
  color: #fb562c;
  font-weight: 400;
  margin-right: 10rpx;
}
.order-actions .button-normal,
.order-actions .button-primary {
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-left: 10rpx;
  margin-top: 34rpx;
  text-align: center;
  width: 174rpx;
}
.order-actions .button-primary {
  background: linear-gradient(180deg, #ff8b6c, #fb562c);
  border-radius: 35rpx;
  color: #fff;
  display: inline-block;
  margin-right: 0;
}
.close-reason {
  padding: 85rpx 30rpx 30rpx;
  position: relative;
}
.close-reason image {
  height: 48rpx;
  position: absolute;
  right: 30rpx;
  top: 20rpx;
  width: 48rpx;
}
.close-reason .close-reason-input,
.close-reason textarea {
  background: #f5f5f9;
  box-sizing: border-box;
  font-size: 28rpx;
  height: 334rpx;
  padding: 30rpx;
  width: 100%;
}
.close-reason .close-reason-input {
  color: #999;
}
.dialog-close-reason .van-button--default {
  color: #333;
  font-size: 32rpx;
}
.dialog-close-reason .van-dialog__confirm,
.dialog-close-reason .van-dialog__confirm:active {
  color: #2f7bfd !important;
  font-size: 32rpx;
  font-weight: 600;
}
