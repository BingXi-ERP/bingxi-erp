.container-gray {
  background-color: #f5f6fa;
}
.receipt-success {
  color: #333;
  font-size: 28rpx;
}
.receipt-success .receipt-result {
  background-color: #2d74ee;
  background-image: url(https://img.duibu.cn/duibu/shop/img/customer/bg_status.svg);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  box-sizing: border-box;
  color: #fff;
  display: -webkit-flex;
  display: flex;
  height: 266rpx;
  margin-bottom: 20rpx;
  padding: 40rpx 40rpx 40rpx 64rpx;
  position: relative;
}
.amount-panel {
  background-color: #fff;
  border-radius: 16rpx;
  bottom: -92rpx;
  color: #70728c;
  height: 96rpx;
  left: 0;
  margin: 0 32rpx;
  padding: 32rpx;
  position: absolute;
  width: calc(100% - 118rpx);
}
.amount-panel .n {
  font-size: 32rpx;
}
.amount-panel .amount {
  color: #e15959;
  font-size: 48rpx;
  font-weight: 500;
}
.receipt-success .receipt-result-content {
  flex: 1;
}
.receipt-success .receipt-result-content text {
  display: block;
}
.receipt-success .receipt-result-content .receipt-result-title {
  font-size: 40rpx;
  margin-bottom: 15rpx;
}
.receipt-success .receipt-result-content .receipt-result-detail {
  font-size: 20rpx;
  opacity: 0.5;
}
.receipt-info {
  border-radius: 16rpx;
  margin: 116rpx 30rpx 0;
  padding: 32rpx;
}
.receipt-info .cell {
  padding-left: 0;
  padding-right: 0;
}
.receipt-info .cell-title,
.receipt-info .cell-value {
  color: #999;
}
.receipt-info text {
  vertical-align: middle;
}
.receipt-info .h3 {
  font-size: 30rpx;
}
.receipt-info .amount {
  color: #e2525a;
  font-size: 40rpx;
  margin-top: 20rpx;
}
.receipt-info .strong {
  font-size: 60rpx;
  margin-left: 10rpx;
}
.receipt-info-buttons button {
  background-color: #f5f6fa;
  border: 1rpx solid #4c7cf9;
  border-radius: 40rpx;
  color: #4c7cf9;
  font-size: 28rpx;
  margin-top: 48rpx;
  width: 256rpx;
}
.fixed-bottom-confirm {
  background: #fff;
  bottom: 0;
  left: 0;
  padding: 20rpx 30rpx;
  position: fixed;
  right: 0;
}
.fixed-bottom-confirm button {
  background: #e4eeff;
  border: 1rpx solid #629cff;
  border-radius: 88rpx;
  border-radius: 44rpx;
  color: #2f7bfd;
  font-size: 32rpx;
  font-weight: 400;
  height: 88rpx;
  line-height: 88rpx;
}
.fixed-bottom-confirm button:active {
  opacity: 0.8;
}
.fixed-bottom-confirm button image {
  height: 38rpx;
  margin-right: 15rpx;
  vertical-align: middle;
  width: 38rpx;
}
.fixed-bottom-confirm button text {
  vertical-align: middle;
}
