page {
  height: 100%;
}
.overflow-hid {
  overflow-y: hidden;
}
.c-search-bar {
  background-color: red;
  padding: 20rpx 56rpx;
}
.c-search-bar-wrapper {
  align-items: center;
  background: #f5f6fa;
  border-radius: 44rpx;
  color: #c7c8d8;
  display: -webkit-flex;
  display: flex;
  height: 72rpx;
  line-height: 76rpx;
  padding: 0 30rpx;
  position: relative;
}
.c-search-bar-input {
  flex: 1;
  height: 100%;
  padding: 0 10rpx;
}
.c-search-bar-btn {
  height: 40rpx;
  position: absolute;
  right: 20rpx;
  top: 16rpx;
  width: 40rpx;
}
.order-list {
  color: #333;
  font-size: 28rpx;
  height: 100%;
}
.van-tab {
  color: #fff !important;
  font-size: 13px !important;
  max-width: 200rpx;
}
.van-tab,
.van-tabs .van-tabs__nav {
  background-color: #fb562c !important;
}
.van-tab--active .van-tab__title {
  color: #fff;
  font-weight: 500;
}
.van-tab__title {
  color: #82a5ff;
}
.van-tabs__line {
  background: #fff !important;
  bottom: 12rpx !important;
  height: 6rpx !important;
  left: 0 !important;
  transition-duration: 0s !important;
  width: 80rpx !important;
}
.drop-arrow-top {
  left: 22%;
  position: absolute;
  top: 31%;
  z-index: 99;
}
.data-empty {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  height: calc(100vh - 215rpx);
  justify-content: center;
}
.data-empty-image {
  height: 200rpx;
  margin: 0 auto;
  text-align: center;
  width: 200rpx;
}
.data-empty-image image {
  height: 100%;
  width: 100%;
}
.data-empty-content {
  color: grey;
  margin-top: 30rpx;
  text-align: center;
}
.data-empty-title {
  font-size: 32rpx;
}
.order-pin {
  color: #333;
  font-size: 28rpx;
}
.mask {
  background: rgba(0, 0, 0, 0.6);
  position: absolute;
  top: 0;
  width: 100%;
}
.list-wrapper {
  height: calc(100% - 310rpx);
}
.list {
  padding: 30rpx 30rpx 0;
}
.list-item {
  background-color: #fff;
  border-radius: 4px;
  padding: 30rpx;
  position: relative;
}
.order-info {
  border-bottom: 1rpx solid #edeff6;
  justify-content: space-between;
  padding-bottom: 30rpx;
}
.order-info,
.order-status {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.order-status {
  color: #999;
  font-size: 24rpx;
  justify-content: flex-end;
}
.order-status-hl {
  color: #e2525a;
}
.order-create-by {
  display: -webkit-flex;
  display: flex;
}
.order-create-by image {
  border-radius: 50%;
  height: 48rpx;
  margin-right: 20rpx;
  width: 48rpx;
}
.order-create-by text {
  flex: 1;
  font-size: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-create-at {
  color: #999bb4;
  display: block;
  font-size: 24rpx;
  height: 32rpx;
  line-height: 12rpx;
  margin-right: 32rpx;
}
.userName {
  width: 200rpx;
}
.order-product .product {
  border-bottom: 1rpx solid #edeff6;
  display: -webkit-flex;
  display: flex;
  padding: 30rpx 0;
}
.order-product .product-image {
  height: 88rpx;
  margin-right: 34rpx;
  width: 88rpx;
}
.order-product .product-content {
  width: calc(100% - 122rpx);
}
.order-product .product-content text {
  display: block;
}
.order-product .product-total {
  color: #999;
  font-size: 24rpx;
  margin-top: 20rpx;
}
.order-unpay {
  color: #ed5c5c;
  font-size: 24rpx;
  margin-bottom: -20rpx;
  text-align: right;
}
.order-total {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  font-size: 24rpx;
  justify-content: flex-end;
  margin-top: 30rpx;
}
.order-total .total-before {
  margin: 4rpx 32rpx 0 0;
}
.order-total .strong {
  color: #373c55;
  font-size: 32rpx;
  font-weight: 500;
}
.type-unpay {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: flex-end;
  padding-top: 28rpx;
  position: relative;
}
.order-type {
  background: linear-gradient(180deg, #ff8b6c, #fb562c);
  border-radius: 0 20rpx 20rpx 0;
  color: #fff;
  font-size: 24rpx;
  height: 40rpx;
  left: -30rpx;
  line-height: 40rpx;
  overflow: hidden;
  padding: 0 20rpx;
  position: absolute;
  text-align: center;
  top: 28rpx;
}
.order-actions {
  padding-top: 38rpx;
  text-align: right;
}
.order-actions button:not(:first-child) {
  margin-left: 10rpx;
}
.order-actions .button-normal,
.order-actions .button-primary {
  background: transparent;
  border: 1rpx solid #ccc;
  border-radius: 50rpx;
  color: #333;
  display: inline-block;
  font-size: 24rpx;
  height: 50rpx;
  line-height: 50rpx;
  min-width: 142rpx;
  padding: 0 30rpx;
}
.order-actions .button-primary {
  border: 1rpx solid #fb562c;
  color: #fb562c;
  font-weight: 600;
}
.close-reason {
  padding: 85rpx 30rpx 30rpx;
  position: relative;
}
.close-reason image {
  height: 48rpx;
  position: absolute;
  right: 30rpx;
  top: 20rpx;
  width: 48rpx;
}
.close-reason .close-reason-input,
.close-reason textarea {
  background: #f5f5f9;
  box-sizing: border-box;
  font-size: 28rpx;
  height: 334rpx;
  padding: 30rpx;
  width: 100%;
}
.close-reason .close-reason-input {
  color: #999;
}
.dialog-close-reason .van-button--default {
  color: #333;
  font-size: 32rpx;
}
.dialog-close-reason .van-dialog__confirm,
.dialog-close-reason .van-dialog__confirm:active {
  color: #2f7bfd !important;
  font-size: 32rpx;
  font-weight: 600;
}
.image-preview {
  background: #fff;
  width: 652rpx;
}
.image-preview .image-content {
  background: url(https://img.duibu.cn/duibu/shop/img/customer/img_fenxiangdingdan@2x.png)
    no-repeat 50%;
  background-size: cover;
  height: 534rpx;
  position: relative;
  width: 652rpx;
}
.image-preview .image-content text {
  color: #a2accc;
  font-size: 32rpx;
  font-weight: 600;
  left: 50%;
  line-height: 44rpx;
  position: absolute;
  top: 42rpx;
  transform: translateX(-50%);
}
.image-preview .image-content text::after {
  background: #7d88ab;
  bottom: -30rpx;
  content: "";
  height: 4rpx;
  width: 32rpx;
}
.image-preview .image-content image,
.image-preview .image-content text::after {
  display: block;
  left: 50%;
  position: absolute;
  transform: translateX(-50%);
}
.image-preview .image-content image {
  height: 270rpx;
  top: 204rpx;
  width: 270rpx;
}
.image-preview .image-tip {
  color: #333;
  font-size: 28rpx;
  line-height: 1.8;
  margin: 0 auto;
  padding: 40rpx 0;
  text-align: center;
  width: 70%;
}
.image-preview .actions {
  padding: 0 40rpx 40rpx;
  text-align: center;
}
.image-preview button {
  background: #2f7bfd;
  border-radius: 2rpx;
  color: #fff;
  display: inline-block;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
  width: 452rpx;
}
.no-power-wrapper {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-top: 200rpx;
}
.title {
  color: #333;
  font-size: 40rpx;
  margin-bottom: 20rpx;
}
.text1 {
  color: #333;
  font-size: 24rpx;
  margin-bottom: 80rpx;
}
.chooseModal {
  background: #fff;
  border-bottom: 1rpx solid #f5f5f9;
  height: 256rpx;
  left: 0;
  position: fixed;
  width: 100%;
  z-index: 999999;
}
.chooseModal .chooseItems {
  background: #fff;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  padding-left: 30rpx;
  padding-right: 30rpx;
  padding-top: 46rpx;
  position: absolute;
  width: 690rpx;
  z-index: 999999999999;
}
.chooseModal .chooseItems .chooseItem {
  background: #f8f9fc;
  color: #666;
  display: inline-block;
  font-size: 24rpx;
  font-weight: 600;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 30rpx;
  position: relative;
  text-align: Center;
  width: 200rpx;
}
.chooseItemActive {
  background: #e4eeff !important;
  color: #fb562c !important;
  font-weight: 500;
}
.tab-wrapper {
  position: relative;
}
.tab-vantabs .van-tabs {
  z-index: 9999;
}
.searchIcon {
  height: 48rpx;
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  z-index: 99999;
}
.displayFlex {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: 30rpx 30rpx 10rpx;
}
.data-choose {
  border: 1rpx solid #ccc;
  border-radius: 36rpx;
  color: #7e8083;
  font-size: 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  width: 260rpx;
}
.active-date {
  color: #000;
}
.dateRange {
  color: #333;
  display: inline-block;
  font-size: 28rpx;
  font-weight: 400;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0 20rpx;
  width: 28rpx;
}
.date-reset {
  color: #fb562c;
  display: inline-block;
  font-size: 14px;
  margin-left: 16rpx;
  min-width: 70rpx;
}
