page {
  background-color: #eff0f7;
  padding-bottom: 200rpx;
  padding-top: 40rpx;
}
.fixPage {
  left: 0;
  overflow-y: hidden;
  position: fixed;
  right: 0;
  top: 0;
}
.printing-order {
  background-color: #fff;
  border-radius: 20rpx;
  color: #333;
  font-size: 28rpx;
  margin-left: 34rpx;
  overflow: hidden;
  width: calc(100vw - 68rpx);
}
.panel-cell,
.row-cell {
  border-bottom: 2rpx solid #f4f4f4;
  margin: 0 28rpx;
  padding: 30rpx 0;
}
.row-cell {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.printing-order .cell-box {
  border-bottom: 2rpx solid #f4f4f4;
  margin: 0 28rpx;
  padding: 28rpx 0;
}
.panel-padding {
  padding: 28rpx 30rpx 0;
}
.panel-padding .panel-title {
  color: #5d5d5d;
  font-size: 26rpx;
  padding: 0;
}
.placeholder-mock {
  color: #999;
  font-size: 24rpx;
  position: relative;
  z-index: 1;
}
.printing-order .cell-title {
  color: #5d5d5d;
  font-size: 26rpx;
}
.printing-order .cell-boxx {
  height: 36rpx;
  width: 36rpx;
}
.printing-order .cell-val {
  color: #333;
  display: -webkit-flex;
  display: flex;
  font-size: 26rpx;
  justify-content: space-between;
  padding: 20rpx 0 0;
  text-align: left;
}
.printing-order .cell-val image {
  height: 36rpx;
  width: 36rpx;
}
.cell-val-pone {
  align-items: center;
  border-bottom: 2rpx solid #f4f4f4;
  color: #333;
  display: -webkit-flex;
  display: flex;
  font-size: 26rpx;
  justify-content: space-between;
  margin: 0 28rpx;
  padding: 28rpx 0;
  text-align: left;
}
.cell-val-pone image {
  height: 36rpx;
  width: 36rpx;
}
.printing-order .cell-value input {
  text-align: right;
}
.printing-order .cell-value .icon-checkbox {
  height: 38rpx;
  width: 38rpx;
}
.printing-order .textarea-wrapper {
  border-bottom: 2rpx solid #f4f4f4;
  border-radius: 2rpx;
  padding: 20rpx 0 0;
  position: relative;
}
.printing-order .no-border {
  border-bottom: 0;
}
.printing-order .textarea-wrapper textarea {
  font-size: 24rpx;
  height: 100rpx;
  line-height: 1.5;
  width: 100%;
}
.limit-leng {
  color: silver;
  font-size: 22rpx;
  position: absolute;
  right: 0;
  text-align: right;
  top: -26rpx;
}
.limit-leng-error {
  color: #f30;
}
.fakeArea {
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 28rpx;
  width: 100%;
}
.z-index {
  z-index: 99;
}
.fakeCheck {
  background: #d6d6db;
  border: 1rpx solid #f5f5f9;
  border-radius: 50%;
  height: 40rpx;
  width: 40rpx;
}
.fixed-bottom-tools {
  background: #fff;
  bottom: 0;
  box-sizing: border-box;
  display: -webkit-flex;
  display: flex;
  height: 164rpx;
  justify-content: flex-end;
  left: 0;
  padding: 13rpx 30rpx;
  position: fixed;
  right: 0;
}
.popCantain {
  text-align: center;
}
.popCantain .item,
.popCantain .title {
  height: 96rpx;
}
.popCantain .title {
  color: #000;
  font-size: 16px;
  font-weight: 500;
  line-height: 96rpx;
}
.popCantain .item {
  color: #373c55;
  font-size: 15px;
  font-weight: 500;
  line-height: 96rpx;
}
.button-normal {
  background: #fff;
  border: 1px solid #ffe6df;
  border-radius: 40rpx;
  color: #fb562c;
  font-weight: 400;
  margin-right: 28rpx;
}
.button-normal,
.button-normal-ineer {
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  width: 174rpx;
}
.button-normal-ineer {
  background: linear-gradient(180deg, #ff8b6c, #fb562c);
  border-radius: 35rpx;
  color: #fff;
  display: inline-block;
}
.listContent {
  max-height: 480rpx;
  overflow-y: auto;
}
.picker-custom-wrapper {
  height: 50%;
}
.picker-custom .picker-custom-content {
  padding: 0 32rpx;
}
.pickerItem {
  height: 96rpx;
}
.printText {
  color: #373c55;
  font-size: 30rpx;
}
.printImg {
  height: 40rpx;
  width: 40rpx;
}
@-webkit-keyframes openAnimate {
  0% {
    opacity: 0;
    transform: translateY(100%);
  }
  50% {
    transform: translateY(50%);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes openAnimate {
  0% {
    opacity: 0;
    transform: translateY(100%);
  }
  50% {
    transform: translateY(50%);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
@-webkit-keyframes closeAnimate {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  50% {
    transform: translateY(50%);
  }
  100% {
    opacity: 0;
    transform: translateY(100%);
  }
}
@keyframes closeAnimate {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  50% {
    transform: translateY(50%);
  }
  100% {
    opacity: 0;
    transform: translateY(100%);
  }
}
.openAnimate {
  animation-duration: 0.25s;
  animation-fill-mode: forwards;
  animation-name: openAnimate;
  animation-timing-function: linear;
}
.closeAnimate {
  animation-duration: 0.25s;
  animation-fill-mode: both;
  animation-name: closeAnimate;
  animation-timing-function: linear;
}
.tip-dialog {
  height: 100%;
  width: 80%;
}
.tip-dialog .van-popup {
  border-radius: 16rpx;
  color: #999bb4;
  font-size: 28rpx;
  padding: 46rpx 0 0;
  width: 640rpx;
}
.popTitle {
  color: #373c55;
  display: inline-block;
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
}
.popContent {
  color: #000;
  font-size: 26rpx;
  margin: 0 0 10rpx;
  padding: 48rpx;
  text-align: center;
}
.popBtn {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: space-around;
}
.popBtn button {
  background-color: #fff;
  border: none;
  color: #336af8;
  font-size: 32rpx;
  font-weight: 400;
  height: 100rpx;
  line-height: 100rpx;
  width: 50%;
}
.popBtn .cancelBtn {
  color: #5d5d5d;
}
.popBtn .cancelBtn,
.popBtn .confirmBtn {
  border-right: 2rpx solid #f4f4f4;
  border-top: 2rpx solid #f4f4f4;
  box-sizing: border-box;
  font-weight: 500;
  padding: 18rpx 0;
  width: 50%;
}
.popBtn .confirmBtn {
  color: #fb562c;
}
.picker-custom .grayColor,
.printing-order .grayColor {
  color: silver;
}
.van-picker__cancel {
  color: silver !important;
  font-size: 26rpx !important;
}
.van-picker-column__item,
.van-picker__title {
  color: #0b0b0b !important;
  font-size: 28rpx !important;
}
.van-picker__confirm {
  color: #fb562c !important;
  font-size: 26rpx !important;
}
