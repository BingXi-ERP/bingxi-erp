page {
  background-color: #f5f5f9;
}
.serch-wrapper {
  height: 100%;
  width: 100%;
}
.customer-list {
  height: 100%;
  margin-top: 20rpx;
}
.item-wrapper {
  height: 100%;
  width: 100%;
}
.search-btn-wrapper {
  border-radius: 50rpx;
  color: #ccc;
  font-size: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 20rpx auto;
  position: relative;
  width: 640rpx;
}
.text {
  margin-left: 40rpx;
}
.search-icon-wrapper {
  position: absolute;
  right: 46rpx;
  top: 50%;
  transform: translateY(-50%);
}
.search-icon-wrapper,
.search-icon-wrapper image {
  height: 40rpx;
  width: 40rpx;
}
.type {
  background: #fff;
  height: 60rpx;
  padding: 20rpx 50rpx 0;
}
.section {
  margin-top: 10rpx;
}
.section .flex-wrp {
  border: 2px solid #f5f5f9;
  padding: 10rpx 0;
}
.flex-wrp {
  background-color: #fff;
  display: -webkit-flex;
  display: flex;
  height: 120rpx;
}
.flex-item-lef {
  height: 120rpx;
  padding: 16rpx 20rpx;
  width: 100rpx;
}
.flex-item-middle {
  font-size: 28rpx;
  height: 120rpx;
  padding: 20rpx 15rpx;
  width: 400rpx;
}
.flex-item-right {
  color: #666;
  font-size: 24rpx;
  height: 120rpx;
  padding: 40rpx 15rpx;
  width: 200rpx;
}
.loading {
  font-size: 24rpx;
  margin-top: 10rpx;
  text-align: center;
}
.userName {
  display: inline-block;
  font-size: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}
.nav-wrapper {
  color: #2f7bfd;
  font-size: 24rpx;
  height: 852rpx;
  position: fixed;
  right: 20rpx;
  top: 275rpx;
}
.nav-item {
  margin-bottom: 5rpx;
}
