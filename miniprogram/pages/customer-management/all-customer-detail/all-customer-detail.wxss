page {
  background-color: #fff;
  height: 100%;
  width: 750rpx;
}
.topCard {
  background: #4471e7;
  height: 366rpx;
  overflow: hidden;
}
.flex-wrp {
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #fff;
  display: -webkit-flex;
  display: flex;
  height: 222rpx;
  justify-content: center;
  margin: 0 auto;
  padding: 38rpx 32rpx;
}
.flex-item-lef {
  padding-right: 28rpx;
}
.flex-item-lef .img-wrapper {
  border-radius: 50%;
  height: 114rpx;
  position: relative;
  width: 114rpx;
}
.flex-item-middle {
  font-size: 24rpx;
  min-width: 500rpx;
}
.flex-item-middle .mobile {
  color: #b8d5ff;
  margin-top: 2rpx;
  max-width: 480rpx;
}
.flex-item-right {
  height: 32rpx;
  margin-top: 15rpx;
}
.flex-item-right .icon {
  height: 42rpx;
  margin-right: 8rpx;
  width: 42rpx;
}
.unactiveTab {
  color: #999;
}
.actived,
.unactiveTab {
  display: inline-block;
  font-size: 28rpx;
  font-weight: 400;
  height: 50rpx;
  width: 200rpx;
}
.actived {
  color: #4c7cf9;
}
.active {
  color: #000 !important;
  display: inline-block;
  font-weight: 500;
  height: 50rpx;
}
.recordActiveTab {
  bottom: -5rpx;
  left: 16rpx;
}
.followActiveTab,
.recordActiveTab {
  background: #4c7cf9;
  border-radius: 4rpx;
  display: inline-block;
  height: 8rpx;
  position: absolute;
  width: 80rpx;
}
.followActiveTab {
  bottom: 9rpx;
  left: 262rpx;
}
.activeTab {
  background: #4c7cf9;
  border-radius: 4rpx;
  bottom: 9rpx;
  display: inline-block;
  height: 8rpx;
  left: 450rpx;
  position: absolute;
  width: 50rpx;
}
.bottom-centent {
  font-size: 26rpx;
  margin-bottom: 200rpx;
}
.bottom-centent .top {
  margin-top: 30rpx;
}
.add-wrapper {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: flex-start;
  margin: 30rpx 0 30rpx 50rpx;
}
.add-wrapper .today {
  font-size: 52rpx;
  margin-right: 56rpx;
}
.add-wrapper .addRecord {
  padding: 10rpx 15rpx;
}
.bottom-centent .content-left {
  font-size: 40rpx;
  padding-left: 50rpx;
  padding-right: 20rpx;
  text-align: right;
  width: 20%;
}
.bottom-centent .content-right {
  text-align: left;
  width: 15%;
}
.bottom-centent .content-spright {
  text-align: left;
  width: 75%;
}
.flexDisplay {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
}
.buttonSt {
  background: #3c84ff;
  color: #fff;
  font-size: 20rpx;
  height: 50rpx;
  width: 120rpx;
}
.imgStyle {
  border-radius: 50%;
  height: 114rpx;
  position: absolute;
  right: 5.45rpx;
  top: 4rpx;
  width: 114rpx;
}
.detailNum {
  padding: 0 32rpx;
}
.cardBottom {
  background: #f4f8ff;
  border-radius: 8px 8px 0 0;
  box-sizing: border-box;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  font-size: 30rpx;
  height: 146rpx;
  padding: 0 10rpx;
  text-align: center;
  width: 683rpx;
}
.cardBottom .dealNum {
  height: 82rpx;
  margin-top: 22rpx;
  text-align: center;
}
.dealCondition {
  width: 33%;
}
.dealCondition > view:nth-of-type(1) {
  color: #9ab0ea;
  font-size: 20rpx;
  font-weight: 400;
  margin-top: 10rpx;
}
.dealCondition > view:nth-of-type(2) {
  color: #4c7cf9;
  font-size: 32rpx;
  font-weight: 400;
  margin-top: 5rpx;
}
.tabStyle {
  border-bottom: 1rpx solid #ccc;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  font-size: 24rpx;
  padding: 20rpx 50rpx 16rpx;
  position: relative;
}
.tabStyle > view {
  width: 200rpx;
}
.tabStyle > view:nth-of-type(3) {
  width: 125rpx !important;
}
.fixBottom .icon {
  bottom: 100rpx;
  height: 160rpx;
  position: absolute;
  right: 10rpx;
  width: 160rpx;
}
.addRecord {
  background: #f2f5ff;
  border: 1rpx solid #2f7bfd;
  color: #2f7bfd;
  font-size: 26rpx;
  padding: 0rpx;
}
.Blacklist {
  background: rgba(0, 0, 0, 0.5);
  border-radius: 20%;
  color: #fff;
  display: inline-block;
  font-size: 20rpx;
  margin: 0 4rpx 4rpx;
  padding: 6rpx 10rpx;
  position: absolute;
  right: -3rpx;
  top: 50%;
  transform: translateY(-50%);
}
.record {
  background: #f8f9fc;
  margin: 0 30rpx 0 10rpx;
  padding: 20rpx 30rpx;
  width: 82%;
}
.recordPe {
  color: #6c6c6c;
}
.customerName {
  display: inline-block;
  font-size: 36rpx;
  font-weight: 600;
  max-width: 390rpx;
  overflow: hidden;
  padding: 5rpx 90rpx 5rpx 0;
  position: relative;
}
.customerName,
.name {
  text-overflow: ellipsis;
  white-space: nowrap;
}
.name {
  font-size: 40rpx;
  overflow: hidden !important;
  width: 60rpx !important;
}
.bottom-up {
  height: 220rpx;
  width: 100%;
}
.gotCard {
  border-top: 1rpx solid #ccc;
  margin-top: 20rpx;
  padding-top: 30rpx;
}
.orderRecordContent {
  background: #f5f5f9;
  min-height: calc(100% - 473rpx);
  padding-left: 30rpx;
  padding-right: 30rpx;
  padding-top: 20rpx;
}
.orderNo {
  color: #373c55;
}
.dataTime,
.orderNo {
  font-size: 24rpx;
  font-weight: 400;
}
.dataTime {
  color: #999;
}
.orderRecordCard {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
  width: 640rpx;
}
.orderRecordCard .top {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding-bottom: 26rpx;
}
.orderRecordCard .line {
  position: relative;
}
.orderRecordCard .line::after {
  border-top: 1rpx solid #f5f5f9;
  content: "";
  height: 1rpx;
  left: 0;
  position: absolute;
  top: -10rpx;
  width: 100%;
}
.orderRecordCard .middle {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  padding-bottom: 26rpx;
}
.orderRecordCard .Total {
  color: #333;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
  text-align: right;
}
.Total .text {
  color: #373c55;
  font-size: 24rpx;
  font-weight: 400;
}
.Total > .text:first-of-type {
  margin-right: 32rpx;
}
.Total .num {
  color: #373c55;
  font-size: 36rpx;
  font-weight: 500;
}
.orderRecordCard .middle .detailImg {
  margin-right: 30rpx;
}
.orderRecordCard .middle .detail {
  color: #333;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
  min-height: 65rpx;
  width: 400rpx;
}
.orderRecordCard .middle .detialColor {
  color: #999bb4;
  font-size: 24rpx;
}
.orderCondition {
  color: #e2525a;
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
  width: 300rpx;
}
.orderConditionClose {
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
}
.chooseModal {
  background: #fff;
  border-bottom: 1rpx solid #f5f5f9;
  height: 256rpx;
  left: 0;
  position: absolute;
  width: 100%;
  z-index: 999999;
}
.chooseModal .chooseItems {
  background: #fff;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  padding-left: 30rpx;
  padding-right: 30rpx;
  padding-top: 46rpx;
  position: absolute;
  width: 690rpx;
  z-index: 999999999999;
}
.chooseModal .chooseItems .chooseItem {
  background: #f8f9fc;
  color: #666;
  display: inline-block;
  font-size: 24rpx;
  font-weight: 600;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 30rpx;
  position: relative;
  text-align: Center;
  width: 200rpx;
}
.chooseItemActive {
  background: #e4eeff !important;
  color: #2f7bfd !important;
  font-weight: 500;
}
.chooseModal .chooseItems .chooseItem image {
  bottom: 0;
  position: absolute;
  right: 0;
}
.dictRight {
  margin-top: 40rpx;
  text-align: right;
  width: 670rpx;
}
.dictRight > span {
  display: inline-block;
  font-size: 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  width: 128rpx;
}
.dictRight > span:nth-of-type(1) {
  background: #e4eeff;
  border-radius: 50rpx 0 0 50rpx;
  color: #2f7bfd;
}
.dictRight > span:nth-of-type(2) {
  background: #2f7bfd;
  border-radius: 0 60rpx 60rpx 0;
  color: #fff;
}
.tabBar {
  position: relative;
}
.fixedTab {
  background: #fff;
  left: 0;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 999;
}
.spaceAdjust {
  top: -2rpx !important;
}
.fixedBC {
  bottom: 0;
  height: 140rpx;
  position: fixed;
  width: 100%;
}
.mask {
  background: rgba(0, 0, 0, 0.6);
  height: 782rpx;
  position: absolute;
  top: 0;
  width: 100%;
}
.banScroll {
  height: 500rpx;
  overflow: hidden;
}
.noResult {
  left: 50%;
  position: absolute;
  text-align: center;
  top: 50%;
  transform: translate(-50%, -25%);
}
.noResult .noPage {
  background: url(https://img.duibu.cn/duibu/shop/img/customer/Defaultpage_NoRecord_Color.png)
    no-repeat;
  background-position: 50%;
  background-size: 320rpx 320rpx;
  height: 320rpx;
  margin-bottom: 32rpx;
  width: 320rpx;
}
.noResult .title {
  color: #70728c;
  font-family: PingFangSC-Medium;
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.noResult .text {
  color: #999bb4;
  font-family: PingFangSC-Regular;
  font-size: 12px;
  font-weight: 400;
}
