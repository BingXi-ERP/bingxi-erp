<view id="add-record">
  <view class="input-wrapper f14 font-gray">
    <textarea
      autoHeight
      bindinput="bindinput"
      class="textarea"
      placeholder="请输入要记录的客户信息"
      showConfirmBar="{{confirmDisplay}}"
    ></textarea>
  </view>
  <upload-img bind:delImg="delImg" bind:uoloadImg="uoloadImg"></upload-img>
  <view bindtap="toColorCardList" class="color-card-wrapper">
    <panel-img iconSize="{{iconSize}}" list="{{panel}}"></panel-img>
    <view class="pick-wrapper f12 font-gray">
      <text class="color-card-item" wx:for="{{colorCardArr}}" wx:key="index">
        <text>{{item.goodsname}}</text>
        <text wx:if="{{index+1!=colorCardArr.length}}">，</text>
      </text>
    </view>
  </view>
</view>
<view bindtap="submit" class="g_bottomBtn">完成</view>
