page {
  background-color: #f8fafc;
}
.header-container {
  background: #fff;
  left: 0;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 10;
}
.header-container .search {
  box-sizing: border-box;
  gap: 12px;
  height: 100px;
  padding: 0 16px;
}
.connect-device-btn,
.header-container .search {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.connect-device-btn {
  flex-shrink: 0;
  font-size: 14px;
  gap: 6px;
}
.connect-device-btn image {
  height: 20px;
  width: 20px;
}
.filter-container {
  padding: 0 16px 16px;
}
.filter-container,
.left-tab {
  display: -webkit-flex;
  display: flex;
}
.left-tab {
  flex: 1;
  gap: 8px;
  overflow: auto;
}
.left-tab .table-item {
  background-color: #f8fafc;
  border-radius: 16px;
  color: #90a1b9;
  flex-shrink: 0;
  font-size: 12px;
  overflow: hidden;
  padding: 6px 12px;
}
.left-tab .table-item.active {
  background: #ff6900;
  color: #fff;
}
.filterChoose {
  background-color: #fff;
  box-sizing: border-box;
  color: #999bb4;
  flex-shrink: 0;
  font-size: 28rpx;
}
.filterChoose image {
  height: 24rpx;
  width: 24rpx;
}
.filterItem text {
  margin-right: 16rpx;
}
.itemCheck {
  color: #373c55;
}
.fr-between-center {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}
.list-container {
  background-color: #f8fafc;
  flex: 1;
  padding: 160px 8px 8px;
}
.project-item {
  background-color: #fff;
  border-radius: 12px;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
  display: -webkit-flex;
  display: flex;
  margin-bottom: 12px;
  overflow: hidden;
  transition: opacity 0.2s;
}
.project-item:active {
  opacity: 0.85;
}
.project-item .project-cover {
  flex-shrink: 0;
  height: 128px;
  overflow: hidden;
  position: relative;
  width: 128px;
}
.project-item .project-cover image {
  height: 100%;
  width: 100%;
}
.project-item .project-cover .cover-placeholder {
  align-items: center;
  background-color: #f1f5f9;
  color: #b0b8c9;
  display: -webkit-flex;
  display: flex;
  font-size: 12px;
  height: 100%;
  justify-content: center;
  width: 100%;
}
.project-item .project-cover .code {
  backdrop-filter: blur(2px);
  background: rgba(0, 0, 0, 0.45);
  border-radius: 10px;
  box-sizing: border-box;
  color: #fff;
  font-size: 12px;
  font-weight: 500;
  height: 20px;
  line-height: 20px;
  max-width: 80px;
  overflow: hidden;
  padding: 0 8px;
  position: absolute;
  right: 6px;
  text-align: center;
  text-overflow: ellipsis;
  top: 6px;
  white-space: nowrap;
}
.project-info {
  display: -webkit-flex;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  padding: 8px 12px;
}
.project-info .title {
  color: #1a1d29;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
}
.project-info .progress-container {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  gap: 10px;
  margin: 6px 0;
}
.progress-container .name {
  color: #9aa5bd;
  font-size: 12px;
}
.progress-container .progress {
  background-color: #f1f5f9;
  border-radius: 16px;
  height: 4px;
  overflow: hidden;
  position: relative;
  width: 80px;
}
.progress-container .progress .pp {
  background: #ff6900;
  height: 100%;
  width: 0;
}
.opr-btns {
  display: -webkit-flex;
  display: flex;
  gap: 10px;
}
.opr-btns .gather {
  background: #ff6900;
  border-radius: 8px;
  color: #fff;
  flex: 1;
  font-size: 12px;
  padding: 6px;
  text-align: center;
  transition: opacity 0.2s;
}
.opr-btns .gather:active {
  opacity: 0.8;
}
.opr-btns .setting {
  background: #f8fafc;
  border-radius: 8px;
  color: #4a5266;
  font-size: 12px;
  padding: 6px 12px;
  text-align: center;
  transition: opacity 0.2s;
}
.opr-btns .setting:active {
  opacity: 0.7;
}
