  margin-top: 20rpx;
}
.page-body .input-red,
.print-list-bd2 .textarea-wrp {
  height: 240rpx;
  padding: 20rpx;
  position: relative;
  width: 640rpx;
  z-index: 0;
}
.page-body .input-red {
  background: #fff3f3;
  border: 1rpx solid #f76476;
  border-radius: 8rpx;
