page {
  background-color: #f8f8f8;
}
.print-view {
  padding: 60rpx 0;
  position: fixed;
  top: 0;
  width: 100%;
}
.print-view,
.print-view-card {
  background-color: #fff;
  z-index: 999;
}
.print-view-card {
  border-radius: 16rpx;
  box-shadow: 1rpx 1rpx 4px 0 rgba(0, 0, 0, 0.11);
  display: -webkit-flex;
  display: flex;
  height: 260rpx;
  margin: auto;
  padding: 20rpx;
  width: 65%;
}
.print-view-card-reverse {
  flex-direction: row-reverse;
}
.print-view-card-reverse .print-view-card-code {
  margin-left: 20rpx;
  margin-right: 0;
  padding-top: 30rpx;
}
.print-view-card-code {
  display: inline-block;
  margin-right: 20rpx;
}
.print-view-card-code image {
  height: 178rpx;
  width: 178rpx;
}
.print-view-card-code text {
  color: #000;
  color: #70728c;
  display: block;
  font-size: 28rpx;
  font-size: 26rpx;
  font-size: 20rpx;
  text-align: center;
  width: 175rpx;
}
.print-view-card-name text {
  color: #000;
  display: block;
  font-size: 24rpx;
  line-height: 42rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.print-view-card-name .g_limtRowTwo {
  -webkit-line-clamp: 2;
}
.print-view-card-name .g_limtRowThree,
.print-view-card-name .g_limtRowTwo {
  word-wrap: break-word;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal !important;
  word-break: break-all;
}
.print-view-card-name .g_limtRowThree {
  -webkit-line-clamp: 3;
}
.print-view-card-name {
  flex: 1;
  overflow: hidden;
  width: 0;
}
.topstaff {
  height: 80rpx;
  left: 15%;
  position: absolute;
  top: -20rpx;
  width: 76%;
}
.leftstaff {
  height: 80%;
  left: 5%;
  position: absolute;
  width: 80rpx;
}
.print-list {
  background-color: #fff;
  margin-top: 20rpx;
}
.print-list1 {
  margin-top: 420rpx;
}
.print-list .print-list-bd {
  border-bottom: 1rpx solid #f1f1f1;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  font-size: 28rpx;
  justify-content: space-between;
  margin: auto;
  padding: 24rpx 0;
  width: 92%;
}
.print-list .print-list-bd text {
  width: 250rpx;
}
.print-list .print-list-bd text:nth-child(1) {
  color: #666;
}
.print-list-bd input {
  text-align: right;
}
.print-list-bd2 input {
  text-align: left;
}
.print-list-bd image {
  height: 44rpx;
  width: 44rpx;
}
.color-show {
  justify-content: space-between;
  width: 340rpx;
}
.color-show,
.pr-ls-shape {
  display: -webkit-flex;
  display: flex;
}
.pr-ls-shape {
  align-items: center;
}
.pr-ls-shape text {
  margin-right: 20rpx;
  width: auto !important;
}
.print-list2 {
  margin-bottom: 110rpx;
}
.fd-btn {
  bottom: 0;
  position: fixed;
}
.fd-btn button {
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 10rpx;
  width: 45%;
}
.print-view-card-name text.hide {
  display: none;
}
.print-view-card-name text.show {
  display: block;
}
.picker-select picker {
  padding-right: 25rpx;
  position: relative;
}
.picker-select picker::after {
  border-bottom: 1rpx solid #c3c8cb;
  border-right: 1rpx solid #c3c8cb;
  color: #c3c8cb;
  content: "";
  display: block;
  height: 14rpx;
  position: absolute;
  right: 0;
  top: 25%;
  transform: rotate(45deg);
  width: 14rpx;
}
.bottom {
  height: 100rpx;
  line-height: 100rpx;
  width: 100%;
}
.print-btn {
  background-color: #fff;
  bottom: 60rpx;
  left: 0rpx;
  padding: 20rpx 0;
  position: fixed;
  width: 100%;
  z-index: 999;
}
.print-btn button {
  background-color: #e4eeff;
  border: 1rpx solid #629cff;
  border-radius: 50rpx;
  width: 690rpx;
}
.page-body {
