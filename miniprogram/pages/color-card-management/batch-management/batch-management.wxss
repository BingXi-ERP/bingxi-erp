page {
  background-color: #f8f8f8;
}
.serch-input-wrapper {
  margin-bottom: 36rpx;
  padding: 20rpx 0 10rpx;
}
.item {
  align-items: center;
  background-color: #fff;
  border: 1rpx solid #fff;
  border-radius: 16rpx;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  margin: 20rpx auto;
  padding: 20rpx 0;
  width: 690rpx;
}
.check-wrapper {
  flex: 1;
}
.checked {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  height: 40rpx;
  margin: 0 auto;
  width: 40rpx;
}
.img-wrapper {
  position: relative;
}
.img {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  height: 160rpx;
  width: 160rpx;
}
.off {
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  height: 114rpx;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 114rpx;
}
.off .text {
  color: #fff;
  font-size: 24rpx;
  padding: 5rpx 10rpx;
}
.info-wrapper {
  display: -webkit-flex;
  display: flex;
  flex: 3;
  flex-direction: column;
  margin-left: 20rpx;
  padding-right: 30rpx;
}
.info-wrapper > view {
  flex: 1;
}
.other {
  display: -webkit-flex;
  display: flex;
  margin-top: 10rpx;
}
.see {
  text-align: left;
}
.colect,
.see {
  flex: 1;
}
.colect {
  text-align: right;
}
.bottom {
  height: 246rpx;
  line-height: 100rpx;
  width: 100%;
}
.footer-wrapper {
  bottom: 0rpx;
  height: 100rpx;
  left: 0rpx;
  position: fixed;
  right: 0rpx;
}
.footer-wrapper .item {
  flex: 1;
  font-size: 28rpx;
  text-align: center;
}
.footer-wrapper .item .footer-icon {
  height: 38rpx;
  margin-right: 16rpx;
  width: 38rpx;
}
.active {
  background-color: #f2f5ff !important;
  border: 1rpx solid #629cff !important;
}
.line {
  margin-right: 10rpx;
  position: relative;
}
.line::after {
  border-right: 1rpx solid #f5f5f5;
  content: "";
  height: 20rpx;
  position: absolute;
  right: -3rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
}
.fontColor {
  color: #373c55;
  font-size: 12px;
  font-weight: 500;
}
.allChoice {
  background: #e6f0ff;
  height: 80rpx;
  left: 0;
  padding-left: 48rpx;
  position: absolute;
  top: -80rpx;
  width: 100%;
}
.totleItem {
  color: #4c7cf9;
  font-weight: 400;
}
.allImg {
  margin: 0;
}
.marR {
  margin-right: 8px;
}
