<view class="c-search-bar">
    <view class="c-search-bar-wrapper">
        <input bindconfirm="searchList" bindinput="inputgetName" class="c-search-bar-input" confirmType="search" data-name="searchKey" placeholder="请输入色卡编号/品名搜索" type="text" value="{{customerInfo.fullname}}">
            <view catch:tap="searchList" class="searchBox">
                <image class="c-search-bar-btn" mode="aspectFit" src="/assets/images/icon2nd/ic_sous@3x.png"></image>
            </view>
        </input>
    </view>
</view>
<view class="noDataComtent" wx:if="{{recordList.length==0}}">
    <view class="noDataBg" style="background-image:url(\"{{noDataBg}}\")"></view>
    <view class="noDataContent">暂无数据</view>
</view>
<view class="listContainer" wx:else>
    <view bindtap="toDetail" class="recordList" data-item="{{item}}" wx:for="{{recordList}}" wx:key="index">
        <view>
            <image class="colorCard" mode="aspectFill" src="{{replImage(item.mainImgPath,globalApp,288)}}"></image>
        </view>
        <view>
            <view class="productName g_limtRowTwo">{{item.goodsName}} {{item.goodsNo}}</view>
            <view class="infoDetailed">
                <view class="times">{{item.printTimes}}次</view>
                <view>{{item.detailQuantities}}{{item.goodsUnit}}</view>
            </view>
        </view>
        <view class="bg-img right-arrow" style="background-image:url(\"{{rightArrow}}\")"></view>
    </view>
    <view class="more">
        <view class="moreIcon" wx:if="{{moreIcon}}">上拉更多</view>
        <view class="moreIcon" wx:if="{{!moreIcon}}">没有更多数据</view>
    </view>
</view>
