page {
  background: #f5f5f9;
}
.c-search-bar {
  background-color: #fff;
  padding: 20rpx 0;
}
.c-search-bar-wrapper {
  background: #edeff6;
  border-radius: 44rpx;
  height: 72rpx;
  line-height: 76rpx;
  margin-left: auto;
  margin-right: auto;
  position: relative;
  width: 686rpx;
}
.c-search-bar-wrapper,
.searchBox {
  align-items: center;
}
.searchBox {
  display: -webkit-flex;
  display: flex;
  height: 100%;
  justify-content: center;
  left: 30rpx;
  position: absolute;
  top: 0;
}
.c-search-bar-input {
  color: #c5c7d7;
  font-size: 28rpx;
  height: 100%;
  padding: 0 20rpx 0 88rpx;
}
.c-search-bar-btn {
  height: 50rpx;
  margin: 0 auto;
  width: 40rpx;
}
.recordList {
  background: #fff;
  border-radius: 8px;
  display: -webkit-flex;
  display: flex;
  height: 192rpx;
  margin-left: auto;
  margin-right: auto;
  margin-top: 32rpx;
  position: relative;
  width: 686rpx;
}
.colorCard {
  height: 144rpx;
  margin: 24rpx 30rpx 24rpx 24rpx;
  width: 144rpx;
}
.productName {
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
  height: 85rpx;
  margin-top: 32rpx;
  max-width: 400rpx;
}
.infoDetailed {
  color: #999;
  display: -webkit-flex;
  display: flex;
  font-size: 28rpx;
}
.times {
  margin-right: 128rpx;
}
.noDataComtent {
  margin-bottom: 100rpx;
}
.noDataBg {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: 300rpx 300rpx;
  height: 300rpx;
  margin-top: 330rpx;
  width: 100%;
}
.noDataContent {
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
  height: 34rpx;
  line-height: 34rpx;
  margin-top: 20rpx;
  text-align: center;
  width: 100%;
}
.more {
  height: 120px;
  margin-top: 20rpx;
  position: relative;
}
.moreIcon {
  color: #999bb4;
  font-size: 24rpx;
  height: 34rpx;
  left: 50%;
  position: absolute;
  text-align: center;
  top: 10rpx;
  transform: translateX(-50%);
  width: 160rpx;
}
.right-arrow {
  height: 20rpx;
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
}
.searchC {
  display: inline-block;
  height: 72rpx;
  position: absolute;
  right: 20rpx;
  top: 0rpx;
  width: 80rpx;
  z-index: 999;
}
