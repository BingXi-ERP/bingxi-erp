page {
  background-color: #f5f6fa;
}
.c-search-bar {
  background-color: #fff;
  padding: 20rpx 56rpx;
}
.c-search-bar-wrapper {
  align-items: center;
  background: #f5f5f9;
  border-radius: 44rpx;
  display: -webkit-flex;
  display: flex;
  height: 72rpx;
  line-height: 76rpx;
  padding: 0 30rpx;
  position: relative;
}
.c-search-bar-input {
  color: #c5c7d7;
  flex: 1;
  font-size: 28rpx;
  height: 100%;
  padding: 0 10rpx 0 45rpx;
}
.c-search-bar-btn {
  height: 50rpx;
  left: 20rpx;
  position: absolute;
  top: 10rpx;
  width: 40rpx;
}
.top-content {
  background-color: #fff;
  display: -webkit-flex;
  display: flex;
  justify-content: flex-start;
  padding: 0 32rpx;
}
.colorCard {
  height: 144rpx;
  margin: 24rpx 30rpx 24rpx 24rpx;
  width: 144rpx;
}
.productName {
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #333;
  display: -webkit-box;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 32rpx;
  overflow: hidden;
  width: 420rpx;
}
.infoDetailed {
  color: #999;
  display: -webkit-flex;
  display: flex;
  font-size: 28rpx;
  margin-top: 30rpx;
}
.times {
  margin-right: 128rpx;
}
.detailcontent {
  background-color: #fff;
  margin-top: 24rpx;
  padding: 0 32rpx;
}
.detailList {
  border-bottom: 1rpx solid #edeff6;
  font-size: 28rpx;
  height: 52px;
  justify-content: space-between;
  padding: 12px;
}
.detailList,
.vertical-show {
  align-items: flex-start;
  display: -webkit-flex;
  display: flex;
}
.vertical-show {
  flex-direction: column;
  justify-content: space-around;
  width: 150rpx;
}
.name-show {
  max-width: 210rpx;
}
.detail-name,
.name-show {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.detail-name {
  width: 260rpx;
}
.phone-font {
  color: #999bb4;
  margin-top: 10rpx;
}
.more {
  height: 120px;
  margin-top: 20rpx;
  position: relative;
}
.moreIcon {
  color: #999bb4;
  font-size: 24rpx;
  height: 34rpx;
  left: 50%;
  position: absolute;
  text-align: center;
  top: 10rpx;
  transform: translateX(-50%);
  width: 160rpx;
}
.noDataComtent {
  margin-bottom: 100rpx;
}
.noDataBg {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: 300rpx 300rpx;
  height: 300rpx;
  margin-top: 200rpx;
  width: 100%;
}
.noDataContent {
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
  height: 34rpx;
  line-height: 34rpx;
  margin-top: 20rpx;
  text-align: center;
  width: 100%;
}
