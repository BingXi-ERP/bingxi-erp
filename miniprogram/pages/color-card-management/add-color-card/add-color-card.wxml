<import src="../../tpl/color-card/addModal.wxml"></import>
<import src="../../tpl/color-card/classification.wxml"></import>
<template is="classification" data="{{showAdd:showAdd,categoryGoodsList:categoryGoodsList,app:app}}" wx:if="{{showClassification==1}}"></template>
<template is="addclassify" data="{{showType:showType,classifyName:classifyName}}" wx:if="{{showAdd==1}}"></template>
<view class="tabBarC">
    <view catchtap="changeTab" class="tabBar {{tabDisplay==0?'tabChoosed':''}}" data-index="0">面料信息</view>
    <view catchtap="changeTab" class="tabBar {{tabDisplay==1?'tabChoosed':''}}" data-index="1">面料图片</view>
</view>
<view class="wrapper">
    <view class="page-body" wx:if="{{tabDisplay==1}}">
        <view class="common-list">
            <view class="title-wrapper">
                <view style="display:flex;">
                    <view class="picTitle">面料图片</view>
                    <view class="isMust">*</view>
                    <view class="picPreview">
                        <view catchtap="colorCardPrev" class="tip">示例<van-icon name="photo-o"></van-icon>
                        </view>
                    </view>
                </view>
                <view class="subtitle">
                    <van-icon name="info-o"></van-icon>上传面料商品图，最多可添加9张</view>
            </view>
            <view class="weui-uploader__bd">
                <view class="weui-uploader__files">
                    <view class="weui-uploader__file" wx:for="{{remoteImageFiles}}" wx:for-item="image" wx:key="index">
                        <image bindtap="colorCardImgTap" bindtouchstart="movestart" catchtouchend="moveend" catchtouchmove="move" class="weui-uploader__img item {{index==current?'moving':'normal'}}" data-index="{{index}}" data-main="{{mainx}}" data-src="{{image.text}}" id="{{index}}" lazyLoad="true" mode="aspectFill" src="{{image.text}}" style="left:{{index==current?move_x:image.left}}px;top:{{index==current?move_y:image.top}}px">
                            <image catchtap="deleteImage" class="del-img" id="{{index}}" src="{{delImgIcon}}"></image>
                        </image>
                    </view>
                    <view class="add-icon-wrapper">
                        <view bindtap="chooseImage" class="add-icon" wx:if="{{remoteImageFiles.length<9}}">
                            <image class="upload-btn-icon" src="{{icon.upload}}"></image>
                            <text class="upload-btn-word">上传图片</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </view>
    <view class="page-body" wx:if="{{tabDisplay==1}}">
        <view class="common-list">
            <view class="title-wrapper">
                <view class="title" style="display:flex;">
                    <view class="picTitle">样衣图片</view>
                    <view class="picPreview">
                        <view catchtap="goodsSamplePrev" class="tip">示例<van-icon name="photo-o"></van-icon>
                        </view>
                    </view>
                </view>
                <view class="subtitle">
                    <van-icon name="info-o"></van-icon>上传样衣将吸引更多的流量，提高成交率，最多可添加9张</view>
            </view>
            <view class="weui-uploader__bd">
                <view class="weui-uploader__files">
                    <view class="weui-uploader__file" wx:for="{{goodsSampleImgList}}" wx:for-item="image" wx:key="index">
                        <image bindtap="goodsSampleImgTap" bindtouchstart="movestart3" catchtouchend="moveend3" catchtouchmove="move3" class="weui-uploader__img item {{index==current3?'moving':'normal'}}" data-index="{{index}}" data-main="{{mainx}}" data-src="{{image.text}}" id="{{index}}" lazyLoad="true" mode="aspectFill" src="{{image.text}}" style="left:{{index==current3?move3_x:image.left}}px;top:{{index==current3?move3_y:image.top}}px">
                            <image catchtap="deleteImage3" class="del-img" id="{{index}}" src="{{delImgIcon}}"></image>
                        </image>
                    </view>
                    <view class="add-icon-wrapper">
                        <view bindtap="chooseImage3" class="add-icon" wx:if="{{goodsSampleImgList.length<9}}">
                            <image class="upload-btn-icon" src="{{icon.upload}}"></image>
                            <text class="upload-btn-word">上传图片</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </view>
    <view class="page-body" wx:if="{{tabDisplay==1}}">
        <view class="common-list">
            <view class="title-wrapper">
                <view class="title" style="display:flex;">
                    <view class="picTitle">细节图片</view>
                    <view class="picPreview">
                        <view catchtap="detailImgPrev" class="tip">示例<van-icon name="photo-o"></van-icon>
                        </view>
                    </view>
                </view>
                <view class="subtitle">
                    <van-icon name="info-o"></van-icon>上传清晰的细节图片，便以图搜图快速找面料，最多可添加9张</view>
            </view>
            <view class="weui-uploader__bd">
                <view class="weui-uploader__files">
                    <view class="weui-uploader__file" wx:for="{{detailImageFiles}}" wx:for-item="image" wx:key="index">
                        <image bindtouchstart="movestart2" catchtap="detailImgTap" catchtouchend="moveend2" catchtouchmove="move2" class="weui-uploader__img item {{index==current2?'moving':'normal'}}" data-index="{{index}}" data-main="{{mainx}}" data-src="{{image.text}}" id="{{index}}" lazyLoad="true" mode="aspectFill" src="{{image.text}}" style="left:{{index==current2?move2_x:image.left}}px;top:{{index==current2?move2_y:image.top}}px">
                            <image catchtap="deleteImage2" class="del-img" id="{{index}}" src="{{delImgIcon}}"></image>
                        </image>
                    </view>
                    <view class="add-icon-wrapper">
                        <view bindtap="chooseImage2" class="add-icon" wx:if="{{detailImageFiles.length<9}}">
                            <image class="upload-btn-icon" src="{{icon.upload}}"></image>
                            <text class="upload-btn-word">上传图片</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </view>
    <view class="page-body" wx:if="{{tabDisplay==1}}">
        <view class="common-list">
            <view class="title-wrapper">
                <view class="title" style="display:flex;">
                    <view class="picTitle">色卡图片</view>
                    <view class="picPreview">
                        <view catchtap="goodsColorImgPrev" class="tip">示例<van-icon name="photo-o"></van-icon>
                        </view>
                    </view>
                </view>
                <view class="subtitle">
                    <van-icon name="info-o"></van-icon>上传清晰的色卡图片，最多可添加9张</view>
            </view>
            <view class="weui-uploader__bd">
                <view class="weui-uploader__files">
                    <view class="weui-uploader__file" wx:for="{{goodsColorImgList}}" wx:for-item="image" wx:key="index">
                        <image bindtap="goodsColorImgTap" bindtouchstart="movestart4" catchtouchend="moveend4" catchtouchmove="move4" class="weui-uploader__img item {{index==current4?'moving':'normal'}}" data-index="{{index}}" data-main="{{mainx}}" data-src="{{image.text}}" id="{{index}}" lazyLoad="true" mode="aspectFill" src="{{image.text}}" style="left:{{index==current4?move4_x:image.left}}px;top:{{index==current4?move4_y:image.top}}px">
                            <image catchtap="deleteImage4" class="del-img" id="{{index}}" src="{{delImgIcon}}"></image>
                        </image>
                    </view>
                    <view class="add-icon-wrapper">
                        <view bindtap="chooseImage4" class="add-icon" wx:if="{{goodsColorImgList.length<9}}">+</view>
                    </view>
                </view>
            </view>
        </view>
    </view>
    <form bindsubmit="formSubmit">
        <view class="page-body" wx:if="{{tabDisplay==0}}">
            <form catchsubmit="formSubmit" class="com-form">
                <view class="common-list">
                    <view class="validate">色号<text>*</text>
                    </view>
                    <view class="common-list-val">
                        <input disabled bindtap="toColor" placeholder="请添加色号" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{colorLength}}"></input>
                        <van-icon color="#5D5D5D" name="arrow" size="24rpx"></van-icon>
                    </view>
                </view>
                <view class="common-list">
                    <view class="validate">价格</view>
                    <view class="common-list-val">
                        <input bindtap="toPrice" disabled="true" placeholder="请输入价格 (色号添加好后，再填写价格)" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="" wx:if="{{!minPrice||minPrice.length==0}}"></input>
                        <input bindtap="toPrice" disabled="true" placeholder="请编辑价格" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{minPrice}}元/{{unitName}}" wx:elif="{{minPrice==maxPrice}}"></input>
                        <input bindtap="toPrice" disabled="true" placeholder="请编辑价格" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{minPrice}}~{{maxPrice||0}}元/{{unitName||0}}" wx:else></input>
                        <van-icon color="#5D5D5D" name="arrow" size="24rpx"></van-icon>
                    </view>
                </view>
            </form>
        </view>
        <view class="page-body" wx:if="{{tabDisplay==0}}">
            <view class="common-list">
                <view class="validate">中文品名<text>*</text>
                </view>
                <view class="common-list-val">
                    <input bind:blur="onBlurProductName" bind:input="getInput" data-name="cardDetailsInfo.businessProductName" maxlength="15" placeholder="请输入品名" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{cardDetailsInfo.businessProductName}}"></input>
                </view>
            </view>
            <view class="common-list">
                <view class="validate">英文品名</view>
                <input bind:input="getInput" data-name="cardDetailsInfo.englishProductName" maxlength="60" placeholder="用于打印英文标签时使用 (选填)" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{cardDetailsInfo.englishProductName}}"></input>
            </view>
        </view>
        <view class="page-body" wx:if="{{tabDisplay==0}}">
            <view class="common-list">
                <view class="validate">编号</view>
                <input bind:blur="onInputShelvesNumber" bind:input="getInput" data-name="cardDetailsInfo.spuNumber" maxlength="26" name="spuNumber" placeholder="请输入编号" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{cardDetailsInfo.spuNumber}}"></input>
            </view>
            <view class="common-list">
                <view class="validate">克重</view>
                <view class="common-list-val">
                    <input bind:input="getInput" data-name="cardDetailsInfo.gramWeight" maxlength="26" name="gramWeight" placeholder="请输入克重" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{cardDetailsInfo.gramWeight}}"></input>
                    <picker bindchange="bindPickerChange3" range="{{array3}}" value="{{index3}}">
                        <view class="p-kz">{{array3[index3]||'选择'}}</view>
                    </picker>
                </view>
            </view>
            <view class="common-list">
                <view class="validate">成分</view>
                <view class="common-list-val">
                    <input disabled bindtap="toIngredient" maxlength="26" name="spuNumber" placeholder="请输入成分" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{cardDetailsInfo.materialNew}}"></input>
                    <van-icon color="#5D5D5D" name="arrow" size="24rpx"></van-icon>
                </view>
            </view>
            <view class="common-list">
                <view class="validate">门幅</view>
                <view class="common-list-val">
                    <input bind:input="getInput" data-name="cardDetailsInfo.clothWidth" maxlength="26" placeholder="请输入门幅" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{cardDetailsInfo.clothWidth}}"></input>
                    <picker bindchange="bindPickerChange4" range="{{array4}}" value="{{index4}}">
                        <view class="p-kz">{{array4[index4]||'选择'}}</view>
                    </picker>
                </view>
            </view>
            <view class="common-list">
                <view class="validate">缩水率</view>
                <input bind:blur="onInputShelvesNumber" bind:input="getInput" data-name="cardDetailsInfo.shrinkage" maxlength="6" placeholder="请输入缩水率" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{cardDetailsInfo.shrinkage}}"></input>
            </view>
            <view class="common-list">
                <view bindtap="toType" class="attribute-add">
                    <van-icon color="#FB562C" name="add-o" size="30rpx"></van-icon>添加其他属性</view>
            </view>
            <view class="commodity-list" wx:if="{{commodityType.meterLength}}">
                <text class="validate-no">米长</text>
                <input bindblur="commodityType_input" class="weui-input" data-name="meterLength" name="meterLength" placeholder="请输入" value="{{commodityType.meterLength}}"></input>
            </view>
            <view class="commodity-list" wx:if="{{commodityType.clothEnough}}">
                <text class="validate-no">空差</text>
                <input bindblur="commodityType_input" class="weui-input" data-name="clothEnough" name="clothEnough" placeholder="请输入" value="{{commodityType.clothEnough}}"></input>
            </view>
            <view class="commodity-list" wx:if="{{commodityType.density1}}">
                <text class="validate-no">密度:</text>
                <input bindblur="commodityType_input" class="weui-input" data-name="density1" name="density1" placeholder="请输入" value="{{commodityType.density1}}"></input>
            </view>
            <view class="commodity-list" wx:if="{{commodityType.yarnCountFront}}">
                <text class="validate-no">纱支</text>
                <input bindblur="commodityType_input" class="weui-input" data-name="yarnCountFront" name="yarnCountFront" placeholder="请输入" value="{{commodityType.yarnCountFront}}"></input>
            </view>
            <view class="commodity-list" wx:if="{{commodityType.wrapWeftName}}">
                <text class="validate-no">经纬编</text>
                <picker bindchange="bindPickerChange5" class="spacing-picker" range="{{array5}}" value="{{index5}}">
                    <view>{{array5[index5]||'选择'}}</view>
                </picker>
            </view>
            <view class="commodity-list" wx:if="{{commodityType.qualityStandardName}}">
                <text class="validate-no">品质标准</text>
                <picker bindchange="bindPickerChange2" class="spacing-picker" range="{{array2}}" value="{{index2}}">
                    <view>{{array2[index2]||'选择'}}</view>
                </picker>
            </view>
        </view>
        <view class="page-body" wx:if="{{tabDisplay==0}}">
            <view class="common-list">
                <view class="validate">选择分类</view>
                <view class="common-list-val">
                    <input bindtap="moveto" data-status="{{showClassification}}" disabled="true" name="businessProductName" placeholder="请选择分类" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{checkList}}"></input>
                    <van-icon color="#5D5D5D" name="arrow" size="24rpx"></van-icon>
                </view>
            </view>
            <view class="common-list">
                <view class="validate">备注</view>
                <view class="common-list-val">
                    <input bindinput="inputgetName" data-name="cardDetailsInfo.remark" placeholder="请填写备注信息，如：8号色花灰剪版加2元" placeholderStyle="color: #C0C0C0; font-size: 26rpx;" value="{{cardDetailsInfo.remark}}"></input>
                </view>
            </view>
        </view>
        <block wx:if="{{showClassification==0}}">
            <view class="edit-btn" wx:if="{{typeFrom=='1'}}">
                <view class="fixed-bottom-tools" wx:if="{{userAuthList['goods:delete']}}">
                    <button bindtap="deleteShop" class="del">删除</button>
                    <button class="save" formType="submit" id="1">保存</button>
                </view>
                <view class="fixed-bottom-tools" wx:else>
                    <button class="g_bottomBtn" formType="submit">保存并出售</button>
                </view>
            </view>
            <view class="fixed-bottom-tools" wx:if="{{typeFrom=='0'}}">
                <button class="g_bottomBtn" formType="submit">保存并出售</button>
            </view>
        </block>
    </form>
    <view class="btSpace"></view>
</view>
<van-popup :close-on-click-overlay="true" class="tip-dialog" show="{{showPop}}" zIndex="10000">
    <text class="popTitle">提示</text>
    <view class="popContent">新增色号还未填写价格，确定直接保存吗？</view>
    <view class="popBtn">
        <button catch:tap="dataConfirm" class="popBtn" size="small">确定</button>
        <button catch:tap="dataAddPrice" class="popBtn" size="small">去填写</button>
    </view>
</van-popup>
