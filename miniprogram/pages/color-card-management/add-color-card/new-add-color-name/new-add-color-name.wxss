page {
  background-color: #eff0f7;
  padding-top: 140rpx;
}
.log-list {
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
}
.log-item {
  margin: 10rpx;
}
.list-group .title {
  font-size: 12px;
  height: 60rpx;
  line-height: 60rpx;
  margin-left: 36rpx;
  margin-top: 30rpx;
}
.title text {
  color: red;
}
.list-group-item {
  -webkit-box-align: center;
  align-items: center;
  display: -webkit-flex;
  display: flex;
  padding: 40rpx 0 0 60rpx;
}
.list-group-item:last-child {
  padding-bottom: 60rpx;
}
.list-group-item .icon {
  border-radius: 50%;
  height: 100rpx;
  width: 100rpx;
}
::-webkit-scrollbar {
  color: transparent;
  height: 0;
  width: 0;
}
.list-shortcut {
  border-radius: 10px;
  font-family: Helvetica;
  padding: 2px 0;
  position: fixed;
  right: 0;
  text-align: center;
  top: 50%;
  transform: translateY(-50%);
  width: 32px;
  z-index: 30;
}
.list-shortcut text {
  color: #0b0b0b;
  display: block;
  font-size: 22rpx;
  line-height: 1;
  padding: 4px;
}
.current {
  color: #fb562c !important;
}
.list-fixed {
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
}
.fixed-title {
  background: #f5f6fa;
  font-size: 12px;
  height: 60rpx;
  line-height: 60rpx;
  padding-left: 40rpx;
}
.container {
  padding: 0;
}
.order-item {
  font-size: 26rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding-left: 4%;
  position: relative;
  width: 96%;
}
.order-item,
.remove {
  display: -webkit-flex;
  display: flex;
}
.remove {
  align-items: center;
  background-color: red;
  border-radius: 32rpx;
  color: #fff;
  height: 56rpx;
  justify-content: center;
  position: absolute;
  right: -220rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 174rpx;
}
.add-btn-wrapper {
  background: #fff;
  bottom: 0rpx;
  left: 50%;
  padding-bottom: 30rpx;
  padding-top: 10rpx;
  position: fixed;
  transform: translateX(-50%);
  width: 100%;
}
.mask-modal {
  height: 100%;
  position: fixed;
  top: 0;
  width: 100%;
}
.dialog-modal-bd {
  text-align: center;
  width: 100%;
}
.dialog-modal-bd input {
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  vertical-align: middle;
}
.dialog-modal-fds {
  bottom: 30rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-left: 5%;
  position: absolute;
  width: 90%;
}
.dialog-modal-fds button {
  display: inline-block;
  height: 72rpx;
  line-height: 72rpx;
  width: 42%;
}
.totalColor {
  color: #ccc;
  font-size: 35rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
}
.color-code-input {
  background-color: #eff0f7;
  height: 120rpx;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  width: 100%;
}
.color-code-input-box {
  background-color: #fff;
  border-radius: 32rpx;
  display: -webkit-flex;
  display: flex;
  font-size: 26rpx;
  justify-content: space-between;
  margin: 36rpx;
  padding: 14rpx 28rpx;
}
.searchInput input {
  color: #333;
  font-size: 28rpx;
  height: 40rpx;
  padding: 0 36rpx;
  width: 100%;
}
.placeholder {
  color: #ccc;
}
.popBody {
  overflow-x: hidden;
  padding: 28rpx 28rpx 310rpx;
}
.popBody .headers {
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}
.popBody .headers text {
  color: #0b0b0b;
  font-size: 28rpx;
  font-weight: 700;
}
.cancel-btn {
  color: silver;
  font-size: 26rpx;
}
.confirm-btn {
  color: #fb562c;
  font-size: 26rpx;
}
.popBody .content {
  margin: 0 32rpx;
}
.popBody .content .title {
  font-size: 12px;
  height: 60rpx;
  line-height: 60rpx;
  margin-left: 0;
  margin-top: 60rpx;
}
.inputAear {
  border-bottom: 1rpx solid #f4f4f4;
  margin-bottom: 20rpx;
}
.inputAear input {
  display: inline-block;
  font-size: 14px;
  height: 80rpx;
  line-height: 80rpx;
  vertical-align: middle;
  width: 90%;
}
.btns {
  justify-content: flex-end;
}
