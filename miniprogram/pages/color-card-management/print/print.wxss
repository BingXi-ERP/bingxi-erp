page {
  background-color: #f8f8f8;
}
.print-view {
  background-color: #fff;
  padding: 60rpx 0;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 999;
}
.topstaff {
  height: 80rpx;
  left: 15%;
  position: absolute;
  top: -20rpx;
  width: 76%;
}
.leftstaff {
  height: 80%;
  left: 5%;
  position: absolute;
  width: 80rpx;
}
.print-view-card {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 1rpx 1rpx 4px 0 rgba(0, 0, 0, 0.11);
  display: -webkit-flex;
  display: flex;
  height: 260rpx;
  margin: auto;
  padding: 20rpx;
  width: 65%;
  z-index: 999;
}
.print-view-card-reverse {
  flex-direction: row-reverse;
}
.print-view-card-reverse .print-view-card-code {
  margin-left: 20rpx;
  margin-right: 0;
  padding-top: 30rpx;
}
.print-view-card-code {
  display: inline-block;
  margin-right: 20rpx;
}
.print-view-card-code image {
  height: 178rpx;
  width: 178rpx;
}
.print-view-card-code text {
  color: #70728c;
  display: block;
  font-size: 20rpx;
  text-align: center;
  width: 175rpx;
}
.print-view-card-name {
  flex: 1;
  overflow: hidden;
  width: 0;
}
.print-view-card-name text {
  color: #000;
  display: block;
  font-size: 24rpx;
  line-height: 42rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.print-view-card-name text.hide {
  display: none;
}
.print-view-card-name text.show {
  display: block;
}
.print-view-card-name .g_limtRowThree,
.print-view-card-name .g_limtRowTwo {
  word-wrap: break-word;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal !important;
  word-break: break-all;
}
.print-view-card-name .g_limtRowTwo {
  -webkit-line-clamp: 2;
}
.print-view-card-name .g_limtRowThree {
  -webkit-line-clamp: 3;
}
.print-list {
  background-color: #fff;
  margin-top: 20rpx;
}
.print-list1 {
  margin-top: 420rpx;
}
.print-list2 {
  margin-bottom: 110rpx;
}
.print-list .print-list-bd {
  border-bottom: 1rpx solid #f1f1f1;
  display: -webkit-flex;
  display: flex;
  font-size: 28rpx;
  justify-content: space-between;
  margin: auto;
  padding: 24rpx 0;
  width: 92%;
}
.print-list .print-list-bd text {
  width: 250rpx;
}
.print-list .print-list-bd text:nth-child(1) {
  color: #666;
}
.print-list-bd input {
  text-align: right;
}
.print-list-bd image {
  height: 44rpx;
  width: 44rpx;
}
.picker-select picker {
  padding-right: 25rpx;
  position: relative;
}
.picker-select picker::after {
  border-bottom: 1rpx solid #c3c8cb;
  border-right: 1rpx solid #c3c8cb;
  color: #c3c8cb;
  content: "";
  display: block;
  height: 14rpx;
  position: absolute;
  right: 0;
  top: 25%;
  transform: rotate(45deg);
  width: 14rpx;
}
.color-tips {
  color: #c7c8d8;
  font-size: 24rpx;
  width: 55%;
}
.lang-btn {
  background: #edeff6;
  border: 1rpx solid #edeff6;
  border-radius: 28rpx;
  display: inline-block;
  font-size: 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  min-width: 114rpx;
}
.lang-btn.ml {
  margin-left: 24rpx;
}
.lang-btn.active {
  background: #edf3fc;
  border: 1rpx solid #82a5ff;
  color: #4c7cf9;
}
.qrCode-wrap {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
}
.qr-text {
  color: #666;
  font-size: 26rpx;
}
.code-wrap {
  height: 100px;
  margin: 16px;
}
.code-text {
  color: #969799;
  font-size: 26rpx;
  margin: 5px 0;
}
.page-body {
  background-color: #fff;
  margin-bottom: 10px;
}
.page-body.textarea-page-section {
  padding-bottom: 160rpx;
}
.page-section {
  padding: 0 40rpx;
}
.page-form-title {
  color: #292929;
  font-size: 28rpx;
  line-height: 44px;
  padding-left: 36rpx;
  text-align: left;
}
.page-body .textarea-wrp {
  background: #f5f5f9;
  border: 1rpx solid #f1f1f1;
  border-radius: 8rpx;
}
.page-body .input-red,
.page-body .textarea-wrp {
  height: 240rpx;
  padding: 20rpx;
  position: relative;
  width: 640rpx;
  z-index: 0;
}
.page-body .input-red {
  background: #fff3f3;
  border: 1rpx solid #f76476;
  border-radius: 8rpx;
  color: #f76476;
  font-size: 24rpx;
}
.textarea-wrp .explain-input {
  border: none;
  font-size: 24rpx;
  height: auto;
  max-height: 240rpx;
  position: relative;
}
.input-red .explain-input {
  color: #f76476;
  position: relative;
}
.num-limit {
  color: #999;
}
.num-limit,
.num-limit-red {
  bottom: 40rpx;
  font-size: 24rpx;
  position: absolute;
  right: 40rpx;
}
.num-limit-red {
  color: #f76476;
}
.loading {
  font-size: 24rpx;
  margin-top: 100rpx;
  text-align: center;
}
.bottom {
  height: 100rpx;
  line-height: 100rpx;
  width: 100%;
}
.print-btn {
  background-color: #fff;
  bottom: 60rpx;
  left: 0;
  padding: 20rpx 0;
  position: fixed;
  width: 100%;
  z-index: 999;
}
.print-btn button {
  background-color: #e4eeff;
  border-radius: 50rpx;
  width: 690rpx;
}
.fd-btn {
  bottom: 0;
  position: fixed;
}
.fd-btn button {
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 10rpx;
  width: 45%;
}
.wrap {
  background: #fff;
  border-radius: 14px;
  margin: 8px;
}
.single {
  height: 50px;
  line-height: 50px;
}
.cancel,
.single {
  color: #007aff;
  font-size: 14px;
  text-align: center;
}
.cancel {
  background: #fff;
  border-radius: 0 14px 14px 0;
  border-top: 8px solid #f7f8fa;
  height: 56px;
  line-height: 56px;
  margin-bottom: 15px;
}
