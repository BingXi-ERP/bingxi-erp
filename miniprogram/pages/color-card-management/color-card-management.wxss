page {
  background-color: #eff0f7;
}
.wrapper {
  height: 100%;
  position: absolute;
  width: 100%;
}
.filter-wrapper {
  background-color: #fff;
  position: fixed;
  top: -1px;
  width: 100%;
  z-index: 20;
}
.headerBtns {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  position: absolute;
  right: 56rpx;
  top: 12%;
}
.pringRecode {
  margin-right: 48rpx;
}
.pringRecode image,
.searchBtn image {
  display: block;
  height: 48rpx;
  width: 48rpx;
}
.showTips {
  left: -250rpx;
  position: absolute;
  top: 50rpx;
}
.showTips image {
  display: block;
  height: 84rpx;
  width: 348rpx;
}
.color-card-list-wrapper {
  margin-top: 24rpx;
  padding-bottom: 160rpx;
  padding-top: 170rpx;
}
.color-data-list {
  background-color: #fff;
  margin-bottom: 128rpx;
  width: 100%;
}
.no-color-card-list {
  align-items: center;
  color: #70728c;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  font-size: 28rpx;
  justify-content: center;
  margin-top: 250rpx;
}
.no-color-card-list .no-list-bg {
  height: 300rpx;
  margin-bottom: 60rpx;
  width: 300rpx;
}
.no-color-card-list .text {
  color: #70728c;
  font-size: 28rpx;
  font-weight: 400;
}
.gray {
  color: #cfcfcf;
}
.bottom {
  height: 160rpx;
  width: 100%;
}
.footer-wrapper {
  background-color: #fff;
  bottom: 0;
  box-shadow: 0-2rpx 16rpx 0 rgba(0, 0, 0, 0.05);
  height: 100rpx;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  position: fixed;
  right: 0;
  z-index: 10;
}
.footer-wrapper .item {
  align-items: center;
  color: #373c55;
  display: -webkit-flex;
  display: flex;
  flex: 1;
  flex-direction: column;
  font-size: 24rpx;
  font-weight: 400;
  justify-content: center;
  transition: all 0.3s;
}
.footer-wrapper .item:active {
  opacity: 0.7;
}
.footer-wrapper .item1 {
  border-left: 1rpx solid #edeff6;
  border-right: 1rpx solid #edeff6;
}
.footer-wrapper .item .footer-icon {
  height: 40rpx;
  margin-bottom: 8rpx;
  width: 40rpx;
}
.canvas-popup-wrapper {
  background-color: transparent !important;
}
.share-monents-notice-wrapper {
  color: #fff;
  font-size: 26rpx;
  padding-top: 32rpx;
  text-align: center;
}
.btn_panel {
  justify-content: space-around;
  padding: 0 32rpx;
}
.btn_panel,
.btn_panel .c_btn {
  display: -webkit-flex;
  display: flex;
}
.btn_panel .c_btn {
  align-items: center;
  background-color: #fff;
  border-radius: 100rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  color: #4177f5;
  font-size: 28rpx;
  font-weight: 500;
  justify-content: center;
  margin: 20rpx 0;
  padding: 20rpx 40rpx;
  transition: all 0.3s;
}
.btn_panel .c_btn:active {
  opacity: 0.8;
  transform: scale(0.95);
}
.btn_panel .c_btn image {
  height: 32rpx;
  margin-right: 12rpx;
  width: 32rpx;
}
.tips {
  color: hsla(0, 0%, 100%, 0.9);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.6;
  margin: 16rpx auto;
  width: 350rpx;
}
.hideCanvas {
  display: none;
  height: 0;
  overflow: hidden;
  width: 0;
}
.showBigCanvas {
  left: -2500rpx;
  opacity: 0;
  position: absolute;
  top: -2500rpx;
}
.hideBigCanvas {
  display: none;
}
.info-info .name {
  height: 83rpx;
  overflow: hidden !important;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.flex {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.bg-white {
  background-color: #fff;
}
.font-blue2 {
  color: #4177f5;
  font-weight: 500;
}
