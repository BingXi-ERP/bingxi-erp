page {
  background-color: #f8f8f8;
}
.swiper-item {
  height: 480rpx;
  width: 750rpx;
}
.info-wrapper {
  padding: 30rpx 40rpx;
  position: relative;
}
.info-wrapper,
.info-wrapper .name {
  margin-bottom: 20rpx;
}
.info-wrapper .price {
  color: #f8464b;
  margin-bottom: 20rpx;
}
.info-wrapper .marginB0 {
  margin-bottom: 0;
}
.info-wrapper .count {
  color: #666;
}
.info-wrapper .share-wrapper {
  align-items: center;
  border: 1rpx solid #ddd;
  border-radius: 50rpx 0 0 50rpx;
  border-right: none;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  padding: 5rpx 10rpx;
  position: absolute;
  right: 0;
  top: 50rpx;
}
.info-wrapper .share-icon {
  height: 36rpx;
  margin-right: 10rpx;
  width: 36rpx;
}
.info-wrapper .text {
  font-size: 36rpx;
}
.detail-wrapper {
  margin-bottom: 20rpx;
  padding: 30rpx 40rpx 20rpx;
}
.detail-area .block {
  border-bottom: 1rpx solid #ddd;
  height: 100%;
  overflow: hidden;
  padding: 30rpx 0;
}
.block .subtitle {
  float: left;
}
.block .text {
  float: right;
}
.open-shop {
  background: linear-gradient(180deg, transparent, #fafafa);
  color: #999;
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
  line-height: 1.6;
  padding: 40rpx 0 50rpx;
  text-align: center;
  width: 100%;
}
.open-shop image {
  height: 20rpx;
  opacity: 0.6;
  vertical-align: middle;
  width: 20rpx;
}
.canvas-popup-wrapper {
  background-color: transparent !important;
}
.share-monents-notice-wrapper {
  color: #000;
  font-size: 26rpx;
  margin-top: 20rpx;
  text-align: center;
}
.save-share-btn {
  background-color: #2f7bfd;
  border-radius: 10rpx;
  color: #fff;
  height: 68rpx;
  line-height: 68rpx;
  margin: 20rpx 0;
  text-align: center;
  width: 250px;
}
.hideCanvas {
  display: none;
  height: 0;
  overflow: hidden;
  width: 0;
}
.showBigCanvas {
  left: -1500rpx;
  opacity: 0;
  position: absolute;
  top: -2700rpx;
}
.hideBigCanvas {
  display: none;
}
.productThumbs {
  border-top: 1rpx solid #ddd;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 30rpx;
}
.colorCardContainer {
  display: -webkit-flex;
  display: flex;
  overflow: hidden;
  position: relative;
  width: 420rpx;
}
.colorCard {
  height: 120rpx;
  margin-right: 30rpx;
  width: 120rpx;
}
.colorCardP {
  color: #333;
  font-size: 26rpx;
  line-height: 120rpx;
}
.colorCardMask {
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 40rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  top: 0;
  width: 120rpx;
}
.colorCardMask,
.icon {
  position: absolute;
  right: 0;
}
.icon {
  height: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
}
.attributeContain {
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
}
.attribute {
  font-size: 28rpx;
  font-weight: 600;
  min-width: 110rpx;
}
.center {
  height: 24rpx;
  position: relative;
  top: -8rpx;
  width: 24rpx;
}
.attribute-item {
  display: -webkit-flex;
  display: flex;
  justify-content: space-around;
}
.attributeDetail {
  color: #999;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.popup-box {
  color: #333;
}
.popup-box-title {
  border-bottom: 1rpx solid #e5e5e5;
  font-size: 32rpx;
  height: 104rpx;
  line-height: 104rpx;
  margin: 0 30rpx;
  text-align: center;
}
.popup-box-content {
  color: #999;
  min-height: 420rpx;
  padding: 30rpx;
}
.popup-box-content .h2 {
  color: #ff3e00;
  margin-bottom: 18rpx;
}
.popup-box-content .h2 image {
  height: 44rpx;
  margin-right: 18rpx;
  vertical-align: middle;
  width: 36rpx;
}
.popup-box-actions {
  padding: 30rpx;
}
.popup-box-actions button {
  background: #e4eeff;
  border: 1rpx solid #629cff;
  border-radius: 2rpx;
  color: #2f7bfd;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
}
.product-property {
  height: 820rpx;
}
.product-property .divider-solid {
  margin: 15rpx 0;
}
.product-property .cell {
  padding: 15rpx 0;
}
.color_value_item {
  align-items: center;
  background: #fff;
  border: 1px solid #e4e4e4;
  border-radius: 8rpx;
  display: -webkit-flex;
  display: flex;
  height: 56rpx;
  justify-content: center;
  width: 56rpx;
}
.color_value_item image {
  height: 36rpx;
  vertical-align: middle;
  width: 36rpx;
}
.color-title {
  color: #000;
  display: inline;
  font-size: 28rpx;
}
.cell-value {
  color: #171717;
  font-size: 28rpx;
  padding-right: 15rpx;
}
.ingredientItem {
  max-width: 400rpx;
  word-break: break-all;
}
.product-spec {
  align-items: center;
  background: #fafafa;
  border: 1rpx solid #ddd;
  display: -webkit-flex;
  display: flex;
  height: 154rpx;
  margin-bottom: 20rpx;
  margin-top: 20rpx;
}
.product-spec-title {
  position: relative;
  width: 140rpx;
}
.product-spec-title::after {
  background: #e9e9e9;
  border-radius: 1rpx;
  content: "";
  display: block;
  height: 82rpx;
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
}
.product-spec-title > image {
  display: block;
  height: 46rpx;
  margin: 0 auto;
  width: 46rpx;
}
.product-spec-title > text {
  display: block;
  font-size: 20rpx;
  margin-top: 12rpx;
  text-align: center;
}
.product-spec-content {
  flex: 1;
  padding: 32rpx;
  position: relative;
}
.product-spec-content .arrow {
  margin-top: -5rpx;
  position: absolute;
  right: 30rpx;
  top: 50%;
}
.n {
  font-size: 28rpx;
}
.closeMask {
  height: 40rpx;
  width: 40rpx;
}
.choose-attr-head {
  background: #fafafa;
  box-sizing: border-box;
  height: 158rpx;
  padding: 30rpx;
  position: relative;
}
.choose-attr-head image {
  height: 46rpx;
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  width: 46rpx;
}
.choose-attr-subtitle {
  color: #949494;
  margin-bottom: 5rpx;
}
.choose-attr-title {
  font-size: 32rpx;
}
.choose-attr-title .price {
  color: #ff3e00;
  margin-left: 10rpx;
}
.choose-attr-footer {
  background: #fafafa;
  display: -webkit-flex;
  display: flex;
  height: 98rpx;
}
.choose-attr-footer-left {
  flex: 1;
  padding: 10rpx 30rpx;
}
.choose-attr-footer-left .amount {
  color: #999;
  font-size: 24rpx;
  margin-bottom: -5rpx;
}
.choose-attr-footer-left .total {
  color: #ff3e00;
  font-size: 24rpx;
  font-weight: 600;
}
.choose-attr-footer-left .total .money {
  font-size: 32rpx;
  margin-left: 10rpx;
}
.choose-attr-footer-right {
  font-size: 0;
}
.choose-attr-footer .button-normal,
.choose-attr-footer .button-primary {
  background: #ffeae3;
  border-radius: 0;
  color: #ff3e00;
  display: inline-block;
  font-size: 32rpx;
  font-weight: 600;
  height: 98rpx;
  line-height: 98rpx;
  padding: 0;
  width: 200rpx;
}
.choose-attr-footer .button-primary {
  background: #ff6533;
  color: #fff;
}
.choose-attr-body {
  box-sizing: border-box;
  height: 670rpx;
  padding: 0 30rpx;
}
.choose-attr-body .cell {
  align-items: center;
  border-color: #e5e5e5;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  padding-left: 0;
  padding-right: 0;
}
.choose-attr-body .cell-value {
  padding-right: 15rpx;
}
.Authentication {
  height: 34rpx;
  margin-right: 6rpx;
  width: 30rpx;
}
.AuthenticationCon {
  align-items: center;
  width: 500rpx;
}
.AuthenticationCon,
.service-item {
  display: -webkit-flex;
  display: flex;
}
.service-item {
  justify-content: space-around;
}
.colorCardImg {
  margin-bottom: 10rpx;
  margin-left: 40rpx;
  margin-right: 40rpx;
  width: 670rpx;
}
.maxWidth {
  max-width: 580rpx;
}
