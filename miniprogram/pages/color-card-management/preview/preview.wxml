<page-meta pageStyle="{{popupInit.canvas.show?'overflow: hidden;':''}}"></page-meta>
<view class="preview-wrapper">
    <swiper autoplay="{{swiper.autoplay}}" duration="{{swiper.duration}}" indicatorDots="{{swiper.indicatorDots}}" interval="{{swiper.interval}}" style="height:480rpx">
        <swiper-item wx:for="{{detailTypeImage[0].images}}" wx:key="index">
            <view bindtap="previewImg" class="swiper-item bg-img" data-detailType="1" data-url="{{item.storagePath}}" style="background-image:url(\"{{item.storagePath}}\")"></view>
        </swiper-item>
    </swiper>
    <view class="info-wrapper bg-white">
        <view class="name maxWidth">{{goodsInfo.businessProductName}}</view>
        <view class="price" wx:if="{{goodsInfo.price&&goodsInfo.price!='0'&&goodsInfo.price!='0.0'}}">￥<text class="f24">{{goodsInfo.price}}</text>
        </view>
        <view class="price" wx:else>面议</view>
        <view bindtap="shareM" class="share-wrapper" wx:if="{{isShowShare}}">
            <view class="bg-img share-icon" style="background-image:url(\"{{icon.share}}\")"></view>
            <view class="text">分享</view>
        </view>
    </view>
    <view class="detail-wrapper bg-white">
        <view class="attributeContain">
            <view class="attribute">属性</view>
            <view bindtap="attributeDetail" class="attribute-item">
                <view class="attributeDetail maxWidth g_limtRowTwo">品名：{{goodsInfo.businessProductName}} 编号：{{goodsInfo.spuNumber||'-'}} 成分：{{goodsInfo.materialNew||'-'}} ...</view>
                <view>
                    <image class="center" src="{{icon.rightArrow}}"></image>
                </view>
            </view>
        </view>
        <view bindtap="handleShowPopup" class="product-spec" data-key="showChooseAttr">
            <view class="product-spec-title">
                <image mode="scaleToFill" src="../../../assets/images/icon2nd/symbols-color-l.png"></image>
                <text class="n">规格选择</text>
            </view>
            <view class="product-spec-content">
                <text class="n">共计{{goodsInfo.colorList.length}}个颜色，请选择</text>
                <text class="arrow arrow-bottom"></text>
            </view>
        </view>
    </view>
    <view class="detail-wrapper bg-white">
        <view class="attributeContain">
            <view class="attribute">服务</view>
            <view bindtap="serviceDetail" class="service-item">
                <view class="AuthenticationCon">
                    <image class="Authentication" src="{{icon.baozhuang}}"></image>
                    <text style="font-size:28rpx;">实体保障</text>
                </view>
                <view>
                    <image class="center" src="{{icon.rightArrow}}"></image>
                </view>
            </view>
        </view>
    </view>
    <view class="detail-wrapper bg-white" wx:if="{{searchId}}">
        <view class="attributeContain">
            <view class="attribute">供应商信息</view>
            <view bindtap="supplierDetail" class="AuthenticationCon"></view>
            <view>
                <image class="center" src="{{icon.rightArrow}}"></image>
            </view>
        </view>
    </view>
    <view class="panel">
        <view class="cell panel-cell">
            <view class="cell-title" style="min-width:100rpx;">其他</view>
            <view class="cell-value">
                <text class="n">{{goodsInfo.remark||'-'}}</text>
            </view>
        </view>
    </view>
    <view class="panel" style="padding-top:10rpx;">
        <view wx:if="{{item.type!==1}}" wx:for="{{detailTypeImage}}" wx:key="type">
            <van-divider contentPosition="center">{{item.title}}</van-divider>
            <image bindtap="previewImg" class="colorCardImg" data-detailType="{{item.type}}" data-url="{{node.storagePath}}" mode="widthFix" src="{{node.storagePath}}" wx:for="{{item.images}}" wx:for-item="node" wx:key="index"></image>
        </view>
    </view>
    <view class="open-shop f12">店铺由秉羲工作台提供技术支持</view>
</view>
<van-popup bind:close="closePopup" customClass="canvas-popup-wrapper" lockScroll="{{true}}" show="{{popupInit.canvas.show}}">
    <view class="{{popupInit.canvas.show?'showBigCanvas':'hideBigCanvas'}}">
        <canvas canvasId="{{popupInit.canvas.canvasId.photoCanvas}}" height="1350" style="width:500px;height:900px" width="750"></canvas>
    </view>
    <view class="canvas-wrapper {{popupInit.canvas.show?'':'hideCanvas'}}">
        <canvas canvasId="{{popupInit.canvas.canvasId.shareCanvas}}" height="900" style="width:250px;height:450px" width="500"></canvas>
    </view>
    <view class="share-monents-notice-wrapper">
        <view catchtap="saveCanvas" class="save-share-btn">保存图片</view>
        <view>保存图片后分享到朋友圈</view>
        <view>会有更多的人来您的店铺哦~</view>
    </view>
</van-popup>
<van-popup bind:close="handleClosePopup" data-key="showPropoty" position="bottom" show="{{showPropoty}}">
    <view catchtouchmove="preventTouchMove" class="popup-box">
        <view class="popup-box-title">产品属性</view>
        <view class="popup-box-content">
            <scroll-view scrollY class="product-property">
                <view class="cell cell-border-no">
                    <view class="cell-title">品名</view>
                    <view class="cell-value maxWidth">{{goodsInfo.businessProductName||'-'}}</view>
                </view>
                <view class="cell cell-border-no">
                    <view class="cell-title">编号</view>
                    <view class="cell-value">{{goodsInfo.spuNumber||'-'}}</view>
                </view>
                <view class="divider-solid"></view>
                <view class="cell cell-border-no">
                    <view class="cell-title">成分及含量</view>
                    <view class="cell-value ingredientItem">{{goodsInfo.materialNew||'-'}}</view>
                </view>
                <view class="cell cell-border-no">
                    <view class="cell-title">幅宽</view>
                    <view class="cell-value" wx:if="{{goodsInfo.clothWidth}}">{{goodsInfo.clothWidth}}{{goodsInfo.clothWidthUnit}}</view>
                    <view class="cell-value" wx:else>-</view>
                </view>
                <view class="cell cell-border-no">
                    <view class="cell-title">缩水率</view>
                    <view class="cell-value">{{goodsInfo.shrinkage||'-'}}</view>
                </view>
                <view class="cell cell-border-no">
                    <view class="cell-title">克重</view>
                    <view class="cell-value" wx:if="{{goodsInfo.gramWeight}}">{{goodsInfo.gramWeight}}{{goodsInfo.weightUnit}}</view>
                    <view class="cell-value" wx:else>-</view>
                </view>
                <view class="divider-solid"></view>
                <view class="cell cell-border-no">
                    <view class="cell-title">米长</view>
                    <view class="cell-value">{{goodsInfo.meterLength||'-'}}</view>
                </view>
                <view class="cell cell-border-no">
                    <view class="cell-title">纱支</view>
                    <view class="cell-value">{{goodsInfo.yarnCountFront||'-'}}</view>
                </view>
                <view class="cell cell-border-no">
                    <view class="cell-title">密度</view>
                    <view class="cell-value">{{goodsInfo.density1==='undefined'?'-':goodsInfo.density1||'-'}}</view>
                </view>
                <view class="cell cell-border-no">
                    <view class="cell-title">空差</view>
                    <view class="cell-value">{{goodsInfo.clothEnough||'-'}}</view>
                </view>
                <view class="cell cell-border-no">
                    <view class="cell-title">经纬编</view>
                    <view class="cell-value">{{goodsInfo.wrapWeftName||'-'}}</view>
                </view>
                <view class="cell cell-border-no">
                    <view class="cell-title">国家标准</view>
                    <view class="cell-value">{{goodsInfo.qualityStandardName||'-'}}</view>
                </view>
            </scroll-view>
        </view>
        <view class="popup-box-actions">
            <button bind:tap="handleClosePopup" data-key="showPropoty">关闭</button>
        </view>
    </view>
</van-popup>
<van-popup bind:close="handleClosePopup" data-key="showChooseAttr" position="bottom" show="{{showChooseAttr}}">
    <view catchtouchmove="preventTouchMove" class="choose-attr">
        <view class="cell">
            <view class="cell-title">{{goodsInfo.businessProductName}} {{goodsInfo.spuNumber||''}}</view>
            <image bind:tap="handleClosePopup" class="closeMask" data-key="showChooseAttr" mode="scaleToFill" src="{{icon.delete}}"></image>
        </view>
        <scroll-view class="choose-attr-body" scrollY="true">
            <view class="data-empty" wx:if="{{goodsInfo.colorList.length===0}}">暂时没有规格~</view>
            <block wx:else>
                <view class="cell" wx:for="{{goodsInfo.colorList}}" wx:key="index">
                    <view class="color_value_item" style="background-color:{{item.colorValue}};">
                        <image mode="aspectFill" src="{{icon.noColorBg}}" wx:if="{{!item.colorValue}}"></image>
                    </view>
                    <view class="color-title">{{item.colorVal}} {{item.colorName}}</view>
                </view>
            </block>
        </scroll-view>
    </view>
</van-popup>
<van-popup bind:close="handleClosePopup" data-key="showOther" position="bottom" show="{{showOther}}">
    <view catchtouchmove="preventTouchMove" class="popup-box">
        <view class="popup-box-title">服务保障</view>
        <view class="popup-box-content">
            <view class="h2">
                <image mode="scaleToFill" src="{{icon.baozhuang}}"></image>
                <text class="n">企业认证</text>
            </view>
            <text class="n">带有该标识的商家为秉羲工作台认证过的商家，有线下实体店铺，真实可信。</text>
        </view>
        <view class="popup-box-actions">
            <button bind:tap="handleClosePopup" data-key="showOther">关闭</button>
        </view>
    </view>
</van-popup>
<van-dialog id="van-dialog-supplier"></van-dialog>
