#van-dialog {
  position: relative;
  z-index: 100002;
}
.steps {
  display: -webkit-flex;
  display: flex;
  font-size: 24rpx;
  padding: 45rpx;
}
.steps > view {
  display: inline-block;
  flex-basis: 33.333%;
  flex-shrink: 1;
  margin-right: 0;
  position: relative;
  text-align: center;
}
.steps .line {
  background: #fb562c;
  border-radius: 2rpx;
  height: 4rpx;
  left: 20rpx;
  position: absolute;
  top: 30rpx;
  width: 88rpx;
}
.steps .flex-r {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.steps .pointer {
  background: linear-gradient(180deg, #fb562c, #ff8b6c);
  border-radius: 100%;
  color: #fff;
  display: inline-block;
  font-size: 26rpx;
  height: 56rpx;
  line-height: 56rpx;
  position: relative;
  text-align: center;
  width: 56rpx;
  z-index: 1;
}
.steps .step-line {
  background-color: #fb562c;
  border-color: inherit;
  height: 4rpx;
  left: 50%;
  position: absolute;
  right: -50%;
  top: 13rpx;
  width: 88rpx;
}
.steps .cur-step-line {
  background: #5c84ff;
}
.steps .step-main {
  margin-top: 20rpx;
  opacity: 0.5;
}
.gray {
  background: silver !important;
}
.steps .current .step-main {
  opacity: 1;
}
.order-create {
  font-size: 28rpx;
  padding-bottom: 320rpx;
}
.place-holder {
  color: #ccc;
}
.place-holder-right {
  text-align: right;
}
.order-create .unit {
  margin-left: 10rpx;
}
.order-create .button {
  background: #f2f5ff;
  border: 2rpx solid #2f7bfd;
  border-radius: 4rpx;
  color: #2f7bfd;
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  position: relative;
}
.order-create .totle-name {
  color: #0b0b0b;
  font-size: 26rpx;
  font-weight: 400;
}
.order-create .totle-currency {
  color: #e2525a;
  font-size: 30rpx;
  font-weight: 600;
}
.order-create .totle-content {
  color: #e2525a;
  font-size: 42rpx;
  font-weight: 600;
}
.order-create .totle-content:first-child {
  font-size: 22rpx;
}
.order-create .strong {
  color: #000;
}
.order-create .post-image image {
  border-radius: 14rpx;
  height: 100%;
  width: 100%;
}
.order-create .post-image .post-btn-edit {
  align-items: center;
  background-color: rgba(0, 0, 0, 0.3);
  bottom: 0;
  color: #fff;
  display: -webkit-flex;
  display: flex;
  font-size: 20rpx;
  justify-content: center;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}
.order-create .post-image .post-btn-edit image {
  height: 37rpx;
  width: 37rpx;
}
.order-create .hl {
  color: #373c55;
  font-size: 22rpx;
  font-weight: 400;
}
.order-create .hl .price {
  color: #0b0b0b;
  font-size: 28rpx;
  font-weight: 700;
}
.order-create .hl .col {
  color: #5d5d5d;
  font-size: 22rpx;
}
.order-create .buttom-toggle {
  align-items: center;
  color: #fb562c;
  display: -webkit-flex;
  display: flex;
  font-size: 22rpx;
  margin-left: 15rpx;
}
.order-create .buttom-toggle image {
  height: 8rpx;
  margin-left: 12rpx;
  width: 14rpx;
}
.order-create .buttom-toggle .arrow {
  color: #fb562c;
  position: relative;
  top: 3rpx;
}
.order-create .button-edit {
  height: 28rpx;
  position: absolute;
  right: 60rpx;
  top: 0;
  width: 28rpx;
}
.order-create .button-del {
  height: 28rpx;
  position: absolute;
  right: 0;
  top: 0;
  width: 28rpx;
}
.order-create .flex-direction-column {
  align-items: flex-start;
  display: block;
  flex-direction: column;
  width: 100%;
}
.product-cell {
  background-color: #f9f9fb;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx;
}
.pdoduct-add-cell {
  border-top: 1rpx solid #ddd;
  padding: 30rpx;
}
.order-create .product-detail {
  background: #f6f9fd;
  box-sizing: border-box;
  flex: 1;
  margin-top: 28rpx;
  width: 100%;
}
.order-create .product-detail-title {
  color: #5d5d5d;
  display: inline-block;
  font-size: 26rpx;
  margin: 20rpx 0 30rpx;
}
.order-create .product-detail-tab .badge {
  margin-bottom: 30rpx;
  margin-right: 30rpx;
}
.order-create .divider-wapper {
  margin-left: 30rpx;
  margin-right: 30rpx;
}
.order-create .buttom-toggle-right {
  box-sizing: border-box;
  flex: 1;
  margin-top: 28rpx;
  padding-right: 30rpx;
  text-align: right;
  width: 100%;
}
.order-info .panel-title {
  border-bottom: 1rpx solid #ddd;
  padding-bottom: 38rpx;
}
.order-info-item {
  color: #666;
  font-size: 24rpx;
  padding: 15rpx 0;
}
.declaration-item {
  background: #f8f9fc;
  padding: 15rpx 0;
}
.declaration-item:not(:last-child) {
  margin-bottom: 20rpx;
}
.declaration-item .cell {
  border-bottom: none;
  padding: 15rpx 30rpx;
}
.declaration-item .cell-title {
  color: #999;
  flex: none;
  margin-right: 10rpx;
}
.declaration-item .cell-value {
  color: #333;
  flex: 1;
  position: relative;
}
.declaration-item .cell-value .extra {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}
.declaration-item .table {
  padding: 15rpx 0;
}
.declaration-item .hr-line {
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 0 30rpx;
  width: 100%;
}
.declaration-item .hr-line-inner {
  border-bottom: 1rpx solid #ddd;
  box-sizing: border-box;
  width: 100%;
}
.declaration-item .strong {
  color: #e2525a;
  margin-left: 20rpx;
}
.toolbar-button-group-right {
  background: #fff;
}
.g_gd {
  background: #fff;
  color: #fb562c;
}
.g_gd,
.g_next {
  border: 2rpx solid #ffe6df;
  border-radius: 36rpx;
  font-size: 24rpx;
  height: 64rpx;
  width: 174rpx;
}
.g_next {
  background: linear-gradient(180deg, #ff8b6c, #fb562c);
  color: #fff;
  margin-left: 28rpx;
}
.order-create .cell-remarks {
  align-items: flex-start;
}
.order-create .remarks-input {
  background: #fff;
  display: block;
  font-size: 26rpx;
  padding: 0;
  width: 480rpx;
}
.order-create .placeholder-text {
  color: #ccc;
  text-align: left;
}
.goods-add {
  color: #fb562c;
  font-size: 26rpx;
}
.goods-add text {
  margin-left: 8rpx;
}
.cost-cell .cell-title {
  flex: none;
}
.cost-cell .cell-value {
  flex: 1;
}
.cost-cell .cell-value input {
  box-sizing: border-box;
  width: 100%;
}
.form-btn {
  background: rgba(0, 155, 0, 0);
  border-radius: 0;
  height: 100%;
  left: 0;
  margin: 0;
  padding: 0;
  position: absolute;
  top: 0;
  width: 100%;
}
.table {
  background-color: #fff;
  border-radius: 14rpx;
}
.table .tr > text,
.table .tr > view {
  padding-left: 0 !important;
  padding-right: 0 !important;
  text-align: center;
}
.table .tr:nth-child(even) {
  border-bottom: 2rpx solid #f9f9fb;
}
.tr .strong {
  color: #ed5c5c;
  font-size: 14px;
  font-weight: 500;
}
.table .tr .totle {
  flex: inherit;
  text-align: inherit;
  width: 65%;
}
.table .tr .th {
  border-bottom: 2rpx solid #5d5d5d;
  color: #5d5d5d;
  font-size: 22rpx;
}
.table .tr text {
  color: #0b0b0b;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 150rpx;
}
.radio-group {
  width: 260rpx;
}
.checkBtn {
  border: 2rpx solid #e2e2e2;
  border-radius: 32rpx;
  box-sizing: border-box;
  color: #373c55;
  font-weight: 400;
  text-align: center;
}
.checkBtn,
.chooseBtn {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  font-size: 26rpx;
  height: 64rpx;
  justify-content: center;
  width: 140rpx;
}
.chooseBtn {
  background: #fff0ec;
  border: 2rpx solid #ffe6df;
  color: #fb562c;
  font-weight: 700;
}
.cellItem {
  height: 96rpx;
  padding: 0 30rpx;
}
.cellItem .title {
  color: #4c7cf9;
  padding-right: 55rpx;
  position: relative;
}
.cellItem .title image {
  height: 40rpx;
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
}
.c-panel {
  background-color: #fff;
  border-radius: 20rpx;
  box-sizing: border-box;
  margin-left: 34rpx;
  overflow: hidden;
  padding: 0 28rpx;
  width: calc(100vw - 68rpx);
}
.c-item {
  border-bottom: 2rpx solid #f4f4f4;
}
.c-item:last-child {
  border-bottom: none;
}
.c-item-title {
  color: #5d5d5d;
  font-size: 26rpx;
  padding-top: 28rpx;
  position: relative;
}
.tips {
  position: absolute;
  right: 0;
  top: 28rpx;
}
.tips text {
  color: silver;
  font-size: 22rpx;
  margin-left: 8rpx;
}
.c-item-title-sp {
  padding-bottom: 22rpx;
}
.c-item-value {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0 28rpx;
}
.w-picker,
.x-picker {
  width: 100%;
}
.x-picker {
  display: -webkit-flex;
  display: flex;
  font-size: 26rpx;
  justify-content: space-between;
}
.g_limtRow {
  color: silver;
  font-size: 26rpx;
}
.g_limtRows {
  background-color: #fff0ec;
  border: 1rpx solid #ffe6df;
  color: #fb562c;
  font-size: 26rpx;
}
.customsForm {
  background: #fff;
  padding: 0 32rpx;
}
.customsForm .title {
  color: #373c55;
  font-family: PingFangSC-Medium;
  font-size: 15px;
  font-weight: 500;
  height: 96rpx;
  line-height: 96rpx;
  position: relative;
}
.customsForm .title::after {
  border-bottom: 1rpx solid #f1f1f1;
  bottom: 0;
  content: "";
  height: 1rpx;
  left: 0;
  position: absolute;
  width: 100vw;
}
.customsForm .content {
  height: 264rpx;
}
.customsForm .image image {
  height: 200rpx;
  width: 200rpx;
}
.reAddBtn {
  background: #fff;
  border: 1rpx solid #ff5050;
  border-radius: 32rpx;
  color: #ff5050;
  margin-right: 32rpx;
  width: 128rpx;
}
.addBtn,
.reAddBtn {
  font-family: PingFangSC-Medium;
  font-size: 14px;
  font-weight: 500;
  height: 64rpx;
  line-height: 64rpx;
  margin-left: 0;
  padding-left: 0;
  padding-right: 0;
  text-align: center;
}
.addBtn {
  background: #e8f1ff;
  border-radius: 32rpx;
  color: #5c84ff;
  width: 192rpx;
}
.addBtn image {
  height: 20rpx;
  width: 20rpx;
}
.reChoose {
  color: #999bb4;
  font-family: PingFangSC-Regular;
  font-size: 12px;
  font-weight: 400;
}
.midlle {
  flex: auto;
  padding-left: 32rpx;
  position: relative;
}
.colorBtn {
  margin-top: 90rpx;
}
.midlle .colorInfo {
  width: 250rpx;
}
.delIcon {
  position: absolute;
  right: 0;
  top: 0;
}
.delIcon image {
  height: 40rpx;
  width: 40rpx;
}
.post-extra {
  margin-top: 36rpx;
}
.post-title {
  color: #0b0b0b;
  font-size: 28rpx;
  font-weight: 700;
  width: 280rpx;
}
.imgTitle {
  padding: 30rpx 30rpx 10rpx;
}
.uploadText {
  padding-bottom: 30rpx;
  padding-left: 30rpx;
}
.discountInfo {
  color: #5d5d5d;
  font-size: 22rpx;
  position: relative;
}
.discountInfo .tr {
  margin-top: 4rpx;
}
.billing.fixed-toolbar-bottom {
  align-items: center;
  border-bottom: 2rpx solid #f4f4f4;
  bottom: 120rpx;
  display: -webkit-flex;
  display: flex;
}
.billing .toolbar-left {
  width: 250rpx;
}
.time_line {
  padding: 32rpx 24rpx;
}
.time_line .time_line_item {
  display: -webkit-flex;
  display: flex;
  padding-bottom: 32rpx;
  position: relative;
}
.time_line .time_line_item .left {
  margin-right: 24rpx;
  position: relative;
}
.time_line .time_line_item .left .time_icon {
  height: 40rpx;
  position: relative;
  width: 40rpx;
  z-index: 9;
}
.time_line .time_line_item .right {
  flex: 1;
}
.time_line .time_line_item .right .h1 {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  font-size: 14px;
  font-weight: 400;
  justify-content: space-between;
}
.time_line .time_line_item .right .h1 text {
  color: #b6b6b6;
  font-size: 12px;
}
.time_line .time_line_item .right .p {
  color: #919191;
  font-size: 14px;
  margin-top: 16rpx;
  position: relative;
}
.time_line .time_line_item::before {
  background: #ebebeb;
  content: "";
  height: 100%;
  left: 18rpx;
  position: absolute;
  top: 0;
  width: 4rpx;
}
.time_line .time_line_item:last-child {
  padding-bottom: 0;
}
.time_line .time_line_item:last-child::before {
  display: none;
}
.post {
  width: 100%;
}
.post-img {
  flex-shrink: 0;
  height: 174rpx;
  margin-right: 20rpx;
  position: relative;
  width: 174rpx;
}
.order-create .post-img image {
  border-radius: 14rpx;
  height: 100%;
  width: 100%;
}
.d-text {
  padding: 120rpx;
  text-align: center;
}
