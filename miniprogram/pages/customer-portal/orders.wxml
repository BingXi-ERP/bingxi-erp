<view class="portal-page">
  <view class="portal-search">
    <input placeholder="输入订单号" value="{{keyword}}" bindinput="onKeyword" bindconfirm="search" />
    <view class="portal-search-btn" bindtap="search">查询</view>
  </view>
  <view class="portal-error" wx:if="{{error}}">{{error}}</view>
  <view class="portal-row" wx:for="{{items}}" wx:key="id">
    <view class="row-head">
      <text>{{item.order_no}}</text>
      <text class="row-status">{{item.status}}</text>
    </view>
    <view class="row-line">下单日期：{{item.order_date}}</view>
    <view class="row-line" wx:if="{{item.batch_no}}">批次：{{item.batch_no}}</view>
    <view class="row-line" wx:if="{{item.color_no}}">色号：{{item.color_no}}</view>
    <view class="row-line" wx:if="{{item.dye_lot_no}}">缸号：{{item.dye_lot_no}}</view>
    <view class="row-line">订单金额：{{item.total_amount}}　未收金额：{{item.balance_amount}}</view>
  </view>
  <view class="portal-empty" wx:if="{{!loading && items.length === 0 && !error}}">暂无订单</view>
  <view class="portal-empty" wx:if="{{loading}}">正在加载</view>
</view>
