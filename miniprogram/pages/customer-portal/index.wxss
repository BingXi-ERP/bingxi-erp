.portal-page {
  background: #f5f6fa;
  min-height: 100vh;
  padding: 24rpx;
}
.portal-title {
  font-size: 36rpx;
  font-weight: 600;
  padding: 16rpx 0 24rpx;
}
.portal-card {
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  margin-bottom: 24rpx;
  padding: 24rpx 0;
}
.metric {
  flex: 1;
  text-align: center;
}
.metric-label {
  color: #888;
  font-size: 24rpx;
}
.metric-value {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 12rpx;
}
.portal-entry {
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  font-size: 30rpx;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 28rpx;
}
.portal-arrow {
  color: #999;
}
.portal-error,
.portal-empty {
  color: #999;
  font-size: 26rpx;
  padding: 32rpx 0;
  text-align: center;
}
