.portal-page {
  background: #f5f6fa;
  min-height: 100vh;
  padding: 24rpx;
}
.portal-search {
  align-items: center;
  display: flex;
  margin-bottom: 24rpx;
}
.portal-search input {
  background: #fff;
  border-radius: 12rpx;
  flex: 1;
  font-size: 26rpx;
  height: 64rpx;
  padding: 0 20rpx;
}
.portal-search-btn {
  background: #fb562c;
  border-radius: 12rpx;
  color: #fff;
  font-size: 26rpx;
  margin-left: 16rpx;
  padding: 16rpx 24rpx;
}
.portal-row {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
}
.row-head {
  display: flex;
  font-size: 30rpx;
  font-weight: 600;
  justify-content: space-between;
}
.row-status {
  color: #fb562c;
  font-size: 24rpx;
}
.row-line {
  color: #666;
  font-size: 24rpx;
  line-height: 1.7;
  margin-top: 8rpx;
}
.portal-error,
.portal-empty {
  color: #999;
  font-size: 26rpx;
  padding: 32rpx 0;
  text-align: center;
}
