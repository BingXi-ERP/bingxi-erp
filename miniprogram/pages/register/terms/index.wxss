.terms-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background: #f7f8fa;
  color: #202124;
}

.terms-header {
  padding: 24rpx 8rpx 32rpx;
}

.terms-title {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}

.terms-updated {
  display: block;
  margin-top: 16rpx;
  color: #70757a;
  font-size: 24rpx;
  text-align: center;
}

.terms-content {
  padding: 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.terms-paragraph {
  display: block;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  line-height: 1.85;
  word-break: break-word;
  white-space: pre-wrap;
}

.terms-section {
  margin-top: 16rpx;
  color: #202124;
  font-size: 30rpx;
  font-weight: 600;
}
