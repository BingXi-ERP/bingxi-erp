page {
  background-color: #f5f6fa;
}
.marginTop32 {
  margin-top: 32rpx;
}
.fabricGuide .title {
  color: #7579a0;
  font-size: 24rpx;
  font-weight: 400;
  padding: 0 48rpx;
  text-align: justify;
  word-break: break-all;
}
.fabricGuide .btn {
  background: linear-gradient(90deg, #7ab5ff, #336af8);
  border-radius: 48rpx;
  box-shadow: 0 6px 12px -2px rgba(120, 169, 255, 0.5);
  color: #fff;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  width: 686rpx;
}
.fabricGuide .btn,
.logout {
  font-weight: 500;
  text-align: center;
}
.logout {
  color: #4c7cf9;
  font-size: 28rpx;
  height: 100rpx;
  line-height: 100rpx;
  width: 100%;
}
.img {
  text-align: center;
}
.img image {
  height: 820rpx;
  width: 750rpx;
}
