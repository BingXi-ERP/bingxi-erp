page {
  background-color: #eff0f7;
}
.infoPage {
  background-color: #fff;
  border-radius: 20rpx;
  margin-left: 34rpx;
  margin-top: 40rpx;
  padding: 104rpx 0;
  width: calc(100vw - 68rpx);
}
.succssImg {
  height: 104rpx;
  margin-bottom: 36rpx;
  width: 104rpx;
}
.succssContent,
.textCenter {
  text-align: center;
}
.succssTips {
  color: #0b0b0b;
  font-family: PingFangSC-Regular;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 44rpx;
  margin: 0 auto;
}
.authentication {
  margin-bottom: 40rpx;
  margin-left: 110rpx;
  margin-top: 90rpx;
}
.code {
  color: #373c55;
  font-family: PingFangSC-Semibold;
  font-size: 18px;
  font-weight: 500;
}
.codeContent {
  border-bottom: 1rpx solid #ddd;
  height: 80rpx;
  width: 535rpx;
}
.infoFont {
  display: inline-block;
  font-size: 48rpx;
  font-weight: 500;
  height: 1.5rem;
  width: 90%;
}
.codeTip {
  color: #999;
  font-size: 24rpx;
  margin-bottom: 100rpx;
  width: 578rpx;
}
.writeInfo {
  margin-bottom: 150rpx;
  margin-top: 50rpx;
}
.bottomInfo {
  bottom: 100rpx;
  left: 50%;
  position: absolute;
  text-align: center;
  transform: translateX(-50%);
}
.codeBu {
  color: #4e8ffe;
  font-size: 24rpx;
  line-height: 44rpx;
  margin-left: 44rpx;
}
.g_LineatBtn {
  margin: 0 auto;
  width: 550rpx;
}
.clear-img {
  height: 48rpx;
  margin-bottom: 20rpx;
  vertical-align: middle;
  width: 48rpx;
}
.tip-dialog {
  height: 100%;
  width: 80%;
}
.tip-dialog .van-popup {
  border-radius: 16rpx;
  color: #64689e;
  font-size: 28rpx;
  overflow-x: hidden;
  padding: 64rpx 0 0;
  top: 28%;
  width: 640rpx;
}
.popTitle {
  color: #373c55;
  display: inline-block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  padding-left: 46rpx;
  width: 100%;
}
.popContent {
  padding: 0 46rpx 46rpx;
}
.popBtn {
  overflow: hidden;
  padding-bottom: 48rpx;
}
.popBtn button {
  background: linear-gradient(90deg, #7ab5ff, #336af8);
  border-radius: 48rpx;
  box-shadow: 0 6px 12px -2px rgba(120, 169, 255, 0.5);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  width: 360rpx;
}
