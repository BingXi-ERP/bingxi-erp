<view class="wrapper">
  <view class="registered-content">
    <view class="user-img userinfo-avatar">
      <open-data type="userAvatarUrl"></open-data>
    </view>
    <view class="registered-user-name">
      <open-data type="userNickName"></open-data>
    </view>
    <view class="registered-tip">
      <p>您的资料已经提交</p>
      <p class="registered-tip-sub">感谢您使用我们秉羲工作台</p>
      <p class="registered-tip-sub">我们会尽快与您联系</p>
      <p class="registered-tip-sub">请保持手机畅通</p>
    </view>
    <view class="btn-wrapper">
      <button bindtap="toLogin" class="to-shop-btn" wx:if="{{showBtn==true}}">
        登录店铺
      </button>
    </view>
  </view>
</view>
