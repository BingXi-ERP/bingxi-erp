page {
  background-color: #fff;
}
.list-title {
  color: #373c55;
  font-family: PingFangSC-Semibold;
  font-size: 24px;
  font-weight: 600;
  line-height: 80rpx;
  margin: auto;
  width: 88%;
}
.list-title-tips {
  color: #999bb4;
  font-family: PingFangSC-Light;
  font-size: 14px;
  font-weight: 300;
  margin: auto auto 20rpx;
  width: 88%;
}
.secction-list {
  background-color: #fff;
  margin-bottom: 20rpx;
  width: 100%;
}
.container,
form {
  width: 100%;
}
.commodity-list {
  margin-bottom: 32rpx;
  width: 84%;
}
.list-upload {
  margin: auto;
  padding: 20rpx 0;
  width: 84%;
}
.list-upload:nth-child(2) {
  padding-top: 0;
}
.list-upload text {
  display: block;
}
.list-upload .validate-no.f12 {
  color: #b5b5b5;
}
.commodity-list text {
  width: 250rpx;
}
.commodity-list input {
  height: 72rpx;
  line-height: 72rpx;
}
.weui-uploader {
  margin-top: 20rpx;
  padding-left: 20rpx;
}
.weui-uploader__img,
.weui-uploader__input-box {
  border-radius: 8rpx;
}
.weui-uploader__input {
  position: relative;
}
.btn-active {
  background-color: #e4eeff;
  border: 1rpx solid #629cff;
  border-radius: 44rpx;
  color: #2f7bfd;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin: 40rpx auto;
  width: 90%;
}
.checkImage {
  color: #4a90e2;
}
.checkImage,
.checkImages {
  font-size: 24rpx;
  margin-top: 10rpx;
  text-align: center;
}
.checkImages {
  color: #525252;
  display: block;
}
.phcolor {
  color: #b5b5b5;
}
.arrow-right {
  padding-right: 30rpx;
  position: relative;
}
.arrow-right::after {
  right: 10rpx;
}
.checkItem {
  background: #fff;
  border: 1rpx solid #c7c8d8;
  border-radius: 16px;
  box-sizing: border-box;
  color: #373c55;
  font-family: PingFangSC-Regular;
  font-size: 14px;
  font-weight: 500;
  height: 27px;
  line-height: 27px;
  margin-left: 20rpx;
  text-align: center;
  width: 56px;
}
.checked {
  background: #4471e7;
  border: 0;
  color: #fff;
}
.picker_placeholder {
  color: #b5b5b5;
}
picker {
  text-align: right;
  width: 65%;
}
.commodity-list.arrow-right {
  position: relative;
  width: 82%;
}
.foot {
  padding: 64rpx;
}
.bottomInfo {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  height: 150rpx;
  justify-content: center;
  text-align: center;
}
.contactS {
  background: #fff;
  color: #4c7cf9;
  padding-left: 4rpx;
}
.codeBu,
.contactS {
  font-size: 24rpx;
  line-height: 44rpx;
}
.codeBu {
  color: #4e8ffe;
  margin-left: 44rpx;
}
.contactCustomer {
  height: 36rpx;
  width: 36rpx;
}
