page {
  background-color: #eff0f7;
  padding-bottom: 200rpx;
}
.contain {
  padding: 0 32rpx;
}
.indexPlace {
  overflow-x: hidden;
}
.identify {
  background: #eaf3ff;
  border-radius: 20rpx;
  color: #336af8;
  height: 40rpx;
  line-height: 40rpx;
  margin-left: auto;
  padding: 0 15rpx;
  text-align: center;
}
.indexTop {
  margin: 42rpx 34rpx;
}
.pageInfo {
  border-radius: 32rpx;
  margin-bottom: 21rpx;
  overflow: hidden;
  padding: 34rpx;
  position: relative;
}
.backgroundImage {
  bottom: 0;
  display: block;
  height: 100%;
  left: 0;
  position: absolute;
  width: 100%;
  z-index: -999;
}
.turnover {
  align-items: center;
  color: #fff;
  display: -webkit-flex;
  display: flex;
  font-size: 28rpx;
  font-weight: 400;
  height: 40rpx;
  line-height: 40rpx;
  width: 400rpx;
}
.turnover text {
  margin-left: 10px;
  margin-right: 4px;
}
.leftInfo {
  margin-right: 32rpx;
  width: 40%;
}
.rightIcon {
  color: #fff;
  float: right;
}
.turnoverNum {
  color: #fff;
  font-size: 64rpx;
  font-weight: 400;
  margin-top: 14rpx;
  overflow: hidden;
  width: 480rpx;
}
.storeInfo {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin: 10rpx 20rpx 42rpx 10rpx;
}
.avatar {
  border-radius: 50%;
  height: 56rpx;
  margin-right: 28rpx;
  width: 56rpx;
}
.avatar-text {
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  display: -webkit-box;
  font-size: 20rpx;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  width: 200rpx;
}
.storeName {
  color: #0b0b0b;
  float: left;
  font-size: 34rpx;
  font-weight: 600;
  overflow: hidden;
  width: 400rpx;
}
.storeSee {
  margin-left: auto;
  text-align: center;
}
.storeIcon {
  color: #fff;
  font-size: 18rpx;
  font-weight: 400;
  margin-left: 52rpx;
}
.storeImg {
  height: 34rpx;
  width: 34rpx;
}
.storeSeeName {
  color: #fff;
  float: left;
  font-weight: 600;
  height: 34rpx;
  line-height: 48rpx;
  margin-left: 20rpx;
}
.dataCenter {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin: 20rpx 16rpx;
}
.cardInfo {
  flex: 1;
}
.detailName {
  margin-left: 10rpx;
}
.detailName,
.waitPay {
  color: #fff;
  font-size: 24rpx;
}
.waitPay {
  margin-left: 44rpx;
}
.waitPayNum {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 46rpx;
  margin-top: 8rpx;
}
.todayVist {
  color: #fff;
  font-size: 24rpx;
  margin-left: 60rpx;
}
.todayVistNum {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 34rpx;
  margin-left: 62rpx;
  margin-top: 8rpx;
}
.more-data .text {
  margin-right: 6rpx;
}
.more-data .icon {
  height: 18rpx;
  width: 20rpx;
}
.newestInfo {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  height: 50rpx;
  justify-content: space-between;
  line-height: 50rpx;
  padding: 60rpx 16rpx;
}
.newestInfo.newestInfo > view:nth-of-type(2) {
  color: #ddd;
}
.newestInfo > view:nth-of-type(1) > span {
  float: left;
}
.icon-wrapper .icon-right-arrow {
  float: right;
  margin-right: 32rpx;
}
.colorCardMan > view,
.customerMan > view,
.newsMan > view {
  flex: 1;
}
.colorCardMan > view:first-child,
.customerMan > view:first-child,
.newsMan > view:first-child {
  text-align: center;
}
.customerMan .title {
  margin-right: 10rpx;
}
.newsMan .img-wrapper image {
  vertical-align: middle;
}
.icon-right-arrow {
  height: 18rpx;
  width: 20rpx;
}
.to-customer-wrapper {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: flex-start;
  margin-bottom: 5rpx;
}
.customerApply {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 30rpx;
  font-size: 20rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 10rpx;
  width: 160rpx;
}
.customerApply,
.customerApplyNum {
  display: inline-block;
  text-align: center;
}
.customerApplyNum {
  background: #e2525a;
  border-radius: 50%;
  margin-left: 10rpx;
  width: 28rpx;
}
.monthInfo {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  position: relative;
}
.monthInfo .detailNum {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 12rpx;
  margin-top: 8rpx;
}
.monthInfo .text {
  background-color: #fff;
  bottom: -13rpx;
  color: #ccc;
  font-size: 20rpx;
  left: 50%;
  padding: 0 20rpx;
  position: absolute;
  transform: translateX(-50%);
}
.customerMan {
  background-size: 100% 100%;
}
.colorCardMan,
.customerMan {
  margin: 0 auto 40rpx;
}
.colorCardMan,
.customerMan,
.newsMan {
  align-items: center;
  border-radius: 8rpx;
  color: #fff;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  height: 140rpx;
  justify-content: space-around;
  width: 650rpx;
}
.newsMan {
  margin: 0 auto;
  position: relative;
}
.newsMan .more {
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 30rpx;
  color: #fff;
  font-size: 20rpx;
  padding: 8rpx 15rpx;
  position: absolute;
  right: 80rpx;
  top: 50%;
  transform: translateY(-50%);
}
.newsMan .red-point {
  background-color: #ed3f42;
  border-radius: 16rpx;
  height: 12rpx;
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 12rpx;
}
.menu-text {
  color: #0b0b0b;
  font-family: PingFangSC, PingFang SC;
  font-size: 24rpx;
  font-weight: 600;
}
.moduleArea {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  margin: 28rpx 0 0;
}
.moduleArea > view {
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx !important;
  width: 25%;
}
.moduleName {
  color: #373c55;
  font-size: 28rpx;
  font-weight: 600;
  margin: 16rpx 0 20rpx 0rpx;
  text-align: center;
  width: 100% !important;
}
.storeState {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  position: relative;
}
.storeState .redPoint {
  background: #e2525a;
  background-color: #ee0a24;
  border-radius: 32rpx;
  box-sizing: border-box;
  color: #fff;
  display: inline-block;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.2;
  min-width: 16px;
  padding: 0 6rpx;
  position: absolute;
  right: -20rpx;
  text-align: center;
  top: -12rpx;
}
.form-btn {
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
}
.form-btn,
.form-contain {
  background: hsla(0, 0%, 100%, 0);
  border-radius: 0;
  height: 100%;
  margin: 0;
  padding: 0;
  position: absolute;
  top: 0;
}
.form-contain {
  width: 116rpx;
}
.btn {
  border-radius: 0;
  height: 20rpx;
  margin: 0;
  opacity: 0;
  padding: 0;
  position: absolute;
  top: 0;
  width: 20rpx;
}
button::after {
  border: none;
}
.tipsModal {
  background: rgba(0, 0, 0, 0.6);
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 100;
}
.tipsModalContent {
  margin-left: auto;
  margin-right: auto;
  margin-top: 128rpx;
}
.tipsModalContent,
.tipsModalContent2 {
  background: #fff;
  border-radius: 20rpx;
  height: 760rpx;
  width: 600rpx;
}
.tipsModalContent2 {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -61%);
}
.search_img {
  height: 100%;
  width: 100%;
}
.tipsBg {
  background-size: contain;
  height: 172rpx;
}
.InfoTop {
  color: #333;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}
.InfoContent {
  margin-bottom: 24rpx;
}
.InfoContent,
.InfoUpdate {
  color: #567;
  font-size: 26rpx;
}
.InfoUpdate {
  margin-bottom: 12rpx;
}
.JumpAddress {
  color: #567;
  font-size: 26rpx;
  margin-top: 24rpx;
}
.closeTips {
  height: 64rpx;
  margin-top: 50rpx;
  width: 64rpx;
}
.toUserTeac {
  color: #3780ff;
  font-size: 26rpx;
  font-weight: 600;
}
.tip-dialog {
  height: 100%;
  width: 80%;
}
.tip-dialog .van-popup {
  border-radius: 16rpx;
  color: #999bb4;
  font-size: 28rpx;
  padding: 48rpx;
  width: 640rpx;
}
.popTitle {
  color: #353535;
  font-size: 16px;
  font-weight: 700;
  text-align: center;
}
.ad-dialog .van-popup {
  background-color: initial;
  border-radius: 16rpx;
}
.popContent {
  color: #353535;
  display: block;
  line-height: 1.8;
  max-height: 900rpx;
  min-height: 24rpx;
  overflow-y: scroll;
  padding: 40rpx 0;
}
.p_class {
  list-style: inside;
  margin: 0;
  padding: 0;
  vertical-align: initial;
}
.p_class::marker {
  text-indent: 0;
}
.popBox {
  text-align: center;
}
.popBtn {
  margin-bottom: 20rpx;
}
.btns {
  background: linear-gradient(270deg, #4177f5, #87b1fa);
  border: none !important;
  border-radius: 21px 21px 21px 21px;
  color: #fff !important;
  height: 42px !important;
  line-height: 42px !important;
  width: 100% !important;
}
.ad {
  max-height: 960rpx;
  min-height: 200rpx;
  width: 600rpx;
}
.ad image {
  border-radius: 16rpx;
}
.banner {
  margin-bottom: 20rpx;
}
.ad .close {
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}
.ad .close .van-icon {
  color: #fff;
  font-size: 30px;
}
.info-box {
  height: 50rpx;
  margin-bottom: 20rpx;
}
.white-block {
  background: #fff;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  padding: 28rpx 35rpx 0 28rpx;
}
.fun-item {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
.item-img {
  height: 64rpx !important;
  width: 64rpx !important;
}
.fun-item-column {
  justify-content: space-between;
  width: 43% !important;
}
.fun-item-column,
.left-layout {
  display: -webkit-flex;
  display: flex;
}
.img-wrap {
  height: 42rpx;
  margin-right: 40rpx;
  width: 42rpx;
}
.img-wrap image {
  height: 100%;
  width: 100%;
}
.flex-bt {
  display: -webkit-flex;
  display: flex;
  justify-content: space-between !important;
}
