<view class="contain">
  <view class="colorCard displayFlex">
    <view>
      <image
        src="{{colorCardDetail.mainImgPath}}"
        style="width: 130rpx; height: 130rpx"
      ></image>
    </view>
    <view>
      <view>{{colorCardDetail.goodsName}}</view>
      <view>
        <span wx:if="{{colorCardDetail.breadth}}"
          >宽幅：{{colorCardDetail.breadth}}</span
        >
        <span style="margin-left: 40rpx" wx:if="{{colorCardDetail.ingredient}}"
          >成份：{{colorCardDetail.ingredient}}</span
        >
      </view>
      <view
        >￥ {{colorCardDetail.goodsPrice}} {{colorCardDetail.priceUnit}}</view
      >
    </view>
  </view>
  <view class="listTitle displayFlex">
    <view>用户</view>
    <view>联系方式</view>
    <view>领取时间</view>
  </view>
  <view class="listData displayFlex" wx:for="{{list}}" wx:key="index">
    <view>{{item.fullName}}</view>
    <view>{{item.mobile}}</view>
    <view>{{item.accessTime}}</view>
  </view>
</view>
