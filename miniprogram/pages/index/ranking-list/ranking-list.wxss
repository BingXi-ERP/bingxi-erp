.contain {
  padding: 30rpx;
}
.displayFlex {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
}
.listTitle {
  color: #333;
  font-size: 28rpx;
  padding: 20rpx;
}
.listTitle > view:nth-of-type(1) {
  width: 20%;
}
.listTitle > view:nth-of-type(2) {
  width: 54%;
}
.listData {
  color: #666;
  font-size: 24rpx;
  line-height: 60rpx;
  padding: 20rpx 40rpx;
}
.listData:nth-child(odd) {
  background-color: #f5f5f9;
}
.listData > view:nth-of-type(1) {
  width: 20%;
}
.listData > view:nth-of-type(2) {
  width: 60%;
}
.noDataComtent {
  margin-bottom: 100rpx;
}
.noDataBg {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: 300rpx 300rpx;
  height: 300rpx;
  margin-top: 30rpx;
  width: 100%;
}
.noDataContent {
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
  height: 34rpx;
  line-height: 34rpx;
  margin-top: 20rpx;
  text-align: center;
  width: 100%;
}
