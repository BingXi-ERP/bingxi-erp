.start-wrapper {
  margin: 0 auto;
  width: 670rpx;
}
.notice-wrapper {
  background-color: #f5f5f9;
  border-radius: 30rpx;
  margin: 5rpx auto 20rpx;
  padding: 10rpx 20rpx;
  width: 370rpx;
}
.notice-wrapper .icon {
  height: 26rpx;
  margin-right: 20rpx;
  width: 26rpx;
}
.notice-wrapper .text {
  color: #8791a1;
  font-size: 20rpx;
}
.bg-wrapper {
  height: 628rpx;
  width: 670rpx;
}
.explain-wrapper .title {
  margin: 30rpx 0 20rpx;
}
.explain-wrapper .text {
  margin-bottom: 10rpx;
}
.btn-wrapper {
  margin-top: 30rpx;
}
.btn-wrapper > view {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  width: 316rpx;
}
.btn-wrapper .album {
  background-color: #e4eeff;
  border: 1rpx solid #2f7bfd;
  color: #2f7bfd;
  margin-right: 20rpx;
}
.btn-wrapper .photo {
  background-color: #2f7bfd;
  color: #fff;
  margin-left: 20rpx;
}
.btn-wrapper .photo .icon {
  height: 32rpx;
  margin-right: 20rpx;
  width: 38rpx;
}
.no-power-wrapper {
  margin-top: 200rpx;
}
.no-power-wrapper .icon {
  height: 300rpx;
  margin-bottom: 20rpx;
  width: 300rpx;
}
.no-power-wrapper .text1 {
  font-weight: 700;
  margin-bottom: 20rpx;
}
.no-power-wrapper .text2 {
  font-size: 24rpx;
}
