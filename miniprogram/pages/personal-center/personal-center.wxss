page {
  background: #eff0f7;
  padding-bottom: 220rpx;
}
.user-center-wrapper {
  overflow-x: hidden;
  position: relative;
}
.avatar {
  border-radius: 100%;
  height: 156rpx;
  margin: 52rpx auto 28rpx;
  position: relative;
  width: 156rpx;
}
.role-icon {
  background-color: #fff;
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: contain;
  border: 4rpx solid #fff;
  border-radius: 100%;
  bottom: 0;
  box-shadow: 0rpx 2rpx 7rpx 0rpx rgba(0, 0, 0, 0.16);
  height: 56rpx;
  position: absolute;
  right: 0;
  width: 56rpx;
}
.tools-wrapper .item {
  flex: 1;
}
.tools-wrapper .item .icon {
  height: 72rpx;
  margin-bottom: 10rpx;
  width: 72rpx;
}
.redPoint {
  position: relative;
}
.redPoint::after {
  background: red;
  border-radius: 50%;
  content: "";
  height: 10rpx;
  left: -15rpx;
  position: absolute;
  top: 65%;
  transform: translateY(-65%);
  width: 10rpx;
}
.panel-wrapper .item1 {
  position: relative;
}
.contact {
  background: hsla(0, 0%, 100%, 0) !important;
  height: 110rpx;
  left: 0rpx;
  position: absolute;
  top: 0rpx;
  width: 100%;
}
.presonal-content {
  position: relative;
}
.myAnswer {
  background: #fff;
  border-radius: 16rpx 16rpx 0 0;
  height: 256rpx;
  margin: 0 32rpx 32rpx;
}
.myAnswer .title {
  box-sizing: border-box;
  height: 96rpx;
  padding: 0 32rpx;
  position: relative;
}
.myAnswer .title::after {
  border-bottom: 1rpx solid #f5f5f5;
  bottom: 0;
  content: "";
  height: 1rpx;
  left: 0;
  position: absolute;
  width: 100vw;
}
.myAnswer .title .left {
  color: #373c55;
  font-family: PingFangSC-Medium;
  font-size: 15px;
  font-weight: 500;
}
.myAnswer .title .right {
  color: #999bb4;
  font-family: PingFangSC-Regular;
  font-size: 14px;
  font-weight: 400;
  position: relative;
}
.myAnswer .content {
  height: 160rpx;
}
.combo {
  align-items: center;
  background: linear-gradient(120deg, #3a2a26, #241a17);
  border-radius: 28rpx;
  box-sizing: border-box;
  color: #ffe2d3;
  display: -webkit-flex;
  display: flex;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  margin-left: 34rpx;
  padding: 34rpx 10rpx;
  width: calc(100vw - 68rpx);
}
.combo .lock {
  border-radius: 14rpx;
  font-size: 40rpx;
  margin: 0 8rpx;
}
.combo .tips {
  margin: 2rpx 0;
}
.combo .dot {
  margin-left: 22rpx;
  position: relative;
}
.combo .dot::after {
  background: #ffe2d3;
  content: "";
  height: 4rpx;
  left: -14rpx;
  position: absolute;
  top: 50%;
  width: 4rpx;
}
.combo button {
  background: linear-gradient(180deg, #ff8b6c, #fb562c);
  border-radius: 50rpx;
  color: #ffe2d3;
  font-size: 24rpx;
  line-height: auto;
  padding: 0 28rpx;
  position: absolute;
  right: 60rpx;
}
.personal-child {
  display: -webkit-flex;
  display: flex;
  flex-wrap: wrap;
  padding: 34rpx 10rpx;
}
.personal-child,
.personal-muen {
  background: #fff;
  border-radius: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  margin-left: 34rpx;
  width: calc(100vw - 68rpx);
}
.more {
  color: #0b0b0b;
  font-size: 26rpx;
  font-weight: 700;
  padding: 28rpx 34rpx;
}
.muen-child {
  align-items: center;
  border-radius: 20rpx;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin: 20rpx 0;
  text-align: center;
  width: 220rpx;
}
.child-box {
  border-radius: 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin-bottom: 14rpx;
  width: 56rpx;
}
.muen-item {
  box-sizing: border-box;
  height: 112rpx;
  padding: 0 32rpx;
  position: relative;
}
.muen-item::after {
  border-bottom: 2rpx solid #f4f4f4;
  bottom: 0;
  content: "";
  height: 2rpx;
  left: 90rpx;
  position: absolute;
  width: calc(100vw - 200rpx);
}
.muen-item:last-child::after {
  border-bottom: none;
}
.child-icon {
  height: 32rpx;
  width: 32rpx;
}
.meun-icon {
  height: 34rpx;
  margin-right: 28rpx;
  width: 34rpx;
}
.contactIcon {
  height: 30rpx;
  margin-right: 10rpx;
  width: 30rpx;
}
.child-text,
.muen-text {
  color: #373c55;
  font-family: PingFangSC-Medium;
  font-size: 24rpx;
  font-weight: 500;
}
.shop-name {
  margin-bottom: 14rpx;
}
.name,
.shop-name {
  text-align: center;
}
.name {
  color: #5d5d5d;
  margin-bottom: 50rpx;
  margin-left: 5%;
  width: 90%;
}
.info-info .name {
  display: block;
  max-width: 300rpx;
}
.approveMask {
  background: rgba(0, 0, 0, 0.6);
  height: 100vh;
  left: 0;
  position: fixed;
  top: 0;
  width: 100vw;
  z-index: 98;
}
.approve {
  background: #fff;
  border-radius: 10rpx;
  box-sizing: border-box;
  left: 50%;
  padding: 0 48rpx;
  position: absolute;
  top: 35%;
  transform: translate(-50%, -35%);
  width: 500rpx;
  z-index: 9998;
}
.approve .title {
  color: #373c55;
  font-family: PingFangSC-Medium;
  font-size: 18px;
  font-weight: 500;
  height: 154rpx;
  line-height: 154rpx;
  text-align: center;
}
.approve .content {
  border-bottom: 1rpx solid #edeff6;
  color: #64689e;
  font-family: PingFangSC-Regular;
  font-size: 14px;
  font-weight: 400;
  height: 170rpx;
}
.approve .toBtn {
  color: #336af8;
  font-family: PingFangSC-Medium;
  font-size: 16px;
  font-weight: 500;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
}
.invitationIcon {
  background: linear-gradient(90deg, #ff7e55, #ff4a4a);
  border-radius: 20rpx;
  color: #fff;
  font-size: 11px;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  width: 200rpx;
}
.invitationIcon,
.openShopStatus {
  font-family: PingFangSC-Regular;
  font-weight: 400;
}
.openShopStatus,
.openShopText {
  color: #999bb4;
  font-size: 14px;
}
.openShopText {
  font-weight: 400;
}
.invietIcon {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  bottom: 180rpx;
  height: 132rpx;
  margin-bottom: env(safe-area-inset-bottom);
  position: fixed;
  right: 0;
  width: 132rpx;
}
.contactCustomer {
  color: #fb562c;
  font-family: SFProText;
  font-size: 24rpx;
  font-weight: 400;
  position: absolute;
  right: 25rpx;
  z-index: 100;
}
.noteText {
  align-items: center;
  background: #fff6e3;
  bottom: 50px;
  box-sizing: border-box;
  color: #ff861f;
  display: -webkit-flex;
  display: flex;
  font-size: 12px;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  position: fixed;
  width: 100%;
}
.noteContent {
  padding: 14rpx 32rpx;
}
.debugBtn {
  display: block;
  height: 64rpx;
  opacity: 0.5;
  position: absolute;
  right: 30rpx;
  top: 0rpx;
  width: 64rpx;
  z-index: 9;
}
