<van-popup bind:close="onClose" overlay="{{overlay}}" position="{{position}}" show="{{show}}" zIndex="999">
    <view class="wrapper">
        <block wx:if="{{isShareProd}}">
            <view bindtap="actionTap" class="item" data-action="{{item.action}}" data-goodsid="{{goodsId}}" wx:for="{{shareList2}}" wx:key="index">
                <view class="icon" style="background-image:url(\"{{item.icon}}\")"></view>
                <view class="name">{{item.name}}</view>
            </view>
        </block>
        <view bindtap="actionTap" class="toM item" data-action="{{shareList[1].action}}" data-goodsid="{{goodsId}}" wx:else>
            <view class="icon" style="background-image:url(\"{{shareList[1].icon}}\")"></view>
            <view class="name">{{shareList[1].name}}</view>
        </view>
    </view>
</van-popup>
