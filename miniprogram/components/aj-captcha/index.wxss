.aj-captcha-mask {
  background: rgba(0, 0, 0, 0.3);
  height: 100vh;
  left: 0;
  position: fixed;
  top: 0;
  transition: all 0.5s;
  width: 100%;
  z-index: 1001;
}
.fixed .aj-captcha-mask {
  display: none;
}
.aj-captcha {
  background-color: #fff;
  border: 1px solid #e4e7eb;
  border-radius: 2px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
  left: 50%;
  position: fixed;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 1002;
}
.fixed .aj-captcha {
  background: none;
  border: none;
  box-shadow: none;
  left: 0;
  position: relative;
  top: 0;
  transform: none;
}
.verifybox-top {
  border-bottom: 1px solid #e4e7eb;
  box-sizing: border-box;
  color: #45494c;
  font-size: 16px;
  height: 50px;
  line-height: 50px;
  padding: 0 15px;
  text-align: left;
}
.fixed .verifybox-top {
  display: none;
}
.verifybox-close {
  background-image: url(data:image/png;base64,);
  background-size: cover;
  cursor: pointer;
  height: 8px;
  padding: 8px;
  position: absolute;
  right: 9px;
  text-align: center;
  top: 13px;
  width: 8px;
}
.verifybox-bottom {
  box-sizing: border-box;
  padding: 15px;
}
.fixed .verifybox-bottom {
  padding: 0;
}
.verify-img-panel {
  border: 1px solid #ddd;
  border-radius: 3px;
  box-sizing: initial;
  margin: 0;
  position: relative;
}
.verify-refresh {
  background-image: url(data:image/png;base64,);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: 50% 50%;
  cursor: pointer;
  height: 24px;
  padding: 5px;
  position: absolute;
  right: 0;
  top: 0;
  width: 24px;
  z-index: 3;
}
.click-word-point {
  background-color: #1abd6c;
  border-radius: 50%;
  color: #fff;
  height: 20px;
  line-height: 20px;
  position: absolute;
  text-align: center;
  width: 20px;
  z-index: 4;
}
.verify-tips {
  bottom: -35px;
  color: #fff;
  height: 30px;
  left: 0;
  line-height: 30px;
  position: absolute;
  transition: bottom 0.5s linear;
  width: 100%;
}
.err-bg {
  background-color: rgba(217, 83, 79, 0.5);
  bottom: 0;
  filter: progid:DXImageTransform.Microsoft.gradient(startcolorstr=#7fD9534F,endcolorstr=#7fD9534F);
}
.suc-bg {
  background-color: rgba(92, 184, 92, 0.5);
  bottom: 0;
  filter: progid:DXImageTransform.Microsoft.gradient(startcolorstr=#7f5CB85C,endcolorstr=#7f5CB85C);
}
.verify-bar-area {
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 2px;
  box-sizing: initial;
  position: relative;
  text-align: center;
}
.suc-area.verify-bar-area {
  border-color: #5cb85c;
  color: #4cae4c;
}
.err-area.verify-bar-area {
  border-color: #d9534f;
  color: #d9534f;
}
.verify-msg {
  z-index: 3;
}
.verify-left-bar {
  background: #f0fff0;
  border: 1px solid #ddd;
  border-radius: 2px;
  left: -1px;
  top: -1px;
}
.verify-left-bar,
.verify-move-block {
  box-sizing: initial;
  cursor: pointer;
  position: absolute;
}
.verify-move-block {
  background: #fff;
  background-size: cover;
  box-shadow: 0 0 2px #888;
  left: 0;
  top: 0;
}
.status-1.verify-left-bar {
  border-color: #fff;
  transition: width 0.3s ease;
  width: 0 !important;
}
.status-2.verify-left-bar {
  border-color: #337ab7;
}
.status-3.verify-left-bar {
  border-color: #d9534f;
}
.status-4.verify-left-bar {
  border-color: #5cb85c;
}
.status-1 .verify-move-block {
  background-color: #fff;
  background-image: url(data:image/png;base64,);
  transform: translateX(0) !important;
  transition: -webkit-transform 0.3s ease;
  transition: transform 0.3s ease;
  transition: transform 0.3s ease, -webkit-transform 0.3s ease;
}
.status-2 .verify-move-block {
  background-color: #337ab7;
  background-image: url(data:image/png;base64,);
}
.status-3 .verify-move-block {
  background-color: #d9534f;
  background-image: url(data:image/png;base64,);
}
.status-4 .verify-move-block {
  background-color: #5cb85c;
  background-image: url(data:image/png;base64,);
}
.verify-sub-block {
  position: absolute;
  text-align: center;
  z-index: 3;
}
