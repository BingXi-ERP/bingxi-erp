.c-search-bar {
  background-color: #fff;
  padding: 20rpx 56rpx;
}
.c-search-bar-wrapper {
  align-items: center;
  background: #f5f5f9;
  border-radius: 44rpx;
  display: -webkit-flex;
  display: flex;
  height: 72rpx;
  padding: 0 30rpx;
}
.c-search-bar-input {
  flex: 1;
  height: 100%;
  padding: 0 10rpx;
}
.c-search-bar-btn {
  height: 40rpx;
  width: 40rpx;
}
