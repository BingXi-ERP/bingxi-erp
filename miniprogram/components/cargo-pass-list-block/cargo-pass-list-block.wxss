.color-card-list-block {
  background-color: #fff;
  border-radius: 16rpx;
  margin: 24rpx auto;
  width: 690rpx;
}
.fl {
  flex-direction: row;
}
.fl,
.info {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.info {
  border-bottom: 1rpx solid #f5f5f5;
  margin: 0 30rpx;
  padding: 30rpx 0;
}
.newInfo {
  border-bottom: 0;
}
.bg-wrapper {
  margin-right: 30rpx;
  position: relative;
}
.bg-wrapper .img-bg {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  border-radius: 8rpx;
  height: 160rpx;
  width: 160rpx;
}
.permission-bg {
  align-items: center;
  background-color: rgba(0, 0, 0, 0.5);
  bottom: 0rpx;
  display: -webkit-flex;
  display: flex;
  height: 48rpx;
  justify-content: center;
  left: 0rpx;
  position: absolute;
  width: 160rpx;
}
.permission-bg .icon {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  height: 18rpx;
  margin-right: 15rpx;
  width: 16rpx;
}
.permission-bg .text {
  color: #fff;
  font-size: 20rpx;
}
.info-info {
  margin-right: 30rpx;
  width: 266rpx;
}
.info-info .name {
  color: #373c55;
  font-size: 28rpx;
}
.info-info .price {
  color: #333;
  font-size: 24rpx;
  font-weight: 700;
  margin: 10rpx 0;
}
.info-info .price text {
  color: #ddd;
}
.info-info .visit {
  color: #999;
  font-size: 24rpx;
}
.tool .print {
  background: linear-gradient(90deg, #7ab5ff, #336af8);
  margin-bottom: 67rpx;
}
.tool .off,
.tool .print {
  border-radius: 40rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  height: 64rpx;
  line-height: 64rpx;
  min-width: 160rpx;
  text-align: center;
}
.tool .off {
  background: #d8d9e3;
  margin-bottom: 65rpx;
}
.tool .collect {
  color: #999;
  font-size: 24rpx;
  text-align: right;
}
.action {
  padding: 20rpx 0;
}
.action,
.action-item {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
}
.action-item {
  flex: 1;
  flex-direction: column;
}
.action-item .icon {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  height: 40rpx;
  margin-bottom: 6rpx;
  width: 40rpx;
}
.action-item .name {
  font-size: 24rpx;
}
.info-info .name {
  height: 80rpx;
  overflow: hidden !important;
}
.g_limtRowTwo {
  word-wrap: break-word;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal !important;
  word-break: break-all;
}
.line {
  margin-right: 15rpx;
  position: relative;
}
.line::after {
  border-right: 1rpx solid #f5f5f5;
  content: "";
  height: 20rpx;
  position: absolute;
  right: -10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
}
.listBottomItem {
  color: #70728c;
  font-size: 24rpx;
  font-weight: 400;
  padding: 0 40rpx;
}
.opIoc {
  height: 48rpx;
  width: 48rpx;
}
.listBottom {
  height: 96rpx;
}
.btn_gloup {
  padding-top: 66rpx;
}
.btn_gloup .btn1 {
  border: 1px solid #4177f5;
  border-radius: 21px;
  color: #4177f5;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0rpx 26rpx;
  position: relative;
  white-space: nowrap;
  z-index: 5;
}
.shelves {
  color: #ff9823;
  text-align: center;
}
