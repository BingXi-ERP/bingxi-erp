.wrapper {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  margin: 0 54rpx;
  padding: 35rpx 0;
  position: relative;
}
.left {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
}
.center {
  flex: 7;
  margin-left: 40rpx;
}
.title {
  color: #333;
  font-size: 32rpx;
  margin-bottom: 2rpx;
}
.subTitle {
  color: #999;
  font-size: 20rpx;
  margin-top: 10rpx;
}
.right1 {
  background-image: url(https://img.duibu.cn/duibu/shop/img/customer/ic_jinru.png?imageView2/2/w/750);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  height: 22rpx;
  width: 12rpx;
}
.right2 {
  color: #999;
  font-size: 24rpx;
  margin-top: 40rpx;
}
.border {
  border-bottom: 1rpx solid #ddd;
}
.font-red {
  color: #e2525a;
}
.form-btn {
  background: rgba(0, 155, 0, 0);
  border-radius: 0;
  height: 100%;
  left: 0;
  margin: 0;
  padding: 0;
  position: absolute;
  top: 0;
  width: 100%;
}
