.contain {
  background: #fff;
  overflow-x: hidden;
}
.checkBg {
  background: #ddd;
  color: #000 !important;
}
.checkedBg {
  background: #ddd !important;
}
.storeInfo {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  padding: 10rpx 0 0;
}
.storeImg {
  border-radius: 50%;
  height: 90rpx;
  position: absolute;
  top: -36rpx;
  width: 90rpx;
}
.storeTotalInfo {
  border-bottom: 1rpx solid #ddd;
  color: #666;
  font-size: 24rpx;
  padding-bottom: 40rpx;
  padding-top: 10rpx;
  text-align: center;
}
.topContent {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  height: 260rpx;
  position: relative;
  top: -28rpx;
}
.storeName {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
  margin-left: 120rpx;
  margin-top: 10rpx;
}
.displayFlex {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  padding: 24rpx 0 0 32rpx;
}
.tab {
  color: #333;
  font-size: 28rpx;
  line-height: 60rpx;
  margin-top: 50rpx;
  text-align: center;
}
.tab > view {
  color: #999;
  display: inline-block;
}
.tab > view:nth-of-type(2) {
  border: 1rpx solid #ddd;
  border-radius: 30rpx 0 0 30rpx;
  height: 60rpx;
  width: 240rpx;
}
.tab > view:nth-of-type(3) {
  border: 1rpx solid #ddd;
  border-radius: 0 30rpx 30rpx 0;
  height: 60rpx;
  width: 240rpx;
}
.colorCardReceive {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 30rpx;
  width: 100%;
}
.yearMonDate {
  color: #999;
  font-size: 24rpx;
  margin-top: 40rpx;
}
.yearMonDate,
.yearMonDateNum {
  justify-content: space-around;
}
.yearMonDateNum {
  color: #333;
  font-size: 32rpx;
  height: 44rpx;
  line-height: 44rpx;
}
.yearMonDate > view {
  text-align: center;
  width: 100%;
}
.yearMonDate > view:nth-of-type(1) {
  border-right: 1rpx solid #ddd;
}
.bottom-content {
  background: #fff;
  height: 406rpx;
}
.bottom-content > .List {
  border-bottom: 1rpx solid #ddd;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  height: 90rpx;
  justify-content: space-between;
  line-height: 90rpx;
  margin: 0 30rpx;
}
.todayIncome {
  color: #999;
  font-size: 28rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin: 38rpx 30rpx 0 58rpx;
}
.todayIncomeNum {
  color: #333;
  font-size: 48rpx;
  height: 66rpx;
  line-height: 66rpx;
  margin: 10rpx 30rpx 30rpx 58rpx;
}
.bottom-content > .List > view:nth-of-type(1) {
  color: #333;
  font-size: 32rpx;
  font-weight: 600;
  width: 74%;
}
.bottom-content > .List > view:nth-of-type(2) {
  font-size: 24rpx;
}
.listTitle {
  color: #333;
  font-size: 28rpx;
  padding: 20rpx 0;
}
.listTitle > view:nth-of-type(1) {
  width: 20%;
}
.listTitle > view:nth-of-type(2) {
  width: 54%;
}
.listData {
  color: #666;
  font-size: 24rpx;
  padding: 20rpx;
}
.listData:nth-child(even) {
  background-color: #f5f5f9;
}
.listData > view:nth-of-type(1) {
  line-height: 60rpx;
  width: 10%;
}
.listData > view:nth-of-type(2) {
  width: 80%;
}
.listData > view:nth-of-type(3) {
  line-height: 60rpx;
  width: 10%;
}
.customerlistTitle {
  color: #343434;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
}
.customerlistTitle > view:nth-of-type(1),
.customerlistTitle > view:nth-of-type(2) {
  width: 50%;
}
.customerlistData {
  color: #666;
  font-size: 24rpx;
  padding: 20rpx 0;
  text-align: center;
}
.customerlistData:nth-child(even) {
  background-color: #f5f5f9;
}
.customerlistData > view:nth-of-type(1) {
  width: 50%;
}
.customerlistData > view:nth-of-type(1) image {
  border-radius: 50%;
  margin: 0 auto;
}
.customerlistData > view:nth-of-type(2) {
  width: 50%;
}
.totalIncome {
  color: #333;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 50rpx;
  margin: 0 20rpx;
}
.totalIncomeNum {
  color: #333;
  font-size: 60rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
}
.spot {
  background: #ddd;
  border-radius: 20rpx;
  display: inline-block;
  height: 10rpx;
  position: relative;
  top: -5rpx;
  width: 10rpx;
}
.todayInfo {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin: 0 58rpx;
}
.todayInfo > view > view:nth-of-type(1) {
  color: #999;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}
.todayInfo > view > view:nth-of-type(2) {
  color: #333;
  font-size: 32rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
}
.space {
  margin-top: 20rpx;
}
.Visitorspace {
  margin-top: 38rpx;
}
.customer {
  height: 262rpx;
}
.topTab {
  background: #2d74ee;
  display: -webkit-flex;
  display: flex;
  height: 124rpx;
}
.SalesVolume {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 60rpx;
  width: 178rpx;
}
.tabActive {
  background: #fff;
  height: 6rpx;
  margin-left: 32rpx;
  margin-top: 24rpx;
  width: 40rpx;
}
.receivable,
.receivables,
.refund {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  width: 178rpx;
}
.dateChoose {
  padding-top: 10rpx;
}
.explain {
  border-bottom: 1rpx solid #f5f6fa;
  border-radius: 34rpx;
  color: #999bb4;
  display: -webkit-flex;
  display: flex;
  font-size: 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  padding-left: 36rpx;
  width: 666rpx;
  width: 100%;
}
.explainLogo {
  height: 26rpx;
  margin-left: 20rpx;
  margin-right: 12rpx;
  margin-top: 12rpx;
  width: 26rpx;
}
.lately-date-choose {
  margin: 36rpx 50rpx 0 36rpx;
}
.dateB {
  background: #fff !important;
  border: 1rpx solid #ddd;
  border-radius: 36rpx;
  color: #666;
  display: inline-block;
  font-size: 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  width: 182rpx;
}
.buttonSpace {
  margin-right: 24rpx;
}
.choosedBotton {
  background: #edf3fc !important;
  border: 1rpx solid #2f7bfd;
  color: #2f7bfd;
  font-weight: 600;
}
.data-choose {
  border: 1rpx solid #ccc;
  font-size: 28rpx;
  text-align: center;
  width: 260rpx;
}
.data-choose,
.switch-btn {
  border-radius: 36rpx;
  height: 60rpx;
  line-height: 60rpx;
}
.switch-btn {
  background: #e4f0ff;
  float: right;
  width: 224rpx;
}
.switch-btn button {
  background: #edf3fc;
  border-radius: 36rpx;
  color: #82a5ff;
  float: left;
  font-size: 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  text-align: center;
  width: 112rpx;
}
.switch-btn button.active {
  background: #5c84ff;
  color: #fff;
}
.dateRange {
  color: #333;
  display: inline-block;
  font-size: 28rpx;
  font-weight: 400;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0 40rpx;
  width: 28rpx;
}
.chartContent {
  background: linear-gradient(#f5f5f5 10%, #fff);
  height: 600rpx;
  overflow: hidden;
  padding-top: 40rpx;
}
.chartTitle {
  color: #333;
  font-size: 28rpx;
  margin-top: 18rpx;
  text-align: center;
}
.chartNum {
  font-size: 60rpx;
  font-weight: 600;
  text-align: center;
}
.dataList {
  background-color: #f5f6fa;
  height: 100rpx;
  line-height: 100rpx;
}
.dataList,
.dataList-title {
  display: -webkit-flex;
  display: flex;
}
.dataList-title {
  align-items: center;
  background-color: #fff;
  height: 96rpx;
  justify-content: flex-start;
  width: 100%;
}
.dataSource {
  font-size: 28rpx;
  margin-left: 16rpx;
}
.dataSourceLogo {
  height: 40rpx;
  margin-left: 32rpx;
  width: 40rpx;
}
.list-date {
  background: #f5f5f9;
  font-size: 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding-left: 32rpx;
}
.orderNom {
  color: #999;
  font-size: 24rpx;
  padding-bottom: 18rpx;
}
.data-list {
  padding: 30rpx 32rpx 0;
}
.data-list-content {
  border-bottom: 1rpx solid #edeff6;
  justify-content: space-between;
  padding-bottom: 30rpx;
}
.data-list-content,
.data-list-content .left {
  align-items: flex-start;
  display: -webkit-flex;
  display: flex;
}
.data-list-content .left {
  justify-content: flex-start;
}
.customerInfo {
  margin-left: 16rpx;
}
.orderCustomer {
  color: #333;
  font-size: 32rpx;
  max-height: 90rpx;
  overflow: hidden;
  width: 300rpx;
}
.orderInfo {
  color: #999;
  flex: 1;
  font-size: 24rpx;
  text-align: right;
}
.orderMoney {
  display: -webkit-flex;
  display: flex;
  height: 34rpx;
  justify-content: flex-end;
  line-height: 34rpx;
  margin-bottom: 12rpx;
}
.orderMoneyNum {
  color: #e2525a;
  font-size: 32rpx;
  margin-left: 16rpx;
  max-width: 230rpx;
}
.flex-text {
  align-items: flex-end;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
}
.wd-limit {
  max-width: 300rpx;
}
.orderList {
  display: -webkit-flex;
  display: flex;
}
.customerImage {
  border-radius: 50%;
  height: 48rpx;
  width: 48rpx;
}
.noBorder {
  border: none !important;
}
.noDataComtent {
  margin-bottom: 100rpx;
}
.noDataBg {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: 300rpx 300rpx;
  height: 300rpx;
  margin-top: 30rpx;
  width: 100%;
}
.noDataContent {
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
  height: 34rpx;
  line-height: 34rpx;
  margin-top: 20rpx;
  text-align: center;
  width: 100%;
}
.spaceBg {
  background: #f5f5f9;
  height: 60rpx;
}
.limit {
  width: 150rpx !important;
}
