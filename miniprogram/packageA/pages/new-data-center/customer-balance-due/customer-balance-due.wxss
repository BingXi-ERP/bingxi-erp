page {
  background-color: #f5f6fa;
}
.top-fixed {
  left: 0;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 9;
}
.top-bg {
  align-items: flex-start;
  background-color: #2d74ee;
  color: #abc8ff;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  font-size: 24rpx;
  font-weight: 400;
  height: 184rpx;
  justify-content: center;
  padding-left: 32rpx;
  position: relative;
}
.top-bg .number {
  color: #fff;
  font-family: DIN-Medium;
  font-size: 64rpx;
  font-weight: 500;
}
.top-mask {
  background-color: #4471e7;
  height: 64rpx;
  padding: 0 32rpx;
}
.top-mask .text {
  color: #edf3fc;
  font-family: PingFangSC-Regular;
  font-size: 24rpx;
  font-weight: 400;
  height: 64rpx;
  line-height: 64rpx;
}
.top-mask text {
  margin-left: 16rpx;
}
.searchBar > view {
  color: #edf3fc;
  font-size: 24rpx;
  font-weight: 400;
  margin-right: 10rpx;
}
.searchBar image {
  height: 32rpx;
  width: 32rpx;
}
.list-title {
  align-items: center;
  background-color: #f5f6fa;
  color: #373c55;
  display: -webkit-flex;
  display: flex;
  font-size: 28rpx;
  height: 64rpx;
  justify-content: space-between;
  padding: 0 32rpx;
}
.filter text {
  margin-right: 16rpx;
}
.filter image {
  height: 20rpx;
  width: 20rpx;
}
.cus-list {
  background: #fff;
  margin-top: 312rpx;
  padding: 0 30rpx;
  position: relative;
}
.list-item {
  align-items: center;
  border-bottom: 1rpx solid #edeff6;
  display: -webkit-flex;
  display: flex;
  height: 128rpx;
  justify-content: space-between;
  line-height: 128rpx;
}
.list-left image {
  float: left;
  height: 96rpx;
  margin: 16rpx 32rpx 0 0;
  vertical-align: middle;
  width: 96rpx;
}
.list-left text {
  float: left;
  height: 128rpx;
  line-height: 128rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 220rpx;
}
.list-right image {
  height: 22rpx;
  width: 22rpx;
}
.list-right text {
  display: inline-block;
  font-size: 36rpx;
  font-weight: 500;
  margin-right: 16rpx;
  max-width: 300rpx;
}
.red-num {
  color: #ed5c5c;
}
.gray-num {
  color: #999bb4;
}
.more {
  height: 120px;
  position: relative;
}
.moreIcon {
  color: #999bb4;
  font-size: 24rpx;
  height: 34rpx;
  left: 50%;
  position: absolute;
  text-align: center;
  top: 10rpx;
  transform: translateX(-50%);
  width: 160rpx;
}
.color-btn {
  background: linear-gradient(90deg, #7ab5ff, #336af8);
  border-radius: 48rpx;
  box-shadow: 0 12rpx 24rpx -2px rgba(120, 169, 255, 0.5);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  width: 90%;
}
.fff-btn {
  background-color: #fff;
  border: 1px solid #4c7cf9;
  color: #4c7cf9;
}
.footer-btn span {
  color: #999bb4;
  height: 66rpx;
  line-height: 66rpx;
}
.footer-btn {
  background-color: #fff;
  bottom: 0;
  height: 120rpx;
  padding: 0 32rpx;
  position: fixed;
  width: calc(100% - 64rpx);
}
.footer-btn .btn-box {
  margin-top: 24rpx;
  text-align: right;
}
.footer-btn button {
  border-radius: 40rpx;
  box-sizing: border-box;
  display: inline-block;
  font-size: 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-left: 32rpx;
  width: 200rpx;
}
.noDataComtent {
  margin-bottom: 100rpx;
}
.noDataBg {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: 300rpx 300rpx;
  height: 300rpx;
  margin-top: 330rpx;
  width: 100%;
}
.noDataContent {
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
  height: 34rpx;
  line-height: 34rpx;
  margin-top: 20rpx;
  text-align: center;
  width: 100%;
}
