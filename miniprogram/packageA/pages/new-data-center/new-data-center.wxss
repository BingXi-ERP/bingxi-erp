.contain {
  background: #fff;
}
.checkBg {
  background: #ddd;
  color: #000 !important;
}
.checkedBg {
  background: #ddd !important;
}
.storeInfo {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  padding: 10rpx 0 0;
}
.storeImg {
  border-radius: 50%;
  height: 90rpx;
  position: absolute;
  top: -36rpx;
  width: 90rpx;
}
.storeTotalInfo {
  border-bottom: 1rpx solid #ddd;
  color: #666;
  font-size: 24rpx;
  padding-bottom: 40rpx;
  padding-top: 10rpx;
  text-align: center;
}
.topContent {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  height: 500rpx;
  padding: 0 30rpx;
  position: relative;
  top: -30rpx;
  width: 694rpx;
}
.storeName {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
  margin-left: 120rpx;
  margin-top: 10rpx;
}
.displayFlex {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: 10rpx 0 0;
}
.tab {
  color: #333;
  font-size: 28rpx;
  line-height: 60rpx;
  margin-top: 50rpx;
  text-align: center;
}
.tab > view {
  color: #999;
  display: inline-block;
}
.tab > view:nth-of-type(2) {
  border: 1rpx solid #ddd;
  border-radius: 30rpx 0 0 30rpx;
  height: 60rpx;
  width: 240rpx;
}
.tab > view:nth-of-type(3) {
  border: 1rpx solid #ddd;
  border-radius: 0 30rpx 30rpx 0;
  height: 60rpx;
  width: 240rpx;
}
.colorCardReceive {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 30rpx;
  width: 100%;
}
.yearMonDate {
  color: #999;
  font-size: 24rpx;
  margin-top: 40rpx;
}
.yearMonDate,
.yearMonDateNum {
  justify-content: space-around;
}
.yearMonDateNum {
  color: #333;
  font-size: 32rpx;
  height: 44rpx;
  line-height: 44rpx;
}
.yearMonDate > view {
  text-align: center;
  width: 100%;
}
.yearMonDate > view:nth-of-type(1) {
  border-right: 1rpx solid #ddd;
}
.bottom-content {
  background: #fff;
  height: 406rpx;
}
.bottom-content > .List {
  border-bottom: 1rpx solid #ddd;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  height: 90rpx;
  justify-content: space-between;
  line-height: 90rpx;
  margin: 0 30rpx;
}
.todayIncome {
  color: #999;
  font-size: 28rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin: 38rpx 30rpx 0 58rpx;
}
.todayIncomeNum {
  color: #333;
  font-size: 48rpx;
  height: 66rpx;
  line-height: 66rpx;
  margin: 10rpx 30rpx 30rpx 58rpx;
}
.bottom-content > .List > view:nth-of-type(1) {
  color: #333;
  font-size: 32rpx;
  font-weight: 600;
  width: 74%;
}
.bottom-content > .List > view:nth-of-type(2) {
  font-size: 24rpx;
}
.listTitle {
  color: #333;
  font-size: 28rpx;
  padding: 20rpx 0;
}
.listTitle > view:nth-of-type(1) {
  width: 20%;
}
.listTitle > view:nth-of-type(2) {
  width: 54%;
}
.listData {
  color: #666;
  font-size: 24rpx;
  padding: 20rpx;
}
.listData:nth-child(even) {
  background-color: #f5f5f9;
}
.listData > view:nth-of-type(1) {
  line-height: 60rpx;
  width: 10%;
}
.listData > view:nth-of-type(2) {
  width: 80%;
}
.listData > view:nth-of-type(3) {
  line-height: 60rpx;
  width: 10%;
}
.customerlistTitle {
  color: #343434;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
}
.customerlistTitle > view:nth-of-type(1),
.customerlistTitle > view:nth-of-type(2) {
  width: 50%;
}
.customerlistData {
  color: #666;
  font-size: 24rpx;
  padding: 20rpx 0;
  text-align: center;
}
.customerlistData:nth-child(even) {
  background-color: #f5f5f9;
}
.customerlistData > view:nth-of-type(1) {
  width: 50%;
}
.customerlistData > view:nth-of-type(1) image {
  border-radius: 50%;
  margin: 0 auto;
}
.customerlistData > view:nth-of-type(2) {
  width: 50%;
}
.totalIncome {
  color: #333;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 50rpx;
  margin: 0 20rpx;
}
.totalIncomeNum {
  color: #333;
  font-size: 60rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
}
.spot {
  background: #ddd;
  border-radius: 20rpx;
  display: inline-block;
  height: 10rpx;
  position: relative;
  top: -5rpx;
  width: 10rpx;
}
.todayInfo {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin: 0 58rpx;
}
.todayInfo > view > view:nth-of-type(1) {
  color: #999;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}
.todayInfo > view > view:nth-of-type(2) {
  color: #333;
  font-size: 32rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
}
.space {
  margin-top: 20rpx;
}
.Visitorspace {
  margin-top: 38rpx;
}
.customer {
  height: 262rpx;
}
.form-btn {
  background: red;
}
.form-btn,
.form-contain {
  border-radius: 0;
  height: 100%;
  margin: 0;
  padding: 0;
  position: absolute;
  top: 0;
  width: 100%;
}
