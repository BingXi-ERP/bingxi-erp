<view class="container-gray printing-order">
    <view class="panel">
        <view class="cell">
            <view class="cell-title">打印机</view>
            <view class="cell-value">{{printerName}}</view>
        </view>
        <view class="cell">
            <view class="cell-title">打印份数</view>
            <view class="cell-value">
                <input bindinput="handleUpdateVal" data-key="printCopies" maxlength="3" placeholder="请输入打印数量" type="number" value="{{printCopies}}"></input>
            </view>
        </view>
    </view>
    <view class="footer-btn">
        <button bindtap="handlePintPreview" class="preview-btn">预览</button>
        <button bindtap="handlePrint" class="print-btn">打印</button>
    </view>
</view>
<van-popup :close-on-click-overlay="true" class="tip-dialog" show="{{showTitsPopular}}">
    <view class="popContent">您还没有添加银行卡</view>
    <view class="popBtn">
        <button catch:tap="closeTitsPopular" class="popBtn cancelBtn" size="small">取消</button>
        <button catch:tap="toAddCard" class="popBtn cancelBtn" size="small">去添加</button>
    </view>
</van-popup>
