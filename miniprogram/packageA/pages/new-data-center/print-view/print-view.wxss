.printing-order {
  color: #333;
  font-size: 28rpx;
  padding-top: 22rpx;
}
.printing-order .cell-value {
  color: #333;
}
.printing-order .cell-value input {
  text-align: right;
}
.printing-order .cell-value .icon-checkbox {
  height: 38rpx;
  width: 38rpx;
}
.footer-btn {
  background: #fff;
  bottom: 0;
  box-sizing: border-box;
  height: 196rpx;
  left: 0;
  padding: 13rpx 30rpx;
  position: fixed;
  right: 0;
  text-align: right;
  width: 100%;
}
.preview-btn,
.print-btn {
  display: inline-block;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 24rpx;
  width: 200rpx;
}
.preview-btn {
  background: linear-gradient(90deg, #eaf6ff, #e9f1ff);
  border-radius: 40rpx 0 0 40rpx;
  color: #4471e7;
}
.print-btn {
  background: linear-gradient(90deg, #7ab5ff, #336af8);
  border-radius: 0 40rpx 40rpx 0;
  color: #fff;
}
.fakeCheck {
  background: #d6d6db;
  border: 1rpx solid #f5f5f9;
  border-radius: 50%;
  height: 40rpx;
  width: 40rpx;
}
.tip-dialog {
  height: 100%;
  width: 80%;
}
.tip-dialog .van-popup {
  border-radius: 16rpx;
  color: #999bb4;
  font-size: 28rpx;
  padding: 46rpx 0 0;
  width: 640rpx;
}
.popTitle {
  color: #373c55;
  display: inline-block;
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
}
.popContent {
  color: #000;
  margin: 0 0 10rpx;
  padding: 48rpx;
  text-align: center;
}
.popBtn {
  align-items: center;
  border-top: 1rpx solid #edeff6;
  display: -webkit-flex;
  display: flex;
  justify-content: space-around;
}
.popBtn button {
  background-color: #fff;
  border: none;
  color: #336af8;
  font-size: 32rpx;
  font-weight: 400;
  height: 100rpx;
  line-height: 100rpx;
  width: 50%;
}
.popBtn .cancelBtn {
  border-right: 1rpx solid #edeff6;
  box-sizing: border-box;
  font-weight: 500;
}
