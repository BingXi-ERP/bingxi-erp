.contain {
  background: #fff;
  overflow-x: hidden;
}
.checkBg {
  background: #ddd;
  color: #000 !important;
}
.checkedBg {
  background: #ddd !important;
}
.storeInfo {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  padding: 10rpx 0 0;
}
.storeImg {
  border-radius: 50%;
  height: 90rpx;
  position: absolute;
  top: -36rpx;
  width: 90rpx;
}
.storeTotalInfo {
  border-bottom: 1rpx solid #ddd;
  color: #666;
  font-size: 24rpx;
  padding-bottom: 40rpx;
  padding-top: 10rpx;
  text-align: center;
}
.topContent {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  height: 260rpx;
  padding-left: 36rpx;
  position: relative;
  top: -24rpx;
}
.storeName {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
  margin-left: 120rpx;
  margin-top: 10rpx;
}
.displayFlex {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  padding: 34rpx 0 0;
}
.tab {
  color: #333;
  font-size: 28rpx;
  line-height: 60rpx;
  margin-top: 50rpx;
  text-align: center;
}
.tab > view {
  color: #999;
  display: inline-block;
}
.tab > view:nth-of-type(2) {
  border: 1rpx solid #ddd;
  border-radius: 30rpx 0 0 30rpx;
  height: 60rpx;
  width: 240rpx;
}
.tab > view:nth-of-type(3) {
  border: 1rpx solid #ddd;
  border-radius: 0 30rpx 30rpx 0;
  height: 60rpx;
  width: 240rpx;
}
.colorCardReceive {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 30rpx;
  width: 100%;
}
.yearMonDate {
  color: #999;
  font-size: 24rpx;
  margin-top: 40rpx;
}
.yearMonDate,
.yearMonDateNum {
  justify-content: space-around;
}
.yearMonDateNum {
  color: #333;
  font-size: 32rpx;
  height: 44rpx;
  line-height: 44rpx;
}
.yearMonDate > view {
  text-align: center;
  width: 100%;
}
.yearMonDate > view:nth-of-type(1) {
  border-right: 1rpx solid #ddd;
}
.bottom-content {
  background: #fff;
  height: 406rpx;
}
.bottom-content > .List {
  border-bottom: 1rpx solid #ddd;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  height: 90rpx;
  justify-content: space-between;
  line-height: 90rpx;
  margin: 0 30rpx;
}
.todayIncome {
  color: #999;
  font-size: 28rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin: 38rpx 30rpx 0 58rpx;
}
.todayIncomeNum {
  color: #333;
  font-size: 48rpx;
  height: 66rpx;
  line-height: 66rpx;
  margin: 10rpx 30rpx 30rpx 58rpx;
}
.bottom-content > .List > view:nth-of-type(1) {
  color: #333;
  font-size: 32rpx;
  font-weight: 600;
  width: 74%;
}
.bottom-content > .List > view:nth-of-type(2) {
  font-size: 24rpx;
}
.listTitle {
  color: #333;
  font-size: 28rpx;
  padding: 20rpx 0;
}
.listTitle > view:nth-of-type(1) {
  width: 20%;
}
.listTitle > view:nth-of-type(2) {
  width: 54%;
}
.listData {
  color: #666;
  font-size: 24rpx;
  padding: 20rpx;
}
.listData:nth-child(even) {
  background-color: #f5f5f9;
}
.listData > view:nth-of-type(1) {
  line-height: 60rpx;
  width: 10%;
}
.listData > view:nth-of-type(2) {
  width: 80%;
}
.listData > view:nth-of-type(3) {
  line-height: 60rpx;
  width: 10%;
}
.customerlistTitle {
  color: #343434;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
}
.customerlistTitle > view:nth-of-type(1),
.customerlistTitle > view:nth-of-type(2) {
  width: 50%;
}
.customerlistData {
  color: #666;
  font-size: 24rpx;
  padding: 20rpx 0;
  text-align: center;
}
.customerlistData:nth-child(even) {
  background-color: #f5f5f9;
}
.customerlistData > view:nth-of-type(1) {
  width: 50%;
}
.customerlistData > view:nth-of-type(1) image {
  border-radius: 50%;
  margin: 0 auto;
}
.customerlistData > view:nth-of-type(2) {
  width: 50%;
}
.totalIncome {
  color: #333;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 50rpx;
  margin: 0 20rpx;
}
.totalIncomeNum {
  color: #333;
  font-size: 60rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
}
.spot {
  background: #ddd;
  border-radius: 20rpx;
  display: inline-block;
  height: 10rpx;
  position: relative;
  top: -5rpx;
  width: 10rpx;
}
.todayInfo {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin: 0 58rpx;
}
.todayInfo > view > view:nth-of-type(1) {
  color: #999;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}
.todayInfo > view > view:nth-of-type(2) {
  color: #333;
  font-size: 32rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
}
.space {
  margin-top: 20rpx;
}
.Visitorspace {
  margin-top: 38rpx;
}
.customer {
  height: 262rpx;
}
.topTab {
  background: #2d74ee;
  display: -webkit-flex;
  display: flex;
  height: 124rpx;
}
.SalesVolume {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 60rpx;
  margin-right: 78rpx;
}
.tabActive {
  background: #fff;
  height: 6rpx;
  margin-left: 24rpx;
  margin-top: 24rpx;
  width: 40rpx;
}
.receivable,
.receivables,
.refund {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 78rpx;
}
.dateChoose {
  padding-top: 10rpx;
}
.explain {
  background: #f5f5f9;
  border-radius: 34rpx;
  color: #66666e;
  display: -webkit-flex;
  display: flex;
  font-size: 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  width: 666rpx;
}
.explainLogo {
  height: 26rpx;
  margin-left: 20rpx;
  margin-right: 12rpx;
  margin-top: 12rpx;
  width: 26rpx;
}
.lately-date-choose {
  margin: 36rpx 50rpx 0 0rpx;
}
.buttonSpace {
  margin-right: 40rpx;
}
.data-choose {
  border: 1rpx solid #ccc;
  border-radius: 36rpx;
  font-size: 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  width: 260rpx;
}
.marketing-card {
  align-items: center;
  background: #fff;
  background: url(https://oss.duibu.cn/duibu/shop/img/customer/cardbg.jpg)
    no-repeat;
  background-size: cover;
  border-radius: 8px;
  box-sizing: border-box;
  display: -webkit-flex;
  display: flex;
  height: 228rpx;
  justify-content: space-between;
  margin: 8px;
  padding: 40rpx;
  width: calc(100% -16px);
}
.card-label {
  color: #999;
  font-size: 12px;
  font-style: normal;
  line-height: 12px;
  margin-bottom: 10px;
  text-align: center;
  text-align: left;
  text-transform: none;
}
.right {
  text-align: right;
}
.card-content {
  color: #000;
  font-size: 24px;
  font-style: normal;
  line-height: 34px;
  text-align: left;
}
.customerTitle {
  background: #f5f6fa;
  height: 64rpx;
  margin-top: 30rpx;
  padding: 0 32rpx;
}
.customerTitle .left {
  color: #70728c;
  font-size: 12px;
  font-weight: 400;
}
.customerTitle .dult {
  color: #373c55;
  font-size: 24rpx;
  font-weight: 400;
  width: 130rpx;
}
.toSort,
.toSort image {
  position: relative;
}
.toSort image {
  height: 22rpx;
  top: 2rpx;
  width: 24rpx;
}
.allCustomer,
.customerContent {
  position: relative;
}
.customerContent {
  height: 144rpx;
}
.customerContent::after {
  border-bottom: 1rpx solid #ebebeb;
  bottom: 0;
  content: "";
  height: 1rpx;
  left: 0;
  position: absolute;
  width: 100vw;
}
.pro-row {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  height: 160rpx;
  justify-content: space-around;
}
.w30 {
  color: #666;
  width: 30%;
}
.w30:nth-child(3) {
  box-sizing: border-box;
  padding-right: 30rpx;
  text-align: right;
}
.product-list-box {
  box-sizing: border-box;
  height: calc(100vh - 580rpx);
  overflow: auto;
  padding: 0 8px 0rpx;
}
.moreIcon {
  bottom: -40rpx;
  color: #999bb4;
  font-size: 12px;
  font-weight: 400;
  height: 17px;
  left: 50%;
  position: absolute;
  text-align: center;
  transform: translateX(-50%);
  width: 80px;
}
.midle-wrap {
  margin-bottom: 60px;
  position: relative;
}
.dateB {
  background: #fff !important;
  border: 1rpx solid #ddd;
  border-radius: 36rpx;
  color: #666;
  display: inline-block;
  font-size: 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  width: 182rpx;
}
.choosedBotton {
  border: 1rpx solid #2f7bfd !important;
  color: #2f7bfd;
  font-weight: 600;
}
.center {
  padding-left: 80rpx;
}
.text {
  color: #000;
  font-size: 16px;
  line-height: 23px;
  margin-bottom: 5px;
  opacity: 0.8;
}
.text,
.unit {
  font-style: normal;
  text-align: center;
  text-align: left;
  text-transform: none;
}
.unit {
  font-size: 12px;
  line-height: 17px;
}
.align {
  align-items: center;
  color: #000;
  display: -webkit-flex;
  display: flex;
  opacity: 0.8;
}
.tr {
  text-align: right;
}
.border {
  border-bottom: 1px solid #e4e3e3;
  padding: 16px 0;
}
.border,
.time-box {
  box-sizing: border-box;
}
.time-box {
  font-size: 14px;
  height: 40px;
  line-height: 40px;
  opacity: 0.8;
  padding: 8px;
  text-align: right;
  width: 99%;
}
.tab-class {
  width: 120px !important;
}
.van-tabs__wrap {
  width: 50% !important;
}
