<view class="contain">
  <view class="time-box">{{time}}</view>
  <view class="db-card marketing-card">
    <view class="card-item">
      <view class="card-label">销售数量（{{billingItemCount}}条）</view>
      <view class="card-content">{{billingPricingQuantity}}</view>
    </view>
    <view class="card-item">
      <view class="card-label right">销售金额（¥）</view>
      <view class="card-content">{{orderAmount}}</view>
    </view>
  </view>
  <van-tabs
    active="{{active}}"
    bind:change="onChange"
    color="#4177F5"
    type="card"
  >
    <van-tab tabClass="setWidth" title="颜色">
      <view class="customerTitle fr-between-center">
        <view class="left">品名</view>
        <sort-component bindevent="sortFn" text="销售数量"></sort-component>
        <sort-component bindevent="sortFn" text="销售金额"></sort-component>
      </view>
      <view class="product-list-box">
        <view class="midle-wrap">
          <view
            bind:tap="handleClickProduct"
            class="pro-row border"
            data-billingIds="{{item.billingIds}}"
            data-goodsId="{{item.goodsId}}"
            data-quantityUnit="{{item.quantityUnit}}"
            wx:for="{{productList1}}"
            wx:key="{{item.goodsId}}"
          >
            <view class="w30">{{item.colorNo}} {{item.colorName}}</view>
            <view class="w30 center">
              <view class="text"
                >{{item.billingPricingQuantity}}{{quantityunit}}</view
              >
              <view class="unit">{{item.billingItemCount}} 条</view>
            </view>
            <view class="w30">
              <view class="text tr">{{item.colorAmount}}</view>
              <view class="unit tr"
                >{{item.colorPrice}}元/{{quantityunit}}</view
              >
            </view>
          </view>
        </view>
      </view>
    </van-tab>
    <van-tab title="客户名">
      <view class="customerTitle fr-between-center">
        <view class="left">客户名</view>
        <sort-component bindevent="sortFn" text="销售数量"></sort-component>
        <sort-component bindevent="sortFn" text="销售金额"></sort-component>
      </view>
      <view class="product-list-box">
        <view class="midle-wrap">
          <view
            bind:tap="handleClickProduct"
            class="pro-row border"
            data-billingIds="{{item.billingIds}}"
            data-goodsId="{{item.goodsId}}"
            data-quantityUnit="{{item.quantityUnit}}"
            wx:for="{{productList2}}"
            wx:key="{{item.goodsId}}"
          >
            <view class="w30">{{item.fullname}}</view>
            <view class="w30 center">
              <view class="text"
                >{{item.billingPricingQuantity}}{{quantityunit}}</view
              >
              <view class="unit">{{item.billingItemCount}}条</view>
            </view>
            <view class="w30">
              <view class="text tr">{{item.colorAmount}}</view>
              <view class="unit tr"
                >{{item.colorPrice}}元/{{quantityunit}}</view
              >
            </view>
          </view>
        </view>
      </view>
    </van-tab>
  </van-tabs>
</view>
