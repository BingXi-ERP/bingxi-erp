.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}
.head {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2430;
  padding: 16rpx 0 24rpx;
}
.hint {
  padding: 48rpx 0;
  text-align: center;
  color: #8a90a0;
  font-size: 28rpx;
}
.rows {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef0f4;
  font-size: 28rpx;
}
.row:last-child {
  border-bottom: none;
}
.key {
  color: #6b7280;
  flex: 0 0 40%;
  word-break: break-all;
}
.value {
  color: #1f2430;
  flex: 1;
  text-align: right;
  word-break: break-all;
}
