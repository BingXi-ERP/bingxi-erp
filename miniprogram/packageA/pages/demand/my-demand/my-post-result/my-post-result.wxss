@import "/packageA/pages/demand/my-demand/my-demand.wxss";
page {
  background: #f5f5f9;
  padding-top: 24rpx;
}
.toHome {
  bottom: 160rpx;
  position: fixed;
  right: 0;
  z-index: 99;
}
.tip-dialog {
  height: 100%;
  width: 80%;
}
.tip-dialog .van-popup {
  border-radius: 16rpx;
  color: #64689e;
  font-size: 28rpx;
  padding: 64rpx 0 0;
  width: 640rpx;
}
.popTitle {
  color: #373c55;
  display: inline-block;
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
}
.popContent {
  margin: 32rpx 0 64rpx;
  padding: 48rpx;
}
.popBtn {
  align-items: center;
  border-top: 1rpx solid #edeff6;
  display: -webkit-flex;
  display: flex;
  justify-content: space-around;
}
.popBtn button {
  background-color: #fff;
  border: none;
  color: #336af8;
  font-size: 32rpx;
  font-weight: 500;
  height: 100rpx;
  line-height: 100rpx;
  width: 50%;
}
.popBtn .cancelBtn {
  border-right: 1rpx solid #edeff6;
  box-sizing: border-box;
}
.footerBtn {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}
.footerBtn text {
  color: #999bb4;
  font-size: 24rpx;
  min-width: 80px;
}
.g_limtRow {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.demandItem {
  margin-bottom: 24rpx;
}
.rightIcon {
  height: 20rpx;
  margin-left: 60rpx;
  width: 20rpx;
}
.rightBtn {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: flex-end;
  min-width: 420rpx;
}
.postbtn {
  background: #fff;
  min-width: 120rpx;
}
.buyBtn,
.postbtn {
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 400;
  height: 56rpx;
  line-height: 56rpx;
  margin-right: 12rpx;
  margin-top: 10rpx;
  text-align: center;
}
.buyBtn {
  min-width: 128rpx;
}
.noMatching {
  margin-left: 0;
  margin-right: auto;
}
.noData {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  height: 100vh;
  justify-content: center;
  width: 100%;
}
.noData image {
  height: 320rpx;
  width: 320rpx;
}
.marB {
  margin-bottom: 5px;
}
