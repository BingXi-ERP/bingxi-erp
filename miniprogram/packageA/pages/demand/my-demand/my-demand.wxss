page {
  background-color: #f5f5f9;
}
.g_limtRow {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fl {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}
.demandItem {
  background: #fff;
  margin-bottom: 36rpx;
  padding: 0 36rpx;
  position: relative;
}
.itemHead {
  color: #999bb4;
  font-size: 12px;
  font-weight: 400;
  height: 80rpx;
  position: relative;
}
.itemHead::after {
  background: #edeff6;
  bottom: 0;
  content: "";
  height: 1rpx;
  left: 0;
  position: absolute;
  width: 100vw;
}
.waitIcon {
  font-family: PingFangSC-Regular;
  font-size: 12px;
  font-weight: 400;
  height: 17px;
  line-height: 17px;
}
.waitText {
  color: #ff762d;
}
.successText {
  color: #51c964;
}
.loseText {
  color: #fa3c3c;
}
.closeText {
  color: #373c55;
}
.itemContentText {
  flex: 1;
  height: 144rpx;
  padding-left: 20rpx;
}
.contentText {
  height: 144rpx;
  position: relative;
  text-align: right;
  width: 285rpx;
}
.statusText {
  color: #373c55;
  font-family: PingFangSC-Medium;
  font-size: 16px;
  font-weight: 500;
}
.statusTime {
  bottom: 0;
  position: absolute;
  right: 0;
}
.failText,
.statusText {
  height: 70%;
}
.failText,
.statusTime {
  color: #999bb4;
  font-family: PingFangSC-Regular;
  font-size: 12px;
  font-weight: 400;
}
.titleName {
  color: #373c55;
  height: 80%;
  width: 360rpx;
}
.buyNum,
.titleName {
  font-size: 14px;
  font-weight: 400;
}
.buyNum {
  color: #666d93;
  height: 55rpx;
}
.buyNum text {
  color: #fa3e55;
  font-size: 14px;
  font-weight: 700;
}
.loseReason {
  color: #999bb4;
  font-size: 12px;
  font-weight: 400;
}
.itemBtn {
  align-self: flex-end;
  background: #eaf4ff;
  border-radius: 16px;
  color: #2d74ee;
  font-size: 12px;
  font-weight: 500;
  height: 32px;
  line-height: 32px;
  margin-bottom: 24rpx;
  padding: 0 5px;
  position: relative;
  text-align: center;
  width: 72px;
  z-index: 10;
}
.itemContent {
  height: 190rpx;
}
.itemContent .itemImg {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  height: 144rpx;
  overflow: hidden;
  width: 144rpx;
}
.scheduleTime {
  background: #edeff6;
  border-radius: 4px;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  position: relative;
  z-index: 10;
}
.scheduleTime text,
.scheduleTime view {
  color: #373c55;
  font-size: 12px;
  font-weight: 400;
}
.scheduleTime .limit {
  display: inline-block;
  height: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 350rpx;
}
.itemFooterBtn {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row-reverse;
  height: 96rpx;
  margin-top: 12rpx;
}
.itemFooterBtn .btn {
  background: linear-gradient(90deg, #6caeff, #377bf0);
  border-radius: 16px;
  color: #fff;
  font-size: 12px;
  font-weight: 500;
  height: 32px;
  line-height: 32px;
  margin: 0 12rpx;
  position: relative;
  text-align: center;
  width: 96px;
  z-index: 10;
}
.blueBtn {
  border: 1rpx solid #2d74ee;
  color: #2d74ee;
}
.point {
  background: #ff4a4a;
  border-radius: 50%;
  color: #fff;
  content: "";
  font-family: DIN-Medium;
  font-size: 12px;
  font-weight: 500;
  height: 32rpx;
  line-height: 32rpx;
  position: absolute;
  right: -6rpx;
  text-align: center;
  top: -12rpx;
  width: 32rpx;
}
.nomalBtn {
  border: 1rpx solid #d2d3de;
  color: #373c55;
}
.myDemandHead {
  align-items: center;
  background: #2f76ed;
  color: #94bbff;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  font-size: 15px;
  font-weight: 500;
  height: 110rpx;
  justify-content: space-around;
  padding: 0 80rpx;
  position: relative;
}
.headChoose {
  color: #fff;
}
.myDemandHead view {
  text-align: center;
}
.sreachIcon {
  height: 48rpx;
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
}
.more {
  height: 120px;
  position: relative;
}
.more .toIfnoBtn {
  background: linear-gradient(90deg, #7ab5ff, #336af8);
  border-radius: 24px;
  bottom: 8px;
  box-shadow: 0 6px 12px -2px rgba(120, 169, 255, 0.5);
  color: #fff;
  font-size: 16px;
  font-weight: 500;
  height: 48px;
  line-height: 48px;
  width: 144px;
}
.more .toIfnoBtn,
.moreIcon {
  left: 50%;
  position: absolute;
  text-align: center;
  transform: translateX(-50%);
}
.moreIcon {
  color: #999bb4;
  font-size: 12px;
  font-weight: 400;
  height: 17px;
  top: 5px;
  width: 80px;
}
.van-tabs {
  padding-top: 60px !important;
}
.van-tabs__line {
  background-color: #4c7cf9 !important;
  bottom: 5px !important;
  height: 4px !important;
  transition-duration: 0s !important;
}
.myDemand {
  background-color: #fff;
  color: #4c7cf9 !important;
  font-size: 14px;
  height: 45px;
  line-height: 44px;
  position: absolute;
  right: 0;
  text-align: center;
  top: 0;
  width: 170rpx;
  z-index: 2;
}
::-webkit-scrollbar {
  color: transparent;
  height: 0;
  width: 0;
}
.i-scheduleTime {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  margin-right: 30rpx;
  position: relative;
}
.i-scheduleTime view {
  display: inline-block;
}
.right-arrow {
  height: 20rpx;
  position: absolute;
  right: -30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
}
.my-demand-pop {
  height: 100%;
  left: 0;
  overflow: hidden;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 0;
}
.popupContent .title {
  color: #373c55;
  font-size: 16px;
  font-weight: 500;
  height: 96rpx;
  padding-left: 30rpx;
}
.popupContent .itemArea {
  padding: 20rpx 36rpx;
}
.popupContent textarea {
  background: #f5f5f9;
  border: none;
  color: #70728c;
  font-size: 14px;
  font-weight: 400;
}
.fackArea,
.popupContent textarea {
  box-sizing: border-box;
  height: 120rpx;
  padding: 10px;
  width: 686rpx;
}
.fackArea {
  background: #e9e9e9;
}
.textarea-placeholder {
  color: #999bb4;
  font-size: 12px;
  font-weight: 400;
  line-height: 17px;
}
.popupBtn {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: row-reverse;
  font-size: 16px;
  font-weight: 400;
  height: 96rpx;
  line-height: 80rpx;
  margin: 36rpx 0 50rpx;
  text-align: center;
}
.popupCancle {
  background: #fff;
  border: 1rpx solid #d2d3de;
  border-radius: 24px;
  color: #373c55;
  height: 80rpx;
  width: 240rpx;
}
.popupComfirm {
  background: #eaf4ff;
  border-radius: 24px;
  color: #2d74ee;
  height: 80rpx;
  margin: 0 24rpx;
  width: 240rpx;
}
.van-cell__title,
.van-cell__value {
  flex: auto !important;
}
.van-cell {
  justify-content: space-between;
}
.myDemandHead,
.searchMyAnswer {
  box-sizing: border-box;
  left: 0;
  position: fixed;
  top: 0;
  width: 100vw;
  z-index: 20;
}
.myJoin,
.myPost {
  padding-top: 110rpx;
}
.vanTabs .van-tabs__wrap {
  height: 90rpx !important;
  left: 0;
  position: fixed;
  top: 110rpx;
}
.item-form {
  height: 100%;
  left: 0;
  opacity: 0;
  z-index: 9;
}
.form-btn,
.item-form {
  position: absolute;
  top: 0;
  width: 100%;
}
.form-btn {
  border: 0;
  border-radius: 0;
  height: 468rpx;
  margin: 0;
  padding: 0;
}
.searchMyAnswer {
  background: #2d74ee;
  box-sizing: border-box;
  height: 112rpx;
  padding: 20rpx 32rpx;
}
.searchInput {
  background: #f5f6fa;
  border-radius: 44rpx;
  color: #c7c8d8;
  font-family: PingFangSC-Regular;
  font-size: 14px;
  font-weight: 400;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
}
.searchInput image {
  height: 48rpx;
  width: 48rpx;
}
.noResult {
  left: 50%;
  position: absolute;
  text-align: center;
  top: 35%;
  transform: translate(-50%, -35%);
}
.noResult .noPage {
  background: url(https://img.duibu.cn/duibu/shop/img/customer/Defaultpage_NoRecord_Color.png)
    no-repeat;
  background-position: 50%;
  background-size: 320rpx 320rpx;
  height: 320rpx;
  margin-bottom: 32rpx;
  width: 320rpx;
}
.noResult .title {
  color: #70728c;
  font-family: PingFangSC-Medium;
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.noResult .text {
  font-family: PingFangSC-Regular;
}
.noResult .text,
.replier {
  color: #999bb4;
  font-size: 12px;
  font-weight: 400;
}
.replier {
  align-self: flex-end;
  display: inline-block;
  font-family: PingFangSC;
  margin-left: 20rpx;
  max-width: 180rpx;
}
