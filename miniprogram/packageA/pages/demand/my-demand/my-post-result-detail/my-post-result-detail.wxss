page {
  background: #f5f5f5;
}
.resultDeail {
  overflow-x: hidden;
  padding-bottom: 150rpx;
}
.prviewPic swiper,
.slide-image {
  height: 750rpx;
  width: 750rpx;
}
.postTitle {
  margin-bottom: 36rpx;
  position: relative;
}
.postTitle::after {
  border-bottom: 1rpx solid #f5f5f5;
  bottom: -18rpx;
  content: "";
  height: 1rpx;
  left: 0;
  padding-left: 36rpx;
  position: absolute;
  width: 100%;
}
.postTitle .number {
  color: #373c55;
  font-family: PingFangSC-Light;
  font-size: 14px;
  font-weight: 300;
}
.postTitle .categoryName {
  color: #373c55;
  font-family: PingFangSC-Medium;
  font-size: 18px;
  font-weight: 500;
}
.status {
  font-size: 24rpx;
  position: absolute;
  right: 36rpx;
  top: 0;
}
.green {
  color: #51c964;
}
.oriange {
  color: #ff762d;
}
.red {
  color: #fa3c3c;
}
.imgCount {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 12px;
  height: 24px;
  position: absolute;
  right: 20px;
  text-align: center;
  top: 670rpx;
  width: 48px;
  z-index: 20;
}
.imgCount view {
  color: #fff;
  font-size: 12px;
  font-weight: 300;
  line-height: 24px;
}
.detailData {
  background: #fff;
  border-radius: 8px 8px 0 0;
  margin-bottom: 20rpx;
  padding: 36rpx 0 36rpx 36rpx;
  position: relative;
  top: -10px;
}
.parameters {
  color: #373c55;
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
}
.parametersLayout {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
  line-height: 32px;
  position: relative;
  width: 100%;
}
.parametersLayout text {
  flex: 1;
}
.parameters .parametersDatial {
  word-wrap: break-word;
  color: #999bb4;
  flex: 2.5;
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
  padding-top: 12rpx;
  word-break: break-all;
}
.parametersLayout .phoneIcon {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  display: inline-block;
  height: 40rpx;
  line-height: 20px;
  margin-left: 20rpx;
  width: 40rpx;
}
.parametersLayout .copyIcon {
  background: #fff;
  border: 1px solid #4c7cf9;
  border-radius: 10px;
  color: #4c7cf9;
  font-size: 10px;
  font-weight: 400;
  height: 40rpx;
  line-height: 40rpx;
  position: absolute;
  right: 36rpx;
  text-align: center;
  top: 10rpx;
  width: 80rpx;
}
.parametersLayout .contact {
  color: #4c7cf9;
  vertical-align: middle;
}
.flRow {
  display: -webkit-flex;
  display: flex;
  flex-direction: row;
}
.remark-text {
  padding-right: 120rpx;
}
.footer {
  height: 140rpx;
  margin-top: 60rpx;
  padding: 0 30rpx 0 36rpx;
  position: relative;
}
.footer .btn {
  background: #fff;
  border-radius: 36rpx;
  font-size: 12px;
  font-weight: 400;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 16rpx;
  text-align: center;
  width: 128rpx;
}
.footer .detailBtn {
  align-items: center;
  background-color: #fff;
  border-top: 1rpx solid #edeff6;
  bottom: 0;
  display: -webkit-flex;
  display: flex;
  flex-direction: row-reverse;
  height: 96rpx;
  margin-top: 12rpx;
  padding-bottom: 30rpx;
  padding-top: 10rpx;
  position: fixed;
  right: 0;
  width: 100%;
}
.board {
  bottom: 135rpx;
}
.board,
.bottomBoard {
  background: #fff5e0;
  color: #ff8437;
  font-family: PingFangSC-Regular;
  font-size: 12px;
  font-weight: 400;
  height: 64rpx;
  line-height: 64rpx;
  position: fixed;
  right: 0;
  text-indent: 36rpx;
  width: 100vw;
}
.bottomBoard {
  bottom: 0;
  margin-bottom: env(safe-area-inset-bottom);
}
.footer .blueBtn {
  border: 1rpx solid #2d74ee;
  color: #2d74ee;
}
.footer .nomalBtn {
  border: 1rpx solid #d2d3de;
  color: #373c55;
}
.footer .samllBtn {
  background: linear-gradient(90deg, #7ab5ff, #336af8);
  color: #fff;
}
.footer .noMatching {
  margin-left: 20rpx;
  margin-right: auto;
}
.tip-dialog {
  height: 100%;
  width: 80%;
}
.tip-dialog .van-popup {
  border-radius: 16rpx;
  color: #64689e;
  font-size: 28rpx;
  padding: 64rpx 0 0;
  width: 640rpx;
}
.popTitle {
  color: #373c55;
  display: inline-block;
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
}
.popContent {
  margin: 32rpx 0 64rpx;
  padding: 48rpx;
}
.popBtn {
  align-items: center;
  border-top: 1rpx solid #edeff6;
  display: -webkit-flex;
  display: flex;
  justify-content: space-around;
}
.popBtn button {
  background-color: #fff;
  border: none;
  color: #336af8;
  font-size: 32rpx;
  font-weight: 500;
  height: 100rpx;
  line-height: 100rpx;
  width: 50%;
}
.popBtn .cancelBtn {
  border-right: 1rpx solid #edeff6;
  box-sizing: border-box;
}
