page {
  height: 100%;
}
.intro {
  min-height: 100%;
  overflow-y: scroll;
  padding-bottom: 200rpx;
  position: relative;
  width: 100%;
}
.content {
  left: 50%;
  max-width: 1500rpx;
  position: absolute;
  top: 120rpx;
  transform: translateX(-50%);
  width: 100%;
}
.word {
  height: 390rpx;
  margin: 0 auto 60rpx;
  width: 544rpx;
}
.video {
  height: 350rpx;
  margin: 0 64rpx;
}
.apply {
  height: 64rpx;
  margin: 80rpx auto 32rpx;
  width: 264rpx;
}
.promotion {
  color: hsla(0, 0%, 100%, 0.9);
  font-size: 12px;
  padding: 0 90rpx;
  text-align: center;
}
.promotion .text {
  font-family: HarmonyOS_Sans_SC;
  line-height: 44rpx;
  text-align: center;
}
.promotion .plat {
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  margin: 48rpx 0 16rpx;
}
.intro_bg {
  height: 100%;
  width: 100%;
}
@media (min-width: 375px) and (max-width: 414px) {
  .promotion {
    padding: 0 128rpx;
  }
}
@media (min-width: 414px) and (max-width: 480px) {
  .promotion {
    padding: 0 140rpx;
  }
}
