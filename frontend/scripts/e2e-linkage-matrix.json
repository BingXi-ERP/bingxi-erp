{
  "version": 1,
  "note": "链路影响登记，供 PR 联动门禁与 report-e2e-linkage.mjs 共用。命中模块后由 ci-cd.yml 的 ci-e2e-linkage job 真实执行 chains.specs；无命中仅记 NOT_APPLICABLE，不冒充回归通过。modules[].match 为规范化后的仓库相对路径前缀或模块关键词（按子串匹配，分隔符统一为 /）。chains 的 specs 均为真实存在的 e2e 文件。",
  "chains": {
    "sale-to-cash": {
      "description": "报价→订单→锁缸→出库→送货→对账→开票→收款（销售到回款全链）",
      "specs": [
        "frontend/e2e/fullflow/21-sale-to-cash.spec.ts",
        "frontend/e2e/fullflow/40-quotation-role-journey.spec.ts",
        "frontend/e2e/flow/513-delivery-signoff-and-reconciliation-gate.spec.ts",
        "frontend/e2e/flow/91-ship-auto-ar-amounts.spec.ts",
        "frontend/e2e/flow/468-ar-invoice-precheck-statement-confirmed.spec.ts"
      ]
    },
    "purchase-to-pay": {
      "description": "采购→入库→质检→库存→应付→付款（采购到付款全链）",
      "specs": [
        "frontend/e2e/fullflow/20-purchase-to-pay.spec.ts",
        "frontend/e2e/flow/95-purchase-receipt-pay-chain.spec.ts",
        "frontend/e2e/flow/461-purchase-receipt-to-ap-conservation.spec.ts",
        "frontend/e2e/flow/97-quality-standard-and-8d-chain.spec.ts"
      ]
    },
    "outsource-to-cost": {
      "description": "委外→回布→入库→成本→对账（外协加工到成本核算）",
      "specs": [
        "frontend/e2e/fullflow/23-outsource-issue-receipt.spec.ts",
        "frontend/e2e/flow/21d-fabric-outsourcing-costing-voucher-batch.spec.ts",
        "frontend/e2e/flow/457-outsource-rework-and-rejection-deduction.spec.ts"
      ]
    },
    "returns-to-report": {
      "description": "退货→库存→应收→成本→报表（退货回溯与财务口径）",
      "specs": [
        "frontend/e2e/flow/11-returns.spec.ts",
        "frontend/e2e/flow/522-ar-recon-source-amount-redflush.spec.ts",
        "frontend/e2e/fullflow/11-ar.spec.ts",
        "frontend/e2e/fullflow/22-inspection-to-return.spec.ts"
      ]
    }
  },
  "modules": [
