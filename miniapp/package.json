{
  "name": "bingxi-miniapp",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "predev:mp-weixin": "npm run prepare:manifest",
    "build:mp-weixin": "uni build -p mp-weixin",
    "prebuild:mp-weixin": "npm run prepare:manifest",
    "prepare:manifest": "node scripts/prepare-manifest.mjs",
    "typecheck": "vue-tsc -b --force",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "test:run": "vitest run",
    "check:self-test": "bash ../scripts/ci/miniapp-checks.sh --self-test",
    "check:static": "bash ../scripts/ci/miniapp-checks.sh",
    "contract:self-test": "node ../scripts/ci/miniapp-contract-check.mjs --self-test",
    "contract:check": "node ../scripts/ci/miniapp-contract-check.mjs --root src --snapshot ../frontend/scripts/route-snapshot.txt",
    "test:e2e": "node tests/e2e/run.mjs",
    "postinstall": "node scripts/patch-uni-vite-peers.mjs"
  },
  "dependencies": {
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "wot-design-uni": "^1.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "@uni-helper/vite-plugin-uni-manifest": "^0.7.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "miniprogram-automator": "^0.13.0",
    "prettier": "^3.10.1",
    "sass": "~1.77.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "6.4.6",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "@intlify/core-base": "9.14.4",
    "@intlify/message-compiler": "9.14.4",
    "@intlify/message-resolver": "9.1.11",
    "@intlify/runtime": "9.1.10",
    "@intlify/shared": "9.14.4",
    "@intlify/vue-devtools": "9.14.4",
    "@vue/server-renderer": "3.5.46",
    "@vitejs/plugin-legacy": "6.1.1",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "body-parser": "1.20.9",
    "express": "4.22.3",
    "jimp": "0.22.12",
    "path-to-regexp": "0.1.13",
    "postcss": "8.5.34",
    "source-map-js": "1.2.4",
    "tinypool": "2.2.0",
    "ws": "8.23.0"
  }
}
